# ---------------------------------------------------------------------------
# Compose-level environment template. Copy to deploy/.env when running locally.
# Values here are forwarded into the backend / frontend containers; do NOT
# commit a populated .env (gitignored).
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_DB=platform
POSTGRES_USER=platform
# 必填（task-14 / D-006）：compose 用 :?must set 强制，未设置 docker compose config 直接报错。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-48-char-string
# Credential encryption master key (KEK) — libsodium secretbox / xchacha20-poly1305.
# 加密用户凭证：git_identity（PAT/Token）+ llm_provider（LLM api_key）共用同一把（D-009）。
# 格式 `<key_id>:<hex 32 字节>`，例如 `v1:<64 位 hex>`；也接受裸 64 位 hex（按 v1 解）。
# 生成：python -c "import secrets; print(f'v1:{secrets.token_hex(32)}')"
# ⚠️ use-time 校验（非 boot）：未配不会启动失败，而是首次 crypto 操作（建/读凭证）才 503
#    MASTER_KEY_MISSING（backend/app/core/crypto.py:37-44）。生产务必在部署前配好。
# ⚠️ 丢失 = 历史加密凭证（已有 git_identity / llm_provider 行）不可解，只能重置数据。
#    换密钥需走 key_id 轮换（旧 key_id 保留可解旧密文，新写入用新 key_id）。
# 占位为空——部署前必须填真值；切勿提交真实 .env（gitignored）。
SILLYSPEC_MASTER_KEY=
# LiteLLM gateway (Wave2, openai 格式供应商经 LiteLLM 转 Anthropic↔OpenAI / FR-05)。
# master key：admin API 鉴权（register/unregister，task-09）+ openai 供应商经 LiteLLM 的
# auth_token（LiteLLM /v1/messages 接受 master key 鉴权）。生成：
#   python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
# ⚠️ 不入库不进镜像不进 git（R-05 新信任边界）；丢失 = 需重注册所有 openai 供应商
#    （register 幂等可重跑 set-default）。dev 模式 backend 在 host 经 127.0.0.1:4000 访问。
LITELLM_MASTER_KEY=
# LiteLLM store DB 密码（独立 postgres，admin API 动态注册的 model 注册表，避项目 alembic 冲突）。
LITELLM_DB_PASSWORD=litellm
# dev 模式 host backend 访问 LiteLLM 的本地回环端口（prod 不暴露，仅同网络可达）。
LITELLM_PORT=4000
# daemon 可达的 hub 对外地址（task-04 security-audit-remediation）：master key 收窄后
# daemon 子进程经 hub 代理打 LiteLLM，provider_config.litellm_base_url = 本值 +
# /api/daemon/llm-proxy。默认 localhost:8000 仅 daemon 与 backend 同机时成立；
# daemon 在宿主机/异机时须改为实际可达地址（如 http://<服务器IP或域名>:8000）。
HUB_PROXY_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
ENVIRONMENT=dev
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
OTEL_ENDPOINT=
# COMMIT_SHA 已改由镜像构建烘焙（2026-09-26-deploy-eng-hardening）——此处留空会经
# env_file 旁路覆盖镜像 ENV 回退 unknown；需要服务器现场构建时再取消注释填值。
# COMMIT_SHA=

# Object storage (platform file center). Compose 部署默认走容器服务名 minio:9000；
# 本机 native run（不经 Docker）才用 http://localhost:9000。凭证须与 minio 服务的
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD 保持一致。
# S3_ACCESS_KEY / S3_SECRET_KEY / MINIO_ROOT_PASSWORD 必填（task-14 / D-006）：
# compose 用 :?must set 强制，未设置 docker compose config 直接报错；不得再用 minioadmin。
# MINIO_ROOT_USER 保留默认 minioadmin（非密钥），如需自定义在此设置。
STORAGE_BACKEND=minio
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=platform-files
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# spec-workspaces bind mount: host-side real path. The daemon (Windows host) and
# the backend container MUST access the same physical directory, otherwise the
# agent cannot see spec documents written by the backend. Default
# C:/data/spec-workspaces (forward slashes); if permission is denied, move it
# under your user directory. Consumed by deploy/docker-compose.yml; the backend
# still sees /data/spec-workspaces in-container (SPEC_DATA_ROOT unchanged).
SPEC_DATA_HOST_DIR=C:/data/spec-workspaces

# Agent CLI versions baked into the backend image.
# 2026-10-08-backend-image-slim-no-claude：CLAUDE_CODE_VERSION 退役（镜像不装 claude-code）。
# SILLYSPEC_VERSION 留空=取最新（打包脚本时间戳爆破缓存自动跟 latest），填值=pin（应急回滚）。
SILLYSPEC_VERSION=

# 2026-10-08-backend-image-slim-no-claude：以下 ANTHROPIC_*/CLAUDE_* 对容器为惰性变量
# （容器内无 claude；agent 凭据/模型配置走宿主 daemon 侧），仅作历史参考保留。
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-5.2
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.2
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.2
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_MODEL=opus

# Auth bootstrap (task-04a)
# If set, backend will create/reuse this admin on startup.
# ⚠️ 部署前务必改为强口令（≥12 位、含大小写/数字/符号）；后端 config 加载期会拒 admin123
#    等常见弱口令，弱口令启动直接 ValidationError。
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
PLATFORM_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 2026-09-26-deploy-eng-hardening：NEXT_PUBLIC_COMMIT_SHA 已改由镜像构建烘焙——此处
# 留空会经 env_file 旁路覆盖镜像 ENV；需要服务器现场构建时再取消注释填值。
# NEXT_PUBLIC_COMMIT_SHA=
