# E2E 测试环境变量模板（复制为 frontend/e2e/.env.e2e 后填写）
# 注意：.env.e2e 含明文密码，已在 .gitignore 中忽略，禁止提交仓库。
# 加载方式（D-010@v1）：本项目不依赖 dotenv，Playwright 运行前需在 shell 中手动注入：
#   Git Bash:  cd frontend && set -a; source e2e/.env.e2e; set +a && pnpm test:e2e

# 前端（被测应用）地址。可选，默认 http://localhost:3000（本机 pnpm dev）
#E2E_BASE_URL=http://localhost:3000

# 后端 API 地址。可选，默认 http://localhost:8000（本机 uvicorn）
#E2E_API_URL=http://localhost:8000

# 引导管理员邮箱。【必填】与 backend/.env 中的 PLATFORM_BOOTSTRAP_ADMIN_EMAIL 保持一致
E2E_BOOTSTRAP_EMAIL=

# 引导管理员密码。【必填】与 backend/.env 中的 PLATFORM_BOOTSTRAP_ADMIN_PASSWORD 保持一致
E2E_BOOTSTRAP_PASSWORD=
