+// tests/interactive/zcode-events.test.ts
+// 2026-10-15-zcode-engine-appserver task-03：通知 → AgentEvent 归一化器单测。
+// fixtures = 2026-10-15 实测抓包序列（subscribe deliveryKind='desktop-continuous'
