+    await openPopover();
+
+    fireEvent.click(screen.getByTestId("session-change-archive-toggle"));
+    expect(screen.getByTestId("session-change-item-2026-10-12-old-change")).toBeTruthy();
+
+    fireEvent.click(screen.getByTestId("session-change-archive-toggle"));
