+      makeSession({ id: "s-a", title: "会话甲", workspace_id: "ws-a" }),
+      makeSession({ id: "s-b", title: "会话乙", workspace_id: "ws-b" }),
+    ],
+    total: 2,
+    limit: 50,
+    offset: 0,
