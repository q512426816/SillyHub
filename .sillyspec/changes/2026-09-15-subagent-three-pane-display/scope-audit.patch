+      id: "call_agent",
+      toolName: "Agent",
+      primary: "调研员",
+      subagentType: "research",
+      startedAt: 60_000,
+      endedAt: 144_000,
+      children: [makeTextSeg({ id: "text:c9", text: "无 Provider 的正文产出" })],
