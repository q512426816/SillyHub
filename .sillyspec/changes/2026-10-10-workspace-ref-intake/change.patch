+/** 文本内容按行拆分（尾换行不产空末行，行号与编辑器 1 起始语义一致）。 */
+function splitContentLines(content: string): string[] {
+  const lines = content.split("\n");
+  if (lines.length > 1 && lines[lines.length - 1] === "") lines.pop();
+  return lines;
