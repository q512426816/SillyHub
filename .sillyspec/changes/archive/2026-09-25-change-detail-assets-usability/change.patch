+def _strip_ab_prefix(path: str) -> str:
+    """剥 ``a/``/``b/`` 前缀（git 块头两侧路径各带一侧前缀）。"""
+    for prefix in ("a/", "b/"):
+        if path.startswith(prefix):
+            return path[len(prefix) :]
+    return path
