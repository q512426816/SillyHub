+function setFont(ctx,size,weight,mono){ ctx.font=`${weight||400} ${size}px ${mono?FONT_MONO:FONT_SANS}`; }
+/* 带字距的文本（逐字绘制，跨浏览器可靠） */
+function spacedText(ctx,text,cx,y,size,weight,color,spacing,mono,align){
+  setFont(ctx,size,weight,mono);
+  const chars=[...text]; let w=0; const ws=chars.map(ch=>{const cw=ctx.measureText(ch).width;w+=cw;return cw;});
+  w+=spacing*(chars.length-1);
+  let x = align==='left'? cx : align==='right'? cx-w : cx-w/2;
+  ctx.fillStyle=color; ctx.textBaseline='alphabetic'; ctx.textAlign='left';
+  chars.forEach((ch,i)=>{ ctx.fillText(ch,x,y); x+=ws[i]+spacing; });
+  return w;
+}
+function roundRect(ctx,x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }
+
+/* ---------- 画布与坐标变换 ---------- */
+const canvas=document.getElementById('film');
+const ctx=canvas.getContext('2d');
