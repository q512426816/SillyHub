+    this.pump();
+  },
+  stop(){ clearInterval(this.timer); this.timer=null; this.killPads(); },
+  killPads(){
+    const now=this.ctx?this.ctx.currentTime:0;
+    this.livePads.forEach(n=>{ try{ n.g.gain.cancelScheduledValues(now); n.g.gain.setTargetAtTime(0,now,.05); n.o1.stop(now+.3); n.o2.stop(now+.3);}catch(e){} });
+    this.livePads=[];
+  },
+  setMuted(m){ this.muted=m; if(this.master) this.master.gain.setTargetAtTime(m?0:.9,this.ctx.currentTime,.05); },
+  pump(){
+    if(!this.timer) return;
+    const horizon=this.anchorT+(this.ctx.currentTime-this.anchorCtx)+.38;
+    const step=BAR/8;
+    while(this.anchorT+this.nextGrid*step<horizon){
+      const g=this.nextGrid, gT=g*step;
+      if(gT>DUR){ clearInterval(this.timer); this.timer=null; return; }
+      this.scheduleGrid(g,gT);
+      this.nextGrid++;
+    }
+    /* 章节转场音效 */
+    for(const b of CHAPTERS.slice(1)){
+      if(b._sfx===undefined) b._sfx=-1;
+      const cT=this.t2c(b.t0);
+      if(cT>this.ctx.currentTime&&cT<this.ctx.currentTime+.4&&b._sfx!==Math.round(cT*10)){
+        b._sfx=Math.round(cT*10); this.impact(b.t0===11?0:1);
+      }
+      /* riser：边界前 1.3s */
+      const rT=this.t2c(b.t0-1.3);
+      if(rT>this.ctx.currentTime&&rT<this.ctx.currentTime+.4&&b._riser!==Math.round(rT*10)){
+        b._riser=Math.round(rT*10); this.riser(b.t0===13.2?1.6:1.3);
+      }
+    }
+  },
+  scheduleGrid(g,gT){
+    const inBar=g%8, bar=Math.floor(g/8), ch=BAR_CHORDS[bar]||'F', chord=CHORD_LIB[ch]||CHORD_LIB.F;
+    const inten=intensityAt(gT), at=this.t2c(gT);
+    if(inBar===0){
+      this.pad(chord,at,BAR*(bar>=BAR_CHORDS.length-1?2.2:1));
+      this.bass(chord.r,at,.9,inten);
+      if(inten>=.55) this.kick(at,inten);
+    }
+    if(inBar===4&&inten>=.55){ this.kick(at,inten*.8); this.bass(chord.r+(inten>=.7?7:0),at,.5,inten*.8); }
+    /* 琶音（8 分；高能量时 16 分补位） */
+    if(inten>=.45&&inBar%2===0){
+      const seq=[0,1,2,3,2,1,2,3], ni=seq[inBar/2|0]%(chord.notes.length);
+      this.pluck(chord.notes[ni]+12,at,inten*.9);
+    }
+    if(inten>=.75&&inBar%2===1){ this.pluck(chord.notes[(inBar+2)%4]+24,at,inten*.45); }
+    /* 镲 */
+    if(inten>=.5&&inBar%2===1) this.hat(at,inten*.7);
+    if(inten>=.8&&inBar%2===0&&inBar!==0) this.hat(at,inten*.4);
+  },
+  pad(chord,at,dur){
+    const c=this.ctx;
+    const g=c.createGain(); g.gain.setValueAtTime(0,at);
+    g.gain.linearRampToValueAtTime(.052,at+.55);
+    g.gain.setValueAtTime(.052,at+dur-.6);
+    g.gain.linearRampToValueAtTime(0,at+dur);
+    const f=c.createBiquadFilter(); f.type='lowpass'; f.frequency.value=760; f.Q.value=.4;
+    /* 根音双振荡失谐铺底 */
+    const o1=c.createOscillator(),o2=c.createOscillator();
+    o1.type='sawtooth'; o2.type='sawtooth';
+    o1.frequency.value=midi2f(chord.notes[0]); o2.frequency.value=midi2f(chord.notes[0])*1.004;
+    o1.detune.value=-6; o2.detune.value=+6;
+    /* 上方和弦音用独立正弦轻铺 */
+    const up=chord.notes.slice(1).map(m=>{
+      const os=c.createOscillator(); os.type='triangle'; os.frequency.value=midi2f(m);
+      const og=c.createGain(); og.gain.setValueAtTime(0,at); og.gain.linearRampToValueAtTime(.03,at+.6); og.gain.setValueAtTime(.03,at+dur-.6); og.gain.linearRampToValueAtTime(0,at+dur);
+      os.connect(og); og.connect(f); os.start(at); os.stop(at+dur+.1); return os;
+    });
+    o1.connect(f); o2.connect(f); f.connect(g); g.connect(this.master); g.connect(this.wet);
+    o1.start(at); o2.start(at); o1.stop(at+dur+.1); o2.stop(at+dur+.1);
+    this.livePads.push({o1,o2,g});
+  },
+  bass(m,at,len,inten){
+    const c=this.ctx, g=c.createGain();
+    g.gain.setValueAtTime(0,at); g.gain.linearRampToValueAtTime(.15*lerp(.6,1,inten),at+.03);
+    g.gain.exponentialRampToValueAtTime(.001,at+len);
+    const o=c.createOscillator(); o.type='sine'; o.frequency.value=midi2f(m);
+    const o2=c.createOscillator(); o2.type='triangle'; o2.frequency.value=midi2f(m)*2;
+    const og=c.createGain(); og.gain.value=.35; o2.connect(og); og.connect(g);
+    o.connect(g); g.connect(this.master);
+    o.start(at); o2.start(at); o.stop(at+len+.05); o2.stop(at+len+.05);
+  },
+  pluck(m,at,vel){
+    const c=this.ctx, g=c.createGain();
+    g.gain.setValueAtTime(.06*vel,at); g.gain.exponentialRampToValueAtTime(.0006,at+.3);
+    const o=c.createOscillator(); o.type='triangle'; o.frequency.value=midi2f(m);
+    o.connect(g); g.connect(this.master); g.connect(this.wet);
+    o.start(at); o.stop(at+.32);
+  },
+  noiseBuf(){
+    if(this._nb) return this._nb;
+    const c=this.ctx, b=c.createBuffer(1,c.sampleRate*1.2,c.sampleRate), d=b.getChannelData(0);
+    for(let i=0;i<d.length;i++) d[i]=Math.random()*2-1;
+    return this._nb=b;
+  },
+  kick(at,inten){
+    const c=this.ctx, o=c.createOscillator(), g=c.createGain();
+    o.type='sine'; o.frequency.setValueAtTime(150,at); o.frequency.exponentialRampToValueAtTime(44,at+.11);
+    g.gain.setValueAtTime(.22*inten,at); g.gain.exponentialRampToValueAtTime(.001,at+.24);
+    o.connect(g); g.connect(this.master); o.start(at); o.stop(at+.26);
+  },
+  hat(at,vel){
+    const c=this.ctx, s=c.createBufferSource(); s.buffer=this.noiseBuf();
+    const f=c.createBiquadFilter(); f.type='highpass'; f.frequency.value=6800;
+    const g=c.createGain(); g.gain.setValueAtTime(.05*vel,at); g.gain.exponentialRampToValueAtTime(.0005,at+.05);
+    s.connect(f); f.connect(g); g.connect(this.master); s.start(at); s.stop(at+.07);
+  },
+  riser(dur){
+    const c=this.ctx, at=c.currentTime+.02, s=c.createBufferSource(); s.buffer=this.noiseBuf(); s.loop=true;
+    const f=c.createBiquadFilter(); f.type='bandpass'; f.Q.value=1.2;
+    f.frequency.setValueAtTime(320,at); f.frequency.exponentialRampToValueAtTime(3200,at+dur);
+    const g=c.createGain(); g.gain.setValueAtTime(.0001,at); g.gain.exponentialRampToValueAtTime(.07,at+dur*.92); g.gain.exponentialRampToValueAtTime(.0001,at+dur+.06);
+    s.connect(f); f.connect(g); g.connect(this.master); g.connect(this.wet);
+    s.start(at); s.stop(at+dur+.1);
+  },
+  impact(kind){
+    const c=this.ctx, at=c.currentTime+.02;
+    const o=c.createOscillator(), g=c.createGain();
+    o.type='sine'; o.frequency.setValueAtTime(kind?72:88,at); o.frequency.exponentialRampToValueAtTime(30,at+1.1);
+    g.gain.setValueAtTime(kind?.5:.4,at); g.gain.exponentialRampToValueAtTime(.001,at+1.3);
+    o.connect(g); g.connect(this.master); o.start(at); o.stop(at+1.35);
+    const s=c.createBufferSource(); s.buffer=this.noiseBuf();
+    const f=c.createBiquadFilter(); f.type='lowpass'; f.frequency.setValueAtTime(900,at); f.frequency.exponentialRampToValueAtTime(120,at+.7);
+    const ng=c.createGain(); ng.gain.setValueAtTime(kind?.3:.22,at); ng.gain.exponentialRampToValueAtTime(.001,at+.8);
+    s.connect(f); f.connect(ng); ng.connect(this.master); s.start(at); s.stop(at+.85);
+  },
+};
+
+/* ============================================================================
+ * 渲染主循环与播放器
+ * ==========================================================================*/
+let playing=false, T=0, lastFrame=0, idleTimer=null;
+function renderFrame(){
+  ctx.setTransform(1,0,0,1,0,0);
+  ctx.fillStyle='#000'; ctx.fillRect(0,0,canvas.width,canvas.height);
+  ctx.setTransform(dpr*fit,0,0,dpr*fit,dpr*ox,dpr*oy);
+  ctx.beginPath(); ctx.rect(0,0,1920,1080); ctx.clip();
+  drawBackground(T);
+  for(const sc of SCENES){
+    if(T<sc.t0-.1||T>sc.t1+.1) continue;
+    let a=1;
+    if(sc.fadeIn>0) a*=smooth(sc.t0,sc.t0+sc.fadeIn+.6,T);
+    if(sc.fadeOut>0) a*=1-smooth(sc.t1-sc.fadeOut-.6,sc.t1,T);
+    if(a<=0) continue;
+    sc.fn(T-sc.t0,T,a);
+  }
+  drawCaptions(T);
+  drawHud(T);
+  drawFilmLayers(T);
+}
+function tick(ts){
+  if(!playing){ return; }
+  if(!lastFrame) lastFrame=ts;
+  const dt=Math.min(.1,(ts-lastFrame)/1000); lastFrame=ts;
+  T+=dt;
+  if(T>=DUR){ T=DUR; renderFrame(); finish(); return; }
+  renderFrame();
+  updateChrome();
+  requestAnimationFrame(tick);
+}
+function fmt(s){ s=Math.max(0,Math.floor(s)); return `${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`; }
+
+/* ---------- DOM 引用 ---------- */
+const stageWrap=document.getElementById('stageWrap');
+const poster=document.getElementById('poster');
+const playerEl=document.getElementById('player');
+const barEl=document.getElementById('bar');
+const fillEl=document.querySelector('#bar .fill');
+const headEl=document.querySelector('#bar .head');
+const segsEl=document.getElementById('segs');
+const tipEl=document.getElementById('tip');
+const timeEl=document.getElementById('timeLabel');
+const btnPlay=document.getElementById('btnPlay');
+const btnMute=document.getElementById('btnMute');
+const endcard=document.getElementById('endcard');
+const ICON_PLAY='<svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z"/></svg>';
+const ICON_PAUSE='<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>';
+const ICON_VOL='<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 9v6h4l5 4V5L8 9zM16.5 12a4.5 4.5 0 0 0-2-3.74v7.48A4.5 4.5 0 0 0 16.5 12zm-2-8.5v2.06A6.5 6.5 0 0 1 14.5 20.5v2.06A8.5 8.5 0 0 0 18.5 12a8.5 8.5 0 0 0-6-8.5z"/></svg>';
+const ICON_MUTED='<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 9v6h4l5 4V5L8 9zM20 8.6 18.6 7.2 16.8 9l-1.8-1.8-1.4 1.4 1.8 1.8-1.8 1.8 1.4 1.4 1.8-1.8 1.8 1.8 1.4-1.4-1.8-1.8z"/></svg>';
+btnPlay.innerHTML=ICON_PLAY; btnMute.innerHTML=ICON_VOL;
+
+/* 章节刻度 */
+(function(){
+  CHAPTERS.forEach(c=>{ const i=document.createElement('i');
+    i.style.width=(c.t1-c.t0)/DUR*100+'%'; segsEl.appendChild(i); });
+})();
+/* 片尾章节按钮 */
+(function(){
+  const box=document.getElementById('endBtns');
+  const rp=document.createElement('button'); rp.className='primary'; rp.textContent='↻ 重播全片';
+  rp.onclick=()=>{ endcard.classList.remove('show'); seek(0); play(); };
+  box.appendChild(rp);
+  CHAPTERS.forEach((c,i)=>{ const b=document.createElement('button');
+    b.textContent=`${String(i+1).padStart(2,'0')} ${c.name}`;
+    b.onclick=()=>{ endcard.classList.remove('show'); seek(c.t0+.05); play(); };
+    box.appendChild(b); });
+})();
+
+function updateChrome(){
+  const p=T/DUR;
+  fillEl.style.width=(p*100)+'%'; headEl.style.left=(p*100)+'%';
+  timeEl.textContent=`${fmt(T)} / ${fmt(DUR)}`;
+}
+function play(){
+  if(T>=DUR) T=0;
+  poster.classList.add('hide');
+  stageWrap.classList.add('playing');
+  endcard.classList.remove('show');
+  playing=true; lastFrame=0;
+  btnPlay.innerHTML=ICON_PAUSE;
+  Music.startAt(T);
+  requestAnimationFrame(tick);
+  armIdle();
+}
+function pause(){
+  playing=false; btnPlay.innerHTML=ICON_PLAY;
+  stageWrap.classList.remove('idle');
+  if(Music.ctx&&Music.ctx.state==='running') Music.ctx.suspend();
+  if(Music.timer){ clearInterval(Music.timer); Music.timer=null; }
+}
+function seek(t,keepPlay){
+  const wasPlaying=playing;
+  if(wasPlaying){ pause(); }
+  T=clamp(t,0,DUR);
+  renderFrame(); updateChrome();
+  if(wasPlaying||keepPlay) play();
+}
+function finish(){
+  playing=false; btnPlay.innerHTML=ICON_PLAY;
+  Music.stop(); if(Music.ctx) Music.ctx.suspend();
+  stageWrap.classList.remove('playing');
+  endcard.classList.add('show');
+}
+function toggle(){ playing?pause():play(); }
+function curChapter(){ let i=0; CHAPTERS.forEach((c,k)=>{ if(T>=c.t0) i=k; }); return i; }
+function jumpChapter(d){
+  const i=curChapter();
+  const n=clamp(d<0?(T-CHAPTERS[i].t0>1?i:i-1):i+1,0,CHAPTERS.length-1);
+  seek(CHAPTERS[n].t0+.05);
+  if(!playing) play();
+}
+function armIdle(){
+  stageWrap.classList.remove('idle');
+  clearTimeout(idleTimer);
+  idleTimer=setTimeout(()=>{ if(playing) stageWrap.classList.add('idle'); },2600);
+}
+stageWrap.addEventListener('mousemove',()=>{ armIdle(); });
+stageWrap.addEventListener('touchstart',()=>{ armIdle(); },{passive:true});
+
+/* ---------- 事件 ---------- */
+document.getElementById('playBtn').addEventListener('click',()=>{ Music.init(); play(); });
+btnPlay.addEventListener('click',toggle);
+document.getElementById('btnPrev').addEventListener('click',()=>jumpChapter(-1));
+document.getElementById('btnNext').addEventListener('click',()=>jumpChapter(1));
+btnMute.addEventListener('click',()=>{ Music.init(); Music.setMuted(!Music.muted); btnMute.innerHTML=Music.muted?ICON_MUTED:ICON_VOL; });
+document.getElementById('btnFull').addEventListener('click',()=>{
+  if(document.fullscreenElement) document.exitFullscreen();
+  else stageWrap.requestFullscreen&&stageWrap.requestFullscreen();
+});
+window.addEventListener('keydown',e=>{
+  if(e.target&&/input|textarea/i.test(e.target.tagName)) return;
+  if(e.code==='Space'||e.key==='k'){ e.preventDefault(); Music.init(); toggle(); }
+  else if(e.key==='ArrowLeft'){ jumpChapter(-1); }
+  else if(e.key==='ArrowRight'){ jumpChapter(1); }
+  else if(e.key==='m'||e.key==='M'){ Music.init(); Music.setMuted(!Music.muted); btnMute.innerHTML=Music.muted?ICON_MUTED:ICON_VOL; }
+  else if(e.key==='f'||e.key==='F'){ document.getElementById('btnFull').click(); }
+});
+/* 进度条：点击 + 拖动 */
+let dragging=false;
+function barSeek(e){
+  const r=barEl.getBoundingClientRect();
+  const p=clamp((e.clientX-r.left)/r.width,0,1);
+  seek(p*DUR);
+}
+barEl.addEventListener('mousedown',e=>{ dragging=true; barSeek(e); });
+window.addEventListener('mousemove',e=>{ if(dragging) barSeek(e); });
+window.addEventListener('mouseup',()=>{ dragging=false; });
+barEl.addEventListener('click',e=>{ if(!dragging) barSeek(e); });
+barEl.addEventListener('mousemove',e=>{
+  const r=barEl.getBoundingClientRect(); const p=clamp((e.clientX-r.left)/r.width,0,1);
+  const t=p*DUR; let ch=CHAPTERS[0]; CHAPTERS.forEach(c=>{ if(t>=c.t0) ch=c; });
+  tipEl.textContent=`${ch.name} · ${fmt(t)}`;
+  tipEl.style.left=(p*100)+'%'; tipEl.style.opacity=1;
+});
+barEl.addEventListener('mouseleave',()=>{ tipEl.style.opacity=0; });
+document.addEventListener('visibilitychange',()=>{ if(document.hidden&&playing) pause(); });
+
+/* 调试句柄（浏览器验证用） */
+window.__promoFilm={ play, pause, seek, get T(){return T;}, get playing(){return playing;}, CHAPTERS, DUR, Music };
+
+/* 首帧 */
+resize(); renderFrame();
+</script>
+</body>
+</html>
