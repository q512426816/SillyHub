+// 2026-10-15-server-logs-panel task-03 / D-002@v1：服务器日志数据层
+// （类型经 gen:types 生成物引用，规则 21 禁手写）。
+export type ServerLogsResponse = components["schemas"]["ServerLogsResponse"];
