+    from app.modules.platform_sync.service import CHANGE_EVENTS_MAX_ROWS
+
+    ws_id, headers = shpsync_headers
+    total = CHANGE_EVENTS_MAX_ROWS + 5
+    pushed = 0
+    while pushed < total:
