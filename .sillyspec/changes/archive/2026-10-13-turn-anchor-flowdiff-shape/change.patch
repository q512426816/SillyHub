+ * 区分（committed/dirty/untracked/archived），轮锚 diff 行天然无此维，消费方按缺省理解。
+ */
+export function toFlowDiffShape(record: TurnAnchorRecord): {
+  rows: TurnAnchorFileStat[];
+  totals: TurnAnchorTotals;
+} {
