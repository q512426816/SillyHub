+        row = LlmProviderShare(
+            provider_id=provider.id,
+            grantee_user_id=target.id,
+            shared_by_user_id=owner_id,
+        )
+        self._session.add(row)
+        try:
+            await self._session.commit()
+        except IntegrityError:
+            await self._session.rollback()
+            row = (
