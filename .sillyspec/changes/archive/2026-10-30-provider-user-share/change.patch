+    async def share(
+        self,
+        provider_id: uuid.UUID,
+        owner_id: uuid.UUID,
+        identifier: str,
+    ) -> tuple[LlmProviderShare, str | None, str | None]:
+        """按 username/email 精确共享；幂等；拒绝自己/未知/禁用目标。
