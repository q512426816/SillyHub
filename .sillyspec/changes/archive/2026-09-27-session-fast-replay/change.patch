+    from app.modules.agent.model import AgentRun, AgentRunLog
+    from app.modules.auth.model import User as AuthUser
+
+    run_rows = (
+        await db.execute(
+            select(  # type: ignore[misc]  # 11 列 select 联合超 mypy union 穷举上限（SQLAlchemy 列式误报面）
+                AgentRun.id,
