+    cleanup();
+    window.history.replaceState(null, "", "/workspaces/ws-1/changes");
+  });
+
+  it("?tab=archive&page=3 深链：主 load 按已归档第3页请求", async () => {
+    mocks.searchParams = new URLSearchParams("tab=archive&page=3");
