+        { driver: mock.driver, ...makeDeps() },
+        { resumeDirs: dirs },
+      );
+      await sm.create({ ...BASE_INPUT });
+      mock.emitMessage(systemInitMessage('sdk-sess-h2'));
+      await flushMicrotasks();
+      mock.emitResult(resultSuccess());
+      await flushMicrotasks();
