+      writeJsonl(dirs, 'home', 'sdk-sess-h4');
+      const mock = makeMockClaudeDriver();
+      const sm = new SessionManager(
+        { driver: mock.driver, ...makeDeps() },
+        { resumeDirs: dirs },
