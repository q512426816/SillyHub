+async def _post_export(
+    client: AsyncClient,
+    token: str,
+    session_ids: list[uuid.UUID],
+    tier: str = "chat",
+) -> httpx.Response:
+    return await client.post(
+        EXPORT_URL,
+        json={"session_ids": [str(sid) for sid in session_ids], "tier": tier},
+        headers={"Authorization": f"Bearer {token}"},
+    )
