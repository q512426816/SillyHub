+        sess = await _seed_session(db_session, user_id=owner.id, title="大附件会话")
+        # 2 × 300MB = 600MB > 512MB（EXPORT_ATTACHMENTS_TOTAL_BYTES_LIMIT）。
+        await _seed_attachment(
+            db_session,
+            user_id=owner.id,
+            session_id=sess.id,
+            name="a.bin",
+            kind="file",
