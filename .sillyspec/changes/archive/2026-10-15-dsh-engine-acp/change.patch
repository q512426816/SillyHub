+      sessionUpdate: 'agent_message_chunk',
+      messageId: 'm-1',
+      content: { type: 'text', text: '你好，世界' },
+    });
+    expect(out).toHaveLength(1);
+    expect(out[0]).toMatchObject({
+      type: 'text',
+      content: '你好，世界',
+      metadata: { message_id: 'm-1' },
