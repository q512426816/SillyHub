+    });
+  }
+
+  async interrupt(handle: DshAcpHandle | null): Promise<boolean> {
+    if (!handle) return false;
+    const ctx = internalCtx(handle);
+    if (!ctx.activePrompt || !ctx.acpSessionId || ctx.closed) return false;
+    try {
+      await ctx.conn.request('session/cancel', { sessionId: ctx.acpSessionId });
+      return true;
+    } catch {
+      return false; // no-op 不冒泡（E3）
+    }
+  }
+
+  async getThinkingLevels(_handle: DshAcpHandle): Promise<ThinkingLevels> {
+    // ACP reasoning_effort 为模型条件性三档，静态档表（运行时真值以模型为准）。
+    return { levels: ['low', 'medium', 'high'] };
+  }
+
+  async setThinkingLevel(
+    handle: DshAcpHandle,
+    level: string,
+  ): Promise<ThinkingLevelResult> {
+    const ctx = internalCtx(handle);
+    const effort = mapThinkingLevel(level);
+    if (effort === undefined) return { ok: false, error: `未知平台档位: ${level}` };
+    try {
+      await ctx.conn.request('session/set_config_option', {
+        sessionId: ctx.acpSessionId,
+        option: { optionId: 'reasoning_effort', value: effort },
+      });
+      return { ok: true };
+    } catch (err) {
+      return {
+        ok: false,
+        error: err instanceof Error ? err.message : String(err),
+      };
+    }
+  }
+}
+
+/** dsh 可执行缺失（agent-detector 未注册/探测不到）。 */
+export class DshExecutableNotFoundError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'DshExecutableNotFoundError';
+  }
+}
+
+// ---------------------------------------------------------------------------
+// 内部：NDJSON JSON-RPC 连接（最小实现；id 关联 + 超时 + 通知/服务端请求分发）
+// ---------------------------------------------------------------------------
+
+interface JsonRpcMessage {
+  jsonrpc?: string;
+  id?: number | string | null;
+  method?: string;
+  params?: unknown;
+  result?: unknown;
+  error?: { code?: number; message?: string };
+}
+
+type ServerResponder = (result: unknown) => Promise<void>;
+
+class AcpJsonRpcConnection {
+  private _nextId = 1;
+  private readonly _pending = new Map<
+    number,
+    { resolve: (v: unknown) => void; reject: (e: Error) => void; timer: NodeJS.Timeout }
+  >();
+  private _notifyHandler:
+    | ((params: unknown) => void)
+    | undefined;
+  private _serverRequestHandler:
+    | ((
+        method: string,
+        params: unknown,
+        respond: ServerResponder,
+      ) => Promise<void>)
+    | undefined;
+  private _disposed = false;
+  /**
+   * 早到响应暂存（id → 原始 result/error）：同一 data chunk 内多行被同步解析时，
+   * 后一行的响应可能先于对应 request 的微任务发出（2026-10-15 task-03 实测）；
+   * 暂存并在 request() 建立后核对，防丢。上限 32 防垃圾 id 无界增长。
+   */
+  private readonly _early = new Map<number, JsonRpcMessage>();
+
+  constructor(private readonly child: ChildProcessWithoutNullStreams) {
+    // LF 严格分帧：复用 pi 驱动 LfLineFramer（仓内先例禁 Node readline 做 JSON
+    // 行分帧——U+2028/U+2029 在 JSON 字符串合法而 readline 会当行分隔切行）。
+    const framer = new LfLineFramer((line) => this._onLine(line));
+    child.stdout.on('data', (chunk: Buffer) => framer.push(chunk));
+    child.stdout.on('end', () => framer.end());
+    child.stderr.setEncoding('utf8');
+  }
+
+  onNotification(fn: (params: unknown) => void): () => void {
+    this._notifyHandler = fn;
+    return () => {
+      if (this._notifyHandler === fn) this._notifyHandler = undefined;
+    };
+  }
+
+  onServerRequest(
+    fn: (method: string, params: unknown, respond: ServerResponder) => Promise<void>,
+  ): void {
+    this._serverRequestHandler = fn;
+  }
+
+  request(method: string, params: unknown): Promise<unknown> {
+    if (this._disposed) return Promise.reject(new Error('dsh acp connection disposed'));
+    const id = this._nextId++;
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this._pending.delete(id);
+        reject(new Error(`dsh acp request timeout: ${method}`));
+      }, REQUEST_TIMEOUT_MS);
+      this._pending.set(id, { resolve, reject, timer });
+      this._send({ jsonrpc: '2.0', id, method, params });
+      const early = this._early.get(id);
+      if (early !== undefined) {
+        this._early.delete(id);
+        clearTimeout(timer);
+        this._pending.delete(id);
+        if (early.error !== undefined) {
+          reject(new Error(early.error.message ?? `dsh acp error ${early.error.code ?? ''}`));
+        } else {
+          resolve(early.result);
+        }
+      }
+    });
+  }
+
+  /** 服务端请求应答（result 形态直接透传；错误用 JSON-RPC error 对象）。 */
+  private async _respond(id: number | string, result: unknown): Promise<void> {
+    this._send({ jsonrpc: '2.0', id, result });
+  }
+
+  private _send(msg: JsonRpcMessage): void {
+    this.child.stdin.write(`${JSON.stringify(msg)}\n`);
+  }
+
+  private _onLine(line: string): void {
+    if (this._disposed || line.trim().length === 0) return;
+    let msg: JsonRpcMessage;
+    try {
+      msg = JSON.parse(line) as JsonRpcMessage;
+    } catch {
+      return; // 坏 JSON 不崩（诊断靠 stderr 通道）
+    }
+    if (msg.id !== undefined && msg.id !== null && msg.method !== undefined) {
+      // 服务端请求
+      const respond = (result: unknown) => this._respond(msg.id as number, result);
+      void this._serverRequestHandler?.(msg.method, msg.params, respond);
+      return;
+    }
+    if (msg.id !== undefined && msg.id !== null) {
+      // 响应（关联 id）
+      const pending = this._pending.get(msg.id as number);
+      if (!pending) {
+        if (this._early.size < 32) this._early.set(msg.id as number, msg);
+        return;
+      }
+      clearTimeout(pending.timer);
+      this._pending.delete(msg.id as number);
+      if (msg.error !== undefined) {
+        pending.reject(new Error(msg.error.message ?? `dsh acp error ${msg.error.code ?? ''}`));
+      } else {
+        pending.resolve(msg.result);
+      }
+      return;
+    }
+    // 通知
+    this._notifyHandler?.(msg.params);
+  }
+
+  dispose(): void {
+    if (this._disposed) return;
+    this._disposed = true;
+    for (const [, p] of this._pending) {
+      clearTimeout(p.timer);
+      p.reject(new Error('dsh acp connection disposed'));
+    }
+    this._pending.clear();
+    this._early.clear();
+  }
+}
+
+// ---------------------------------------------------------------------------
+// 内部工具
+// ---------------------------------------------------------------------------
+
+/** 句柄 → 内部 ctx（start 时挂载）。 */
+function internalCtx(handle: DshAcpHandle): {
+  conn: AcpJsonRpcConnection;
+  child: ChildProcessWithoutNullStreams;
+  input: AsyncIterable<UserTurnInput>;
+  opts: DshAcpStartOptions;
+  acpSessionId?: string;
+  activePrompt: boolean;
+  closed: boolean;
+} {
+  const ctx = (handle as { __dsh?: unknown }).__dsh;
+  if (ctx === undefined) throw new Error('invalid dsh handle');
+  return ctx as ReturnType<typeof internalCtx>;
+}
+
+/** envelope 组装（raw 仅调试开关携带，D-002@v1）。 */
+function envelope(events: AgentEvent[]): TurnMessageEnvelope {
+  const raw =
+    process.env.SILLYHUB_DEBUG_RAW_EVENTS === '1' ? { source: 'dsh-acp' } : undefined;
+  return raw === undefined ? { events } : { events, raw };
+}
+
+/**
+ * 平台思考档位 → ACP reasoning_effort 三档本地映射。
+ * off → undefined（不携带=引擎默认，claude 矩阵同语义）；ACP 无 minimal/xhigh/max。
+ */
+export function mapThinkingLevel(platformLevel: string | undefined): string | undefined {
+  switch (platformLevel) {
+    case undefined:
+    case 'off':
+      return undefined;
+    case 'minimal':
+    case 'low':
+      return 'low';
+    case 'medium':
+      return 'medium';
+    case 'high':
+    case 'xhigh':
+    case 'max':
+      return 'high';
+    default:
+      return undefined;
+  }
+}
diff --git a/sillyhub-daemon/src/interactive/dsh-acp-events.ts b/sillyhub-daemon/src/interactive/dsh-acp-events.ts
new file mode 100644
index 000000000..76fbffaa7
--- /dev/null
+++ b/sillyhub-daemon/src/interactive/dsh-acp-events.ts
@@ -0,0 +1,170 @@
+/**
+ * dsh-acp-events.ts —— ACP session/update 通知 → AgentEvent 归一化器。
+ *
+ * 2026-10-15-dsh-engine-acp task-02（D-003 方案 A：自研 ACP 驱动，协议帧走
+ * adapters/json-rpc.ts；本文件只做纯映射，spawn/握手/轮次归 dsh-acp-driver.ts）。
+ *
+ * 线格式事实源：dsh 仓库 packages/acp/acp/src/updates.ts（服务端实际产出的
+ * SessionUpdate 结构）——
+ *   agent_thought_chunk { messageId, content: {type:'text', text} }
+ *   agent_message_chunk { messageId, content: {type:'text'|'image'|'resource_link', …} }
+ *   tool_call           { toolCallId, title, kind, status:'in_progress', rawInput }
+ *   tool_call_update    { toolCallId, status:'completed'|'failed', content:[{type:'content', content}] }
+ *   usage_update        { used, size }
+ * plans / modes / elicitation 为 ACP 明示 unsupported，不在此列；config_option_update
+ * 等非本轮语义类型按未知类型安全忽略（dsh alpha 前向演进不炸）。
+ *
+ * 映射要点：
+ * - image 块不产出事件——caps.multimodal=false（dsh ACP 图片依赖 durable
+ *   attachment store + exact route，design R-08 保守降级），图片本就不进 dsh 会话；
+ * - resource_link 保持 dsh 侧模型可见形态（方括号引用行）落 text；
+ * - usage_update 用「usage-only 空事件」载体（type=text + content=''）——pi
+ *   buildUsageEvent / codex usage_update 同款（session-manager _liftSessionUsage
+ *   识别该形态）；ACP 只报上下文占用（used/size），映射 ctx_tokens=used，
+ *   input/output 拆分 ACP 不提供，不编造。
+ */
+
+import type { AgentEvent } from '../types.js';
+
+/** ACP session/update 通知的最小结构视图（宽容形状：未知键透传忽略）。 */
+export interface AcpSessionUpdate {
+  /** update 变体名（sessionUpdate 字段）。 */
+  sessionUpdate: string;
+  /** agent_message_chunk / agent_thought_chunk 的消息锚。 */
+  messageId?: string;
+  /** 消息/思考的内容块。 */
+  content?: {
+    type: string;
+    text?: string;
+    name?: string;
+    uri?: string;
+    [key: string]: unknown;
+  };
+  /** 工具生命周期 ID（tool_call / tool_call_update 配对键）。 */
+  toolCallId?: string;
+  /** 工具显示名（tool_call.title）。 */
+  title?: string;
+  kind?: string;
+  status?: string;
+  /** 工具入参（JSON 值或模型坏输出的原文）。 */
+  rawInput?: unknown;
+  /** usage_update：上下文占用分子。 */
+  used?: number;
+  /** usage_update：上下文窗口分母。 */
+  size?: number;
+  [key: string]: unknown;
+}
+
+/**
+ * 归一化单条 session/update 通知为 0..n 条 AgentEvent。
+ *
+ * 纯函数：无 IO、无状态、不抛错——未知 sessionUpdate 类型返回 []（调用方
+ * 继续消费后续通知流），畸形字段按缺省值处理（tool_result 无 content 产出
+ * 空文本，保证 call_id 配对不悬空）。
+ */
+export function normalizeAcpUpdate(update: AcpSessionUpdate): AgentEvent[] {
+  switch (update.sessionUpdate) {
+    case 'agent_message_chunk':
+      return agentMessageChunk(update);
+    case 'agent_thought_chunk':
+      return agentThoughtChunk(update);
+    case 'tool_call':
+      return toolCall(update);
+    case 'tool_call_update':
+      return toolCallUpdate(update);
+    case 'usage_update':
+      return usageUpdate(update);
+    default:
+      // 未知类型安全忽略（config_option_update / plan / current_mode_update /
+      // dsh 未来新增变体）——前向兼容 alpha 演进。
+      return [];
+  }
+}
+
+function agentMessageChunk(update: AcpSessionUpdate): AgentEvent[] {
+  const block = update.content;
+  if (block === undefined) return [];
+  if (block.type === 'text') {
+    return [
+      {
+        type: 'text',
+        content: block.text ?? '',
+        metadata: { message_id: update.messageId },
+      },
+    ];
+  }
+  if (block.type === 'resource_link') {
+    return [
+      {
+        type: 'text',
+        content: `[resource_link] ${block.name ?? ''} ${block.uri ?? ''}`.trimEnd(),
+        metadata: { message_id: update.messageId },
+      },
+    ];
+  }
+  // image 等非文本块：multimodal=false 口径下不产出（见文件头注释）。
+  return [];
+}
+
+function agentThoughtChunk(update: AcpSessionUpdate): AgentEvent[] {
+  const text = update.content?.text ?? '';
+  // dsh 侧空文本 thought 不发（updates.ts:25-29），此处防御同语义。
+  if (text.length === 0) return [];
+  return [
+    {
+      type: 'thinking',
+      content: text,
+      metadata: { message_id: update.messageId },
+    },
+  ];
+}
+
+function toolCall(update: AcpSessionUpdate): AgentEvent[] {
+  const rawInput = update.rawInput;
+  // rawInput 可能是 JSON 值（对象/数组/原始类型）或模型坏输出的原文
+  // （dsh parseToolArguments 的 opaque 保留分支）——原文非 JSON 时直接用字符串。
+  const content =
+    typeof rawInput === 'string' ? rawInput : JSON.stringify(rawInput ?? {});
+  return [
+    {
+      type: 'tool_use',
+      content,
+      tool_name: update.title ?? '',
+      call_id: update.toolCallId ?? '',
+    },
+  ];
+}
+
+function toolCallUpdate(update: AcpSessionUpdate): AgentEvent[] {
+  const blocks = Array.isArray(update.content) ? update.content : [];
+  const text = blocks
+    .map((entry) => {
+      const inner = (entry as { content?: { text?: string } }).content;
+      return inner?.text ?? '';
+    })
+    .join('');
+  const failed = update.status === 'failed';
+  return [
+    {
+      type: 'tool_result',
+      content: text,
+      call_id: update.toolCallId ?? '',
+      ...(failed ? { metadata: { tool_status: 'failed' } } : {}),
+    },
+  ];
+}
+
+function usageUpdate(update: AcpSessionUpdate): AgentEvent[] {
+  const used = typeof update.used === 'number' ? update.used : 0;
+  // usage-only 空事件载体（pi buildUsageEvent / codex usage_update 同款）；
+  // ctx_tokens = ACP used（上下文占用快照），窗口分母 size 进元数据备查。
+  const usage = { ctx_tokens: used };
+  return [
+    {
+      type: 'text',
+      content: '',
+      usage,
+      metadata: { status: 'usage_update', usage, context_size: update.size },
+    },
+  ];
+}
