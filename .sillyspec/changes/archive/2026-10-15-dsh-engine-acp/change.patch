+
+describe('normalizeAcpUpdate：工具生命周期', () => {
+  it('tool_call in_progress → tool_use 事件（tool_name=title / call_id=toolCallId / 入参 JSON）', () => {
+    const out = normalizeAcpUpdate({
+      sessionUpdate: 'tool_call',
