+
+describe('normalizeAcpUpdate：上下文用量与未知类型', () => {
+  it('usage_update → usage-only 空事件（type=text/content=""，ctx_tokens=used，pi/codex 同款载体）', () => {
+    const out = normalizeAcpUpdate({ sessionUpdate: 'usage_update', used: 12345, size: 200000 });
