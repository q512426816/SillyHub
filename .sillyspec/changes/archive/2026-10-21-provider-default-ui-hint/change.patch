+export function noProviderLabel(
+  providers: LlmProviderRead[] | null | undefined,
+): string {
+  const def = (providers ?? []).find((p) => p.is_default);
+  return def ? `不指定（默认：${def.name}）` : NO_PROVIDER_FALLBACK_LABEL;
