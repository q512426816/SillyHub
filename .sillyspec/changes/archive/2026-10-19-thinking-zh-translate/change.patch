+
+
+class _FakeTranslator:
+    """同步假引擎：按块回显 "译[{n}]:{chunk}" 并计数（缓存命中断言用）。"""
+
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def translate(self, texts: list[str]) -> list[str]:
