+describe("2026-10-29-engine-live-perception: 等待三态与估算补显（FR-03）", () => {
+  /** 心跳状态构造（与 MarqueeHeartbeatState 同构）。 */
+  function hb(over: Partial<{
+    kind: "awaiting_first_token" | "generating";
+    est_chars: number | null;
+    est_tokens: number | null;
+    precision: "estimated" | "authoritative";
+    source: string;
+    at: number;
+  }> = {}) {
+    return {
+      kind: "generating" as const,
+      est_chars: 42000,
+      est_tokens: 12000,
+      precision: "estimated" as const,
+      source: "claude_input_json_delta",
+      at: Date.now(),
+      ...over,
+    };
+  }
+
+  function awaitText(props: {
+    heartbeat?: ReturnType<typeof hb> | null;
+    lastEventAt?: number;
+    turnTokens?: { input: number | null; output: number | null } | null;
+  }) {
+    const { getByTestId } = render(
+      <TurnLiveMarquee
+        entries={deriveLiveMarqueeEntries([tool("t1", { status: "ok" })])}
+        {...props}
+      />,
+    );
+    return getByTestId("marquee-awaiting").textContent ?? "";
+  }
+
+  it("无心跳 → 现状纯计时文案（零回归）", () => {
+    const text = awaitText({ lastEventAt: Date.now() - 2_000 });
+    expect(text).toContain("等待模型响应");
+    expect(text).not.toContain("正在生成大段内容");
+    expect(text).not.toContain("约");
+  });
+
+  it("generating 心跳（estimated）→ 正在生成大段内容 + 已产出约 N token", () => {
+    const text = awaitText({ heartbeat: hb(), lastEventAt: Date.now() - 2_000 });
+    expect(text).toContain("正在生成大段内容");
+    expect(text).toContain("已产出约 12,000 token");
+  });
+
+  it("awaiting_first_token 心跳 → 正在等待模型响应 · 已发送上下文", () => {
+    const text = awaitText({
+      heartbeat: hb({ kind: "awaiting_first_token", est_chars: null, est_tokens: null }),
+      lastEventAt: Date.now() - 2_000,
+    });
+    expect(text).toContain("正在等待模型响应");
+    expect(text).toContain("已发送上下文");
+  });
+
+  it("authoritative 心跳（codex）→ 权威值不带「约」", () => {
+    const text = awaitText({
+      heartbeat: hb({ precision: "authoritative", source: "codex_token_usage", est_tokens: 120 }),
+      lastEventAt: Date.now() - 2_000,
+    });
+    expect(text).toContain("已输出 120 token");
+    expect(text).not.toContain("约 120");
+  });
+
+  it("心跳过期（>5s 无新心跳）→ 回落现状纯计时（瞬态自清）", () => {
+    const text = awaitText({
+      heartbeat: hb({ at: Date.now() - 8_000 }),
+      lastEventAt: Date.now() - 2_000,
+    });
+    expect(text).toContain("等待模型响应");
+    expect(text).not.toContain("正在生成大段内容");
+  });
+
+  it("等待 >30s → 追加大内容慢提示（三态通用）", () => {
+    const text = awaitText({ heartbeat: hb(), lastEventAt: Date.now() - 40_000 });
+    expect(text).toContain("大内容可能需要几分钟");
+  });
+
+  it("估算补显与轮级权威 token 并存（约值 + ↑↓ 同屏）", () => {
+    const text = awaitText({
+      heartbeat: hb(),
+      lastEventAt: Date.now() - 2_000,
+      turnTokens: { input: 19415, output: 54160 },
+    });
+    expect(text).toContain("已产出约 12,000 token");
+    expect(text).toContain("↑19,415");
+    expect(text).toContain("↓54,160");
+  });
+});
diff --git a/frontend/src/components/daemon/session-panel/__tests__/turn-heartbeat-state.test.ts b/frontend/src/components/daemon/session-panel/__tests__/turn-heartbeat-state.test.ts
new file mode 100644
index 000000000..a48045b5f
--- /dev/null
+++ b/frontend/src/components/daemon/session-panel/__tests__/turn-heartbeat-state.test.ts
@@ -0,0 +1,129 @@
+/**
+ * 2026-10-29-engine-live-perception（FR-03）：applyTurnHeartbeat 纯函数——
+ * 轮内心跳写入轮状态的守卫面（main 选主 / 载荷守卫 / runId 路由与竞态回退 /
+ * 终态清空）。applyTurnPhase 同款路由语义的对齐用例。
+ */
+import { describe, expect, it } from "vitest";
+
+import {
+  applyTurnHeartbeat,
+  clearTurnPhase,
+} from "@/components/daemon/session-panel/turn-state";
+import type { SessionTurnView } from "@/components/daemon/turn-timeline";
+
+function makeTurn(runId: string, over: Partial<SessionTurnView> = {}): SessionTurnView {
+  return {
+    runId,
+    turn: 1,
+    prompt: "继续",
+    output: "",
+    status: "running",
+    seenLogIds: new Set<string>(),
+    inputTokens: null,
+    outputTokens: null,
+    ctxTokens: null,
+    apiDurationMs: null,
+    errorDetail: null,
+    ...over,
+  };
+}
+
+const MAIN_HB = {
+  kind: "generating",
+  est_chars: 4200,
+  est_tokens: 1200,
+  precision: "estimated",
+  source: "claude_input_json_delta",
+} as const;
+
+describe("applyTurnHeartbeat（2026-10-29-engine-live-perception FR-03）", () => {
+  it("main 心跳按 runId 写入轮状态（at=本地到达时刻）", () => {
+    const turns = [makeTurn("run-1")];
+    const next = applyTurnHeartbeat(turns, "run-1", { ...MAIN_HB });
+    expect(next[0]!.heartbeat).toMatchObject({
+      kind: "generating",
+      est_chars: 4200,
+      est_tokens: 1200,
+      precision: "estimated",
+      source: "claude_input_json_delta",
+    });
+    expect(next[0]!.heartbeat!.at).toBeGreaterThan(0);
+    // 原数组不可变（map 新对象）。
+    expect(turns[0]!.heartbeat).toBeUndefined();
+  });
+
+  it("选主（Grill P1-b）：子代理心跳（parent_tool_use_id 非空）不入主轮状态", () => {
+    const turns = [makeTurn("run-1")];
+    const next = applyTurnHeartbeat(turns, "run-1", {
+      ...MAIN_HB,
+      parent_tool_use_id: "toolu_sub_1",
+    });
+    expect(next).toBe(turns); // 原样返回（未写入）
+  });
+
+  it("载荷守卫：kind/precision 非法值静默忽略（不伪造）", () => {
+    const turns = [makeTurn("run-1")];
+    expect(
+      applyTurnHeartbeat(turns, "run-1", {
+        ...MAIN_HB,
+        kind: "generating_text",
+      }),
+    ).toBe(turns);
+    expect(
+      applyTurnHeartbeat(turns, "run-1", {
+        ...MAIN_HB,
+        precision: "maybe",
+      }),
+    ).toBe(turns);
+    expect(
+      applyTurnHeartbeat(turns, "run-1", {
+        ...MAIN_HB,
+        kind: null,
+        precision: null,
+      }),
+    ).toBe(turns);
+  });
+
+  it("est_* 非数值归 null（不伪造 0）", () => {
+    const turns = [makeTurn("run-1")];
+    const next = applyTurnHeartbeat(turns, "run-1", {
+      kind: "awaiting_first_token",
+      precision: "estimated",
+      source: "zcode_telemetry",
+    });
+    expect(next[0]!.heartbeat).toMatchObject({
+      kind: "awaiting_first_token",
+      est_chars: null,
+      est_tokens: null,
+    });
+  });
+
+  it("未命中 runId 时回退 currentRunId 活跃轮（竞态回退同 applyTurnPhase FR-01）", () => {
+    const turns = [makeTurn("placeholder-1")];
+    const next = applyTurnHeartbeat(
+      turns,
+      "real-run-9",
+      { ...MAIN_HB },
+      "placeholder-1",
+    );
+    expect(next[0]!.heartbeat).toBeDefined();
+  });
+
+  it("无 runId / 无回退命中：原样返回不建幽灵轮", () => {
+    const turns = [makeTurn("run-1")];
+    expect(applyTurnHeartbeat(turns, null, { ...MAIN_HB })).toBe(turns);
+    expect(
+      applyTurnHeartbeat(turns, "ghost-run", { ...MAIN_HB }, null),
+    ).toBe(turns);
+  });
+
+  it("clearTurnPhase 终态一并清空 heartbeat（估算补显落定即隐兜底）", () => {
+    const turn = makeTurn("run-1", {
+      currentPhase: { phase: "first_event", at: 1 },
+      heartbeat: { ...MAIN_HB, at: 1 },
+    });
+    const cleared = clearTurnPhase(turn);
+    expect(cleared.currentPhase).toBeNull();
+    expect(cleared.heartbeat).toBeNull();
+  });
+});
