+        await session.execute(
+            select(func.max(AgentRunLog.timestamp)).where(
+                AgentRunLog.run_id == run_id,
+                AgentRunLog.channel == "user_input",
+            )
+        )
+    ).scalar_one_or_none()
+    return last_user_at is None or _as_utc(last_ask_at) > _as_utc(last_user_at)
