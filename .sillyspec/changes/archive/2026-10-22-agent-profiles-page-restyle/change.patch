+"use client";
+
+/**
+ * 轨迹泳道时间轴（Trajectory swimlane timeline）—— 2026-10-20-session-page-dsh-alignment 档 1（D-024 / D-026）。
+ *
+ * 形态（三条泳道共用**同一个绝对时间轴**，可缩放 / 可平移）：
+ *
+ *   [ 输入  ▍     ▍       ▍   ▍        ]  tick（user_input，success token）
+ *   [ 模型  ▬▬▬   ▬▬▬    ▬▬▬▬▬  ▬▬     ]  条（模型活动，brand token）
+ *   [ 工具    ▬▬   ▬   ▬▬▬▬      ▬▬▬▬ ]  条（工具调用，warning token）
+ *   [ 总览  ▏███████████▕            ]  整窗 + 视野刷子（10px）
+ *           └──── 共享绝对时间轴（轮边界 1px 竖线）────┘
+ *
+ * 数据全部来自纯函数 `build-trajectory.ts` 的 `trajectory.lanes`；所有时间↔位置
+ * 的数学在 `zoom.ts`（纯函数、可单测），本组件只做三件事：
+ *   1. 指针坐标 → `ratio`（`getBoundingClientRect` 量一次轨道宽度）；
+ *   2. 把 `zoomAt` / `panView` 的结果存进 `view` 状态；
+ *   3. 渲染 `left% = (start - view.start) / (view.end - view.start)`。
+ *
+ * 交互（全部围绕 `view`，不动 `windowStart/windowEnd`）：
+ *   - **滚轮**：以指针所指时刻为锚点缩放，一档 1.15 倍；跨度钳在 [60s, 整窗]。
+ *     监听器用 `addEventListener(..., { passive: false })` 注册——React 的
+ *     `onWheel` 是 passive 的，`preventDefault` 会被浏览器忽略并刷控制台警告。
+ *   - **拖拽**：在泳道空白处按下并移动 = 平移；在条上按下 = 选中（不平移）。
+ *     平移量由「按下时的视野 + 相对按下点的位移」算出，因此对同一手势重复应用
+ *     是幂等的（不会因为逐帧累计而加速）。
+ *   - **双击**：回到整窗；右上角另有 `重置` 按钮（已是整窗时禁用）。
+ *   - **总览刷子**：整窗缩略条上的半透明矩形就是当前视野；拖它平移视野，
+ *     点刷子外面则把视野中心挪到指针处。
+ *   - **命中判定**：条本身可能只有 2px，命中带按 6px 算（`pickSpanAt`）；
+ *     重叠时取**中心离指针最近**的那根（真实数据 415 根 tool 条在整窗下必然重叠）。
+ *
+ * 性能：`wheel` / `pointermove` 都只写 ref + `requestAnimationFrame` 合帧，
+ * 一帧最多一次 `setView`；位置换算全部在 `useMemo`（依赖 `view`）里，选中行变化
+ * 不会重算几百个百分比。
+ *
+ * 颜色只用语义 token：input=success / model=brand / tool=warning，三主题
+ * （ai-native / blue / dark）随 `html[data-theme]` 自动换肤，无字面色。
+ */
+
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import type { MouseEvent as ReactMouseEvent, PointerEvent as ReactPointerEvent } from "react";
+
+import { cn } from "@/lib/utils";
+
+import type {
+  Trajectory,
+  TrajectoryLaneKind,
+  TrajectorySpan,
+} from "./build-trajectory";
+import {
+  HIT_BAND_PX,
+  ZOOM_STEP,
+  formatTickLabel,
+  formatViewRangeLabel,
+  fullWindowSpan,
+  panView,
+  pickSpanAt,
+  ratioAtTime,
+  tickTimes,
+  viewSpan,
+  zoomAt,
+  type SpanBand,
+  type ViewLimits,
+  type ViewWindow,
+} from "./zoom";
+
+/** 左侧固定标签栏宽（px）——标签与轨道用同一常量，避免两处漂移。 */
+const GUTTER_PX = 44;
+
+/** 每行泳道高（px）与条高（px）：条 7px 居中在 16px 行里，留 4.5px 呼吸。 */
+const LANE_HEIGHT_PX = 12;
+const BAR_HEIGHT_PX = 7;
+
+/** 总览缩略条高度（px）——刻意压在 10px，视线仍以三条泳道为主。 */
+const OVERVIEW_HEIGHT_PX = 10;
+
+/** 轴上的时间刻度数量（5–7 档；整窗 577 分钟取 7 档，缩到 1 分钟后同样 7 档）。 */
+const AXIS_TICK_COUNT = 7;
+
+/** 条的最小可点宽度（px）：2px 的条 + 6px 命中带 = `HIT_BAND_PX`。 */
+const MIN_BAR_PX = 2;
+
+/** 驾驶手势的位移阈值（px）：小于它算点击，不抑制 click。 */
+const DRAG_THRESHOLD_PX = 3;
+
+/** 泳道 → 语义色 / 标签（顺序即渲染顺序：输入、模型、工具）。 */
+const LANE_ROWS: Array<{ key: TrajectoryLaneKind; label: string; bar: string }> = [
+  { key: "input", label: "输入", bar: "bg-success" },
+  { key: "model", label: "模型", bar: "bg-brand-500" },
+  { key: "tool", label: "工具", bar: "bg-warning" },
+];
+
+/**
+ * 模型泳道口径标注（task-12）：
+ *   - `observed` → 「真实占用」（每个 attempt 的起止区间，TTFT 见条 title）；
+ *   - `approx`   → 「近似（无 TTFT 采样）」（整段非工具空档，见 D-024 / D-026）。
+ * 两态互斥：同一时刻只会渲染其中一个文案。
+ */
+const MODEL_BASIS_LABEL: Record<"observed" | "approx", string> = {
+  observed: "真实占用",
+  approx: "近似（无 TTFT 采样）",
+};
+
+function clamp01(value: number): number {
+  if (!Number.isFinite(value)) return 0;
+  if (value < 0) return 0;
+  if (value > 1) return 1;
+  return value;
+}
+
+function pad2(value: number): string {
+  return String(Math.max(0, Math.trunc(value))).padStart(2, "0");
+}
+
+/** 时长：`<1s` → ms；`<1min` → 1 位小数秒；否则 `XmYYs`。 */
+function formatDuration(ms: number): string {
+  if (!Number.isFinite(ms) || ms <= 0) return "0ms";
+  if (ms < 1000) return `${Math.round(ms)}ms`;
+  if (ms < 60_000) return `${(ms / 1000).toFixed(1)}s`;
+  const minutes = Math.floor(ms / 60_000);
+  const seconds = Math.round((ms % 60_000) / 1000);
+  return `${minutes}m${pad2(seconds)}s`;
+}
+
+export type TrajectoryScaleMode = "duration" | "equal";
+
+export interface TrajectoryTimelineProps {
+  trajectory: Trajectory;
+  selectedRowId?: string | null;
+  onSelectRow?: (_rowId: string) => void;
+  /**
+   * 时间线投影模式（2026-10-22-trajectory-view-redesign / D-016）：
+   * `duration` = 现有真实时间轴（缩放/平移/刷子可用）；`equal` = 只读概览，
+   * 条块按出现顺序等宽排列，禁用手势、隐藏时间刻度与轮边界竖线。
+   */
+  scaleMode?: TrajectoryScaleMode;
+  className?: string;
+}
+
+interface PlacedSpan {
+  span: TrajectorySpan;
+  /** 相对**当前视野**的百分比位置（可为负 = 视野左侧之外，靠 overflow 裁掉）。 */
+  left: number;
+  /** 百分比宽度（可为 0，靠 min-width 兜底）。 */
+  width: number;
+}
+
+export function TrajectoryTimeline({
+  trajectory,
+  selectedRowId,
+  onSelectRow,
+  scaleMode = "duration",
+  className,
+}: TrajectoryTimelineProps) {
+  const equalMode = scaleMode === "equal";
+  const { turns, lanes, windowStart, windowEnd, coverage, modelBasis } = trajectory;
+
+  const limits = useMemo<ViewLimits>(
+    () => ({ start: windowStart, end: windowEnd }),
+    [windowStart, windowEnd],
+  );
+  const [view, setView] = useState<ViewWindow>(() => ({ start: windowStart, end: windowEnd }));
+
+  // 手势回调在 rAF 里读的是「最新已提交值」，用 ref 镜像一份（不在渲染期依赖闭包）。
+  const viewRef = useRef(view);
+  viewRef.current = view;
+  const limitsRef = useRef(limits);
+  limitsRef.current = limits;
+
+  const trackRef = useRef<HTMLDivElement | null>(null);
+  const sectionRef = useRef<HTMLElement | null>(null);
+  const overviewRef = useRef<HTMLDivElement | null>(null);
+
+  const rafRef = useRef<number | null>(null);
+  const zoomPendingRef = useRef<{ steps: number; clientX: number } | null>(null);
+  const panPendingRef = useRef<number | null>(null);
+  const brushPendingRef = useRef<number | null>(null);
+  const dragRef = useRef<{
+    pointerId: number;
+    startX: number;
+    view: ViewWindow;
+    width: number;
+    moved: boolean;
+    captured: boolean;
+  } | null>(null);
+  const brushDragRef = useRef<{
+    pointerId: number;
+    grabOffsetMs: number;
+    fullSpan: number;
+  } | null>(null);
+  /** 刚平移过 → 吞掉紧随其后的 click（否则拖完会顺手选中一根条）。 */
+  const suppressClickRef = useRef(false);
+
+  // 数据集换人（重新 staging 真实导出）时回到整窗。
+  useEffect(() => {
+    setView({ start: windowStart, end: windowEnd });
+  }, [windowStart, windowEnd]);
+
+  useEffect(
+    () => () => {
+      if (rafRef.current == null) return;
+      if (typeof window !== "undefined" && typeof window.cancelAnimationFrame === "function") {
+        window.cancelAnimationFrame(rafRef.current);
+      } else {
+        clearTimeout(rafRef.current);
+      }
+      rafRef.current = null;
+    },
+    [],
+  );
+
+  /** 一帧的合并刷新：缩放 / 平移 / 刷子拖拽各自最多一次 `setView`。 */
+  const flush = useCallback(() => {
+    rafRef.current = null;
+
+    const zoom = zoomPendingRef.current;
+    zoomPendingRef.current = null;
+    if (zoom && trackRef.current) {
+      const rect = trackRef.current.getBoundingClientRect();
+      if (rect.width > 0) {
+        // ratio 只取决于布局（轨道宽），与视野无关，可以先算；
+        // 锚点时刻必须用「这份更新真正要作用的那份视野」现算——若用 viewRef 里的
+        // 已提交值，连续多档时每档都会差一个 span 的 13%，锚点会一路滑走。
+        const ratio = clamp01((zoom.clientX - rect.left) / rect.width);
+        const factor = Math.pow(ZOOM_STEP, -zoom.steps);
+        setView((previous) =>
+          zoomAt(
+            previous,
+            previous.start + ratio * viewSpan(previous),
+            factor,
+            limitsRef.current,
+          ),
+        );
+      }
+    }
+
+    const panDelta = panPendingRef.current;
+    panPendingRef.current = null;
+    if (panDelta != null) {
+      const drag = dragRef.current;
+      if (drag && drag.width > 0) {
+        // 位移是「相对按下点」的绝对量，基准视野取按下时那一份 → 逐帧重复应用幂等
+        // （否则每帧都在上一帧的结果上再挪一次，手感会加速 3–5 倍）。
+        const deltaMs = -(panDelta / drag.width) * viewSpan(drag.view);
+        setView(panView(drag.view, deltaMs, limitsRef.current));
+      }
+    }
+
+    const brushTarget = brushPendingRef.current;
+    brushPendingRef.current = null;
+    if (brushTarget != null) {
+      setView((previous) =>
+        panView(previous, brushTarget - previous.start, limitsRef.current),
+      );
+    }
+  }, []);
+
+  const scheduleFrame = useCallback(() => {
+    if (rafRef.current != null) return;
+    if (typeof window !== "undefined" && typeof window.requestAnimationFrame === "function") {
+      rafRef.current = window.requestAnimationFrame(flush);
+    } else {
+      // 无 rAF 的环境（老旧 jsdom / SSR 测试）：退化为 16ms 定时器，语义一致。
+      rafRef.current = setTimeout(flush, 16) as unknown as number;
+    }
+  }, [flush]);
+
+  /** 滚轮：非 passive 监听（React 的 onWheel 是 passive，preventDefault 会失效）。 */
+  useEffect(() => {
+    // 等宽模式为只读概览：不注册滚轮监听，让页面正常滚动（D-016）。
+    if (equalMode) return;
+    const element = sectionRef.current;
+    if (!element || typeof element.addEventListener !== "function") return;
+    const onWheel = (event: WheelEvent) => {
+      event.preventDefault();
+      // deltaMode: 0=像素 1=行 2=页。统一折算成「档」：一档 ≈ 100 像素。
+      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? 400 : 1;
+      const steps = Math.max(-3, Math.min(3, (event.deltaY * unit) / 100));
+      if (!Number.isFinite(steps) || steps === 0) return;
+      const previous = zoomPendingRef.current;
+      zoomPendingRef.current = {
+        steps: (previous?.steps ?? 0) + steps,
+        clientX: event.clientX,
+      };
+      scheduleFrame();
+    };
+    element.addEventListener("wheel", onWheel, { passive: false });
+    return () => element.removeEventListener("wheel", onWheel);
+  }, [scheduleFrame, equalMode]);
+
+  /* ───────────────────────── 位置换算（依赖 view） ───────────────────────── */
+
+  const fullSpan = Math.max(0, windowEnd - windowStart);
+  const currentSpan = viewSpan(view);
+  const zoomFactor = currentSpan > 0 && fullSpan > 0 ? fullSpan / currentSpan : 1;
+  const isFullView = view.start <= windowStart + 0.5 && view.end >= windowEnd - 0.5;
+
+  const placed = useMemo(() => {
+    // 等宽模式（D-016）：每条泳道内按出现顺序均分槽位，不参与时间换算。
+    if (equalMode) {
+      const placeLane = (items: TrajectorySpan[]): PlacedSpan[] => {
+        const count = Math.max(1, items.length);
+        const slot = 100 / count;
+        return items.map((item, index) => ({
+          span: item,
+          left: index * slot + slot * 0.08,
+          width: slot * 0.84,
+        }));
+      };
+      return {
+        span: 0,
+        input: placeLane(lanes.input),
+        model: placeLane(lanes.model),
+        tool: placeLane(lanes.tool),
+      };
+    }
+    const span = Math.max(1, viewSpan(view));
+    const pct = (at: number) => ((at - view.start) / span) * 100;
+    const place = (item: TrajectorySpan): PlacedSpan => {
+      const left = pct(item.start);
+      const right = pct(item.end);
+      return { span: item, left, width: Math.max(0, right - left) };
+    };
+    return {
+      span,
+      input: lanes.input.map(place),
+      model: lanes.model.map(place),
+      tool: lanes.tool.map(place),
+    };
+  }, [lanes, view, equalMode]);
+
+  /** 轮边界竖线（每轮 start 一条，画在条下面；等宽模式隐藏，D-016）。 */
+  const guides = useMemo(
+    () =>
+      equalMode
+        ? []
+        : turns.map((turn) => ({
+            key: turn.runId,
+            left: ratioAtTime(view, turn.startedAt) * 100,
+          })),
+    [turns, view, equalMode],
+  );
+
+  /** 轴刻度：按当前视野等距 7 档，两端落在视野边界；文案随视野重算（见 zoom.ts）。 */
+  const axisTicks = useMemo(() => {
+    if (equalMode) return [];
+    const span = viewSpan(view);
+    const total = Math.max(1, span);
+    return tickTimes(view.start, view.end, AXIS_TICK_COUNT).map((at, index) => ({
+      key: `tick-${index}`,
+      left: ((at - view.start) / total) * 100,
+      label: formatTickLabel(at, view, fullSpan),
+    }));
+  }, [view, fullSpan, equalMode]);
+
+  /** 总览刷子：整窗上的视野矩形（百分比）。 */
+  const brush = useMemo(() => {
+    const full = Math.max(1, fullWindowSpan(limits));
+    const left = ((view.start - limits.start) / full) * 100;
+    const width = (viewSpan(view) / full) * 100;
+    return {
+      left: Math.max(0, Math.min(100, left)),
+      width: Math.max(0, Math.min(100, width)),
+    };
+  }, [view, limits]);
+
+  const coveragePct = useMemo(() => {
+    const total = Math.max(1, coverage.windowMs);
+    const model = Math.round((coverage.modelMs / total) * 100);
+    const tool = Math.round((coverage.toolMs / total) * 100);
+    return { model, tool, gap: Math.max(0, 100 - model - tool) };
+  }, [coverage]);
+
+  /* ───────────────────────── 交互 ───────────────────────── */
+
+  const resetView = useCallback(() => {
+    dragRef.current = null;
+    brushDragRef.current = null;
+    panPendingRef.current = null;
+    brushPendingRef.current = null;
+    zoomPendingRef.current = null;
+    setView({ start: limitsRef.current.start, end: limitsRef.current.end });
+  }, []);
+
+  const selectAt = useCallback(
+    (laneKey: TrajectoryLaneKind, clientX: number, fallback: PlacedSpan | null) => {
+      const rect = trackRef.current?.getBoundingClientRect() ?? null;
+      let hit: PlacedSpan | null = null;
+      if (rect && rect.width > 0) {
+        const items =
+          laneKey === "input" ? placed.input : laneKey === "model" ? placed.model : placed.tool;
+        const bands: SpanBand<PlacedSpan>[] = items.map((item) => {
+          const leftPx = rect.left + (item.left / 100) * rect.width;
+          const rightPx = rect.left + ((item.left + item.width) / 100) * rect.width;
+          return { span: item, leftPx, rightPx: Math.max(rightPx, leftPx + MIN_BAR_PX) };
+        });
+        hit = pickSpanAt(bands, clientX, HIT_BAND_PX / 2);
+      }
+      const chosen = hit ?? fallback;
+      if (chosen) onSelectRow?.(chosen.span.rowId);
+    },
+    [onSelectRow, placed],
+  );
+
+  const handleLaneClick = useCallback(
+    (laneKey: TrajectoryLaneKind) => (event: ReactMouseEvent<HTMLDivElement>) => {
+      if (suppressClickRef.current) {
+        suppressClickRef.current = false;
+        return;
+      }
+      selectAt(laneKey, event.clientX, null);
+    },
+    [selectAt],
+  );
+
+  const handlePointerDown = useCallback(
+    (event: ReactPointerEvent<HTMLDivElement>) => {
+      // 等宽模式只读：不进入拖拽平移（D-016）。
+      if (equalMode) return;
+      if (event.button !== 0) return;
+      const target = event.target as HTMLElement | null;
+      // 条上按下 = 选中（不平移），把拖拽让给 click。
+      if (target?.closest('[data-testid="trajectory-bar"]')) return;
+      const rect = trackRef.current?.getBoundingClientRect() ?? null;
+      if (!rect || rect.width <= 0) return;
+      suppressClickRef.current = false;
+      // 注意：这里**不** setPointerCapture。捕获会把随后的 click 重定向到捕获元素，
+      // 泳道上的 onClick 就永远收不到——「点条外侧的 6px 命中带」会变成死区。
+      // 捕获推迟到「真的开始拖」（位移 ≥ 3px）时再做。
+      dragRef.current = {
+        pointerId: event.pointerId,
+        startX: event.clientX,
+        view: viewRef.current,
+        width: rect.width,
+        moved: false,
+        captured: false,
+      };
+    },
+    [equalMode],
+  );
+
+  const handlePointerMove = useCallback(
+    (event: ReactPointerEvent<HTMLDivElement>) => {
+      const drag = dragRef.current;
+      if (!drag) return;
+      const delta = event.clientX - drag.startX;
+      if (Math.abs(delta) >= DRAG_THRESHOLD_PX) drag.moved = true;
+      if (drag.moved && !drag.captured) {
+        const element = event.currentTarget;
+        if (typeof element.setPointerCapture === "function") {
+          try {
+            element.setPointerCapture(drag.pointerId);
+          } catch {
+            // 指针已失效：忽略，拖拽仍由普通 pointermove 驱动
+          }
+        }
+        drag.captured = true;
+      }
+      panPendingRef.current = delta;
+      scheduleFrame();
+    },
+    [scheduleFrame],
+  );
+
+  const endDrag = useCallback((event: ReactPointerEvent<HTMLDivElement>) => {
+    const drag = dragRef.current;
+    dragRef.current = null;
+    if (!drag) return;
+    if (drag.moved) suppressClickRef.current = true;
+    if (!drag.captured) return;
+    const element = event.currentTarget;
+    if (typeof element.releasePointerCapture === "function") {
+      try {
+        element.releasePointerCapture(drag.pointerId);
+      } catch {
+        // 指针已被系统释放：忽略
+      }
+    }
+  }, []);
+
+  const handleBrushPointerDown = useCallback(
+    (event: ReactPointerEvent<HTMLDivElement>) => {
+      if (event.button !== 0) return;
+      const element = overviewRef.current;
+      const rect = element?.getBoundingClientRect() ?? null;
+      if (!element || !rect || rect.width <= 0) return;
+      const limitsNow = limitsRef.current;
+      const full = Math.max(1, fullWindowSpan(limitsNow));
+      const pointerTime =
+        limitsNow.start + clamp01((event.clientX - rect.left) / rect.width) * full;
+      const current = viewRef.current;
+      const span = viewSpan(current) || full;
+      const brushLeftPx =
+        rect.left + ((current.start - limitsNow.start) / full) * rect.width;
+      const brushRightPx =
+        rect.left + ((current.end - limitsNow.start) / full) * rect.width;
+      const inside =
+        event.clientX >= brushLeftPx - 1 &&
+        event.clientX <= Math.max(brushRightPx, brushLeftPx + MIN_BAR_PX) + 1;
+      brushDragRef.current = {
+        pointerId: event.pointerId,
+        // 拖刷子保持「指针下的时刻」与刷子左端的相对偏移；点外面则以指针为中心。
+        grabOffsetMs: inside ? pointerTime - current.start : span / 2,
+        fullSpan: full,
+      };
+      if (typeof element.setPointerCapture === "function") {
+        element.setPointerCapture(event.pointerId);
+      }
+      brushPendingRef.current = pointerTime - brushDragRef.current.grabOffsetMs;
+      scheduleFrame();
+    },
+    [scheduleFrame],
+  );
+
+  const handleBrushPointerMove = useCallback(
+    (event: ReactPointerEvent<HTMLDivElement>) => {
+      const drag = brushDragRef.current;
+      if (!drag) return;
+      const rect = overviewRef.current?.getBoundingClientRect() ?? null;
+      if (!rect || rect.width <= 0) return;
+      const pointerTime =
+        limitsRef.current.start +
+        clamp01((event.clientX - rect.left) / rect.width) * drag.fullSpan;
+      brushPendingRef.current = pointerTime - drag.grabOffsetMs;
+      scheduleFrame();
+    },
+    [scheduleFrame],
+  );
+
+  const handleBrushPointerUp = useCallback((event: ReactPointerEvent<HTMLDivElement>) => {
+    const drag = brushDragRef.current;
+    brushDragRef.current = null;
+    if (!drag) return;
+    const element = event.currentTarget;
+    if (typeof element.releasePointerCapture === "function") {
+      try {
+        element.releasePointerCapture(drag.pointerId);
+      } catch {
+        // 指针已被系统释放：忽略
+      }
+    }
+  }, []);
+
+  const barTitle = (item: PlacedSpan): string =>
+    `${item.span.label} · ${formatDuration(item.span.end - item.span.start)}`;
+
+  return (
+    <section
+      ref={sectionRef}
+      aria-label="轨迹泳道时间轴"
+      data-testid="trajectory-timeline"
+      data-view-start={Math.round(view.start)}
+      data-view-end={Math.round(view.end)}
+      data-span-ms={Math.round(currentSpan)}
+      data-full-span-ms={Math.round(fullSpan)}
+      data-window-start={Math.round(windowStart)}
+      data-window-end={Math.round(windowEnd)}
+      onDoubleClick={equalMode ? undefined : resetView}
+      className={cn("shrink-0 border-b border-border bg-card pb-0.5 pt-0.5", className)}
+    >
+      {/* ── 说明行（D-017 裁剪：保留 DOM 供既有测试与无障碍文本，视觉隐藏） ── */}
+      <div className="hidden flex-wrap items-center gap-x-2 gap-y-0.5 px-3 text-[10.5px] leading-4">
+        <span className="font-semibold tracking-wide text-foreground">泳道时间轴</span>
+        <span
+          data-testid="trajectory-view-range"
+          className="font-mono tabular-nums text-muted-foreground"
+        >
+          {formatViewRangeLabel(view, windowStart, fullSpan)}
+        </span>
+        <span className="font-mono tabular-nums text-muted-foreground/70">
+          ×{zoomFactor < 1.05 ? "1.0" : zoomFactor.toFixed(1)}
+        </span>
+        <span className="flex items-center gap-2 text-muted-foreground">
+          {LANE_ROWS.map((lane) => (
+            <span key={lane.key} className="flex items-center gap-1">
+              <span aria-hidden className={cn("inline-block h-1.5 w-2.5 rounded-[1px]", lane.bar)} />
+              {lane.label}
+            </span>
+          ))}
+        </span>
+        <span
+          data-testid="trajectory-coverage"
+          className="font-mono tabular-nums text-muted-foreground"
+          title={`模型 ${formatDuration(coverage.modelMs)} · 工具 ${formatDuration(
+            coverage.toolMs,
+          )} · 整窗 ${formatDuration(coverage.windowMs)}（并集口径）`}
+        >
+          模型 {coveragePct.model}% · 工具 {coveragePct.tool}% · 空档 {coveragePct.gap}%
+        </span>
+        <span
+          data-testid="trajectory-model-basis"
+          data-basis={modelBasis}
+          title={
+            modelBasis === "observed"
+              ? "模型条按每次 attempt 的起止绘制（单色，TTFT 见条提示）"
+              : "无 TTFT / attempt 采样：模型条为整段非工具空档的近似"
+          }
+          className={cn(
+            "rounded border px-1 py-px text-[10px] leading-[13px]",
+            modelBasis === "observed"
+              ? "border-brand-400/60 bg-brand-500/10 text-brand-600 dark:text-brand-300"
+              : "border-border text-muted-foreground",
+          )}
+        >
+          {MODEL_BASIS_LABEL[modelBasis]}
+        </span>
+        <button
+          type="button"
+          data-testid="trajectory-reset"
+          onClick={resetView}
+          disabled={isFullView}
+          title="回到整窗（也可双击时间轴）"
+          className={cn(
+            "rounded border border-border px-1.5 py-px text-[10px] leading-[13px]",
+            isFullView
+              ? "cursor-default text-muted-foreground/50"
+              : "text-muted-foreground hover:bg-muted hover:text-foreground",
+          )}
+        >
+          重置
+        </button>
+        <span className="ml-auto text-muted-foreground">
+          {modelBasis === "observed"
+            ? "模型条按 attempt 起止绘制（单色，TTFT 见条提示）"
+            : "模型条为近似（非工具时段的思考/答复跨度）"}
+          · 竖线＝轮边界 · 共 {turns.length} 轮 · 滚轮缩放 / 拖拽平移 / 双击重置
+        </span>
+      </div>
+
+      {/* ── 轴（等宽模式不渲染，D-016） ───────────────────────────────────── */}
+      {!equalMode && (
+      <div className="flex items-end pl-3">
+        <span aria-hidden className="shrink-0" style={{ width: GUTTER_PX }} />
+        <div className="relative h-[12px] min-w-0 flex-1" data-testid="trajectory-axis">
+          {axisTicks.map((tick, index) => (
+            <span
+              key={tick.key}
+              data-testid="trajectory-axis-tick"
+              className="absolute top-0 whitespace-nowrap font-mono text-[9.5px] tabular-nums text-muted-foreground"
+              style={{
+                left: `${tick.left}%`,
+                transform:
+                  index === 0
+                    ? "none"
+                    : index === axisTicks.length - 1
+                      ? "translateX(-100%)"
+                      : "translateX(-50%)",
+              }}
+            >
+              {tick.label}
+            </span>
+          ))}
+        </div>
+      </div>
+      )}
+
+      {/* ── 三条泳道（共享同一根轴；拖拽平移 / 点击选行） ────────────────── */}
+      <div
+        className="relative touch-none pl-3"
+        onPointerDown={handlePointerDown}
+        onPointerMove={handlePointerMove}
+        onPointerUp={endDrag}
+        onPointerCancel={endDrag}
+        data-testid="trajectory-surface"
+      >
+        {/* 轮边界竖线：位于三条轨道之下，只覆盖轨道区（跳过 44px 标签栏）。 */}
+        <div
+          aria-hidden
+          className="pointer-events-none absolute inset-y-0 right-0"
+          style={{ left: GUTTER_PX + 12 }}
+        >
+          {guides.map((guide) => (
+            <span
+              key={guide.key}
+              data-testid="trajectory-turn-guide"
+              className="absolute inset-y-0 w-px bg-border/70"
+              style={{ left: `${guide.left}%` }}
+            />
+          ))}
+        </div>
+
+        {LANE_ROWS.map((lane) => {
+          const items =
+            lane.key === "input" ? placed.input : lane.key === "model" ? placed.model : placed.tool;
+          return (
+            <div
+              key={lane.key}
+              className="relative flex items-center"
+              style={{ height: LANE_HEIGHT_PX }}
+            >
+              <span
+                data-testid="trajectory-lane-label"
+                data-lane={lane.key}
+                title={`${lane.label}（${items.length} 条）`}
+                className="shrink-0 select-none text-[10px] leading-none text-muted-foreground"
+                style={{ width: GUTTER_PX }}
+              >
+                {lane.label}
+                <span className="ml-1 font-mono tabular-nums text-muted-foreground/70">
+                  {items.length}
+                </span>
+              </span>
+              <div
+                ref={lane.key === "input" ? trackRef : undefined}
+                className="relative h-full min-w-0 flex-1 cursor-grab overflow-hidden active:cursor-grabbing"
+                data-lane={lane.key}
+                data-testid="trajectory-lane"
+                onClick={handleLaneClick(lane.key)}
+              >
+                {items.length === 0 ? (
+                  <span
+                    aria-hidden
+                    className="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-border/60"
+                  />
+                ) : null}
+                {items.map((item) => {
+                  const selected = selectedRowId != null && selectedRowId === item.span.rowId;
+                  const title = barTitle(item);
+                  return (
+                    <button
+                      key={item.span.id}
+                      type="button"
+                      data-testid="trajectory-bar"
+                      data-lane={lane.key}
+                      data-row-id={item.span.rowId}
+                      data-start={item.span.start}
+                      data-end={item.span.end}
+                      title={title}
+                      aria-label={title}
+                      aria-pressed={selected}
+                      onClick={(event) => {
+                        // 条自己也有 click：jsdom 里直接派发到条上（无几何信息时回退自身），
+                        // 真实浏览器里再由 `selectAt` 按「中心最近」纠正到正确的那根。
+                        event.stopPropagation();
+                        if (suppressClickRef.current) {
+                          suppressClickRef.current = false;
+                          return;
+                        }
+                        selectAt(lane.key, event.clientX, item);
+                      }}
+                      className={cn(
+                        "absolute top-1/2 -translate-y-1/2 cursor-pointer rounded-[1px] outline-offset-0 transition-opacity",
+                        "hover:opacity-100 focus-visible:opacity-100",
+                        lane.bar,
+                        selected
+                          ? "z-[2] opacity-100 outline outline-2 outline-foreground"
+                          : "opacity-80",
+                      )}
+                      style={{
+                        left: `${item.left}%`,
+                        width: lane.key === "input" ? `${MIN_BAR_PX}px` : `${item.width}%`,
+                        minWidth: 2,
+                        height: BAR_HEIGHT_PX,
+                      }}
+                    />
+                  );
+                })}
+              </div>
+            </div>
+          );
+        })}
+      </div>
+
+      {/* ── 总览缩略条（D-017 裁剪：保留 DOM 与刷子逻辑，视觉隐藏） ──────── */}
+      <div className="hidden items-center pl-3 pt-0.5" style={{ height: 14 }}>
+        <span
+          aria-hidden
+          className="shrink-0 select-none pr-1 text-right font-mono text-[9px] leading-none text-muted-foreground/70"
+          style={{ width: GUTTER_PX }}
+        >
+          总览
+        </span>
+        <div
+          ref={overviewRef}
+          data-testid="trajectory-overview"
+          title="总览：拖动色块平移视野；点空白把视野中心移到指针"
+          className="relative min-w-0 flex-1 cursor-grab touch-none overflow-hidden rounded-[1px] bg-muted/40 active:cursor-grabbing"
+          style={{ height: OVERVIEW_HEIGHT_PX }}
+          onPointerDown={handleBrushPointerDown}
+          onPointerMove={handleBrushPointerMove}
+          onPointerUp={handleBrushPointerUp}
+          onPointerCancel={handleBrushPointerUp}
+        >
+          <span aria-hidden className="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-border" />
+          {turns.map((turn) => (
+            <span
+              key={turn.runId}
+              aria-hidden
+              className="absolute inset-y-0 w-px bg-border/50"
+              style={{
+                left: `${fullSpan > 0 ? clamp01((turn.startedAt - windowStart) / fullSpan) * 100 : 0}%`,
+              }}
+            />
+          ))}
+          <span
+            data-testid="trajectory-overview-brush"
+            className="absolute inset-y-0 rounded-[1px] border border-brand-500/70 bg-brand-500/25"
+            style={{
+              left: `${brush.left}%`,
+              width: `${brush.width}%`,
+              minWidth: MIN_BAR_PX,
+            }}
+          />
+        </div>
+      </div>
+    </section>
+  );
+}
diff --git a/frontend/src/components/daemon/trajectory/trajectory-view.tsx b/frontend/src/components/daemon/trajectory/trajectory-view.tsx
new file mode 100644
index 000000000..7e51feee9
--- /dev/null
+++ b/frontend/src/components/daemon/trajectory/trajectory-view.tsx
@@ -0,0 +1,177 @@
+"use client";
+
+/**
+ * 轨迹视图装配层（2026-10-22-trajectory-view-redesign / D-009 / D-012）。
+ *
+ * 布局（对齐 dsh ui-trajectory）：
+ *   工具栏（32px，固定）→ 时间线（约 50px，固定）→ 账本（唯一滚动区）+ 详情面板。
+ *
+ * 本文件只持有交互状态与组合子组件：
+ *   - 折叠集合（轮次 / 调用）与搜索词：实例内存状态，卸载即丢弃（R-03）；
+ *   - 选中行：受控-可选（传 `selectedRowId` 即受控，与 dev 预览页一致）；
+ *   - 时长模式：全局偏好，localStorage `sillyhub.trajectory.scaleMode`（D-020）。
+ *
+ * 纯数据推导在 trajectory-view-model.ts；渲染在 toolbar / ledger / detail-panel。
+ */
+
+import { useCallback, useEffect, useMemo, useState } from "react";
+
+import { cn } from "@/lib/utils";
+
+import type { Trajectory } from "./build-trajectory";
+import { TrajectoryDetailPanel } from "./trajectory-detail-panel";
+import { TrajectoryLedger } from "./trajectory-ledger";
+import { TrajectoryTimeline, type TrajectoryScaleMode } from "./trajectory-timeline";
+import { TrajectoryToolbar } from "./trajectory-toolbar";
+import {
+  buildLedgerView,
+  collectCollapsibleCallGroups,
+  visibleRecordIds,
+} from "./trajectory-view-model";
+
+const SCALE_MODE_KEY = "sillyhub.trajectory.scaleMode";
+
+function readScaleMode(): TrajectoryScaleMode {
+  if (typeof window === "undefined") return "duration";
+  try {
+    return window.localStorage.getItem(SCALE_MODE_KEY) === "equal" ? "equal" : "duration";
+  } catch {
+    return "duration";
+  }
+}
+
+function writeScaleMode(mode: TrajectoryScaleMode): void {
+  try {
+    window.localStorage.setItem(SCALE_MODE_KEY, mode);
+  } catch {
+    /* 隐私模式写入失败：静默 */
+  }
+}
+
+export interface TrajectoryViewProps {
+  trajectory: Trajectory;
+  selectedRowId?: string | null;
+  // eslint-disable-next-line no-unused-vars -- 接口回调签名形参
+  onSelectRow?: (rowId: string | null) => void;
+  className?: string;
+}
+
+export function TrajectoryView({
+  trajectory,
+  selectedRowId: selectedProp,
+  onSelectRow: onSelectProp,
+  className,
+}: TrajectoryViewProps) {
+  const controlled = selectedProp !== undefined;
+  const [internalSelected, setInternalSelected] = useState<string | null>(null);
+  const selectedRowId = controlled ? selectedProp : internalSelected;
+
+  const [collapsedTurns, setCollapsedTurns] = useState<Set<number>>(() => new Set());
+  const [collapsedCalls, setCollapsedCalls] = useState<Set<string>>(() => new Set());
+  const [query, setQuery] = useState("");
+  const [scaleMode, setScaleMode] = useState<TrajectoryScaleMode>(readScaleMode);
+
+  const setSelectedRow = useCallback(
+    (rowId: string | null) => {
+      if (onSelectProp) onSelectProp(rowId);
+      if (!controlled) setInternalSelected(rowId);
+    },
+    [controlled, onSelectProp],
+  );
+
+  const callGroups = useMemo(() => collectCollapsibleCallGroups(trajectory), [trajectory]);
+  const groups = useMemo(
+    () => buildLedgerView(trajectory, { collapsedTurns, collapsedCalls, query }),
+    [trajectory, collapsedTurns, collapsedCalls, query],
+  );
+  const visibleIds = useMemo(() => visibleRecordIds(groups), [groups]);
+
+  // D-014：折叠/搜索使选中行不可见时清空选中（详情随之关闭）。
+  useEffect(() => {
+    if (selectedRowId && !visibleIds.includes(selectedRowId)) {
+      setSelectedRow(null);
+    }
+  }, [selectedRowId, visibleIds, setSelectedRow]);
+
+  const turnIndexes = useMemo(
+    () => Array.from(new Set(trajectory.rows.map((row) => row.turnIndex))),
+    [trajectory.rows],
+  );
+
+  const allTurnsCollapsed =
+    turnIndexes.length > 0 && turnIndexes.every((index) => collapsedTurns.has(index));
+  const allCallsCollapsed =
+    callGroups.length > 0 && callGroups.every((group) => collapsedCalls.has(group.key));
+
+  const toggleAllTurns = useCallback(() => {
+    setCollapsedTurns(allTurnsCollapsed ? new Set() : new Set(turnIndexes));
+  }, [allTurnsCollapsed, turnIndexes]);
+
+  const toggleAllCalls = useCallback(() => {
+    setCollapsedCalls(
+      allCallsCollapsed ? new Set() : new Set(callGroups.map((group) => group.key)),
+    );
+  }, [allCallsCollapsed, callGroups]);
+
+  const expandTurn = useCallback((turnIndex: number) => {
+    setCollapsedTurns((previous) => {
+      const next = new Set(previous);
+      next.delete(turnIndex);
+      return next;
+    });
+  }, []);
+
+  const expandCalls = useCallback((key: string) => {
+    setCollapsedCalls((previous) => {
+      const next = new Set(previous);
+      next.delete(key);
+      return next;
+    });
+  }, []);
+
+  const changeScaleMode = useCallback((mode: TrajectoryScaleMode) => {
+    setScaleMode(mode);
+    writeScaleMode(mode);
+  }, []);
+
+  return (
+    <div
+      className={cn(
+        "@container flex h-full min-h-0 w-full min-w-0 flex-col overflow-hidden bg-background text-foreground",
+        className,
+      )}
+    >
+      <TrajectoryToolbar
+        query={query}
+        onQueryChange={setQuery}
+        scaleMode={scaleMode}
+        onScaleModeChange={changeScaleMode}
+        allTurnsCollapsed={allTurnsCollapsed}
+        onToggleAllTurns={toggleAllTurns}
+        allCallsCollapsed={allCallsCollapsed}
+        onToggleAllCalls={toggleAllCalls}
+      />
+      <TrajectoryTimeline
+        trajectory={trajectory}
+        selectedRowId={selectedRowId}
+        onSelectRow={setSelectedRow}
+        scaleMode={scaleMode}
+      />
+      <div className="relative flex min-h-0 flex-1">
+        <TrajectoryLedger
+          groups={groups}
+          selectedRowId={selectedRowId}
+          onSelectRow={setSelectedRow}
+          onExpandTurn={expandTurn}
+          onExpandCalls={expandCalls}
+          query={query}
+        />
+        <TrajectoryDetailPanel
+          trajectory={trajectory}
+          selectedRowId={selectedRowId}
+          onClose={() => setSelectedRow(null)}
+        />
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/daemon/trajectory/zoom.ts b/frontend/src/components/daemon/trajectory/zoom.ts
new file mode 100644
index 000000000..ccc121a67
--- /dev/null
+++ b/frontend/src/components/daemon/trajectory/zoom.ts
@@ -0,0 +1,272 @@
+/**
+ * 轨迹时间轴「视野」（view window）的纯函数 —— 滚轮缩放 / 拖拽平移 / 刻度推导。
+ *
+ * 为什么单独一个文件：这些数学是**可测的纯逻辑**（无 DOM、无 React、无时间源），
+ * 与渲染解耦后才能在 node 环境逐条断言（见 ./__tests__/zoom.test.ts）。
+ * `trajectory-timeline.tsx` 只负责把指针坐标换成 `ratio`，再把 `ratio` 交给这里。
+ *
+ * 坐标系约定（与渲染端一致）：
+ *   - `limits` = 整窗 `[windowStart, windowEnd]`，是缩放的**上界**也是平移的**边界**；
+ *   - `view`    = 当前视野 `[start, end]`，恒满足 `limits.start <= start < end <= limits.end`；
+ *   - 时间轴比值 `ratio = (at - view.start) / (view.end - view.start)`，渲染端
+ *     `left% = ratio * 100`。所有换算都只依赖这两个式子，没有第二套坐标。
+ *
+ * 钳制规则：
+ *   - 视野跨度 ∈ [`MIN_VIEW_SPAN_MS`, 整窗跨度]；整窗本身短于 1 分钟时下界退化为整窗
+ *     （不允许缩放到比数据还宽）。
+ *   - 缩放围绕**指针时间锚点**：锚点在视野内的比例保持不变，因此放大时指针下的
+ *     那一刻仍停在指针下（边界处因钳制会滑动，这是预期）。
+ *   - 平移只挪起点，跨度不变；越界钳到 `[limits.start, limits.end - span]`。
+ */
+
+/** 视野（epoch ms，左闭右开语义但按闭区间渲染）。 */
+export interface ViewWindow {
+  start: number;
+  end: number;
+}
+
+/** 可缩放/平移的整窗边界（= `trajectory.windowStart/windowEnd`）。 */
+export interface ViewLimits {
+  start: number;
+  end: number;
+}
+
+/** 最近可缩放到 1 分钟；更窄的视野在 856 行的真实数据上没有可读性。 */
+export const MIN_VIEW_SPAN_MS = 60_000;
+
+/** 每档滚轮的缩放倍率：>1 表示「一档放大 1.15 倍」。 */
+export const ZOOM_STEP = 1.15;
+
+/** 命中带宽度（px）：条本身可能只有 2px，点击目标按 6px 计。 */
+export const HIT_BAND_PX = 6;
+
+function clamp(value: number, low: number, high: number): number {
+  if (!Number.isFinite(value)) return low;
+  if (value < low) return low;
+  if (value > high) return high;
+  return value;
+}
+
+function clamp01(value: number): number {
+  return clamp(value, 0, 1);
+}
+
+/** 视野跨度（ms，≥0）。 */
+export function viewSpan(view: ViewWindow): number {
+  const span = view.end - view.start;
+  return Number.isFinite(span) && span > 0 ? span : 0;
+}
+
+/** 整窗跨度（ms，≥0）。 */
+export function fullWindowSpan(limits: ViewLimits): number {
+  const span = limits.end - limits.start;
+  return Number.isFinite(span) && span > 0 ? span : 0;
+}
+
+/** 视野可用的跨度区间 `[min, max]`；整窗退化时两者相等。 */
+export function viewSpanBounds(
+  limits: ViewLimits,
+  minSpan: number = MIN_VIEW_SPAN_MS,
+): { min: number; max: number } {
+  const max = fullWindowSpan(limits);
+  const min = Math.min(Math.max(1, minSpan), Math.max(1, max));
+  return { min, max: Math.max(min, max) };
+}
+
+/**
+ * 把任意视野夹紧到 `limits` 与跨度区间内（不缩放、不平移，只修正非法值）。
+ * 空/非法视野按整窗处理。
+ */
+export function clampView(
+  view: ViewWindow,
+  limits: ViewLimits,
+  minSpan: number = MIN_VIEW_SPAN_MS,
+): ViewWindow {
+  const max = fullWindowSpan(limits);
+  if (max <= 0) return { start: limits.start, end: limits.start };
+  const bounds = viewSpanBounds(limits, minSpan);
+  const span = clamp(viewSpan(view) || max, bounds.min, bounds.max);
+  const start = clamp(view.start, limits.start, limits.end - span);
+  return { start, end: start + span };
+}
+
+/**
+ * 围绕 `anchorTime` 缩放：`factor > 1` 放大（跨度变小），`factor < 1` 缩小。
+ * 锚点在视野里的比例在缩放前后保持一致（被钳制时才滑动）。
+ */
+export function zoomAt(
+  view: ViewWindow,
+  anchorTime: number,
+  factor: number,
+  limits: ViewLimits,
+  minSpan: number = MIN_VIEW_SPAN_MS,
+): ViewWindow {
+  const max = fullWindowSpan(limits);
+  if (max <= 0) return { start: limits.start, end: limits.start };
+  const bounds = viewSpanBounds(limits, minSpan);
+  const span = clamp(viewSpan(view) || bounds.max, bounds.min, bounds.max);
+  const safeFactor = Number.isFinite(factor) && factor > 0 ? factor : 1;
+  const nextSpan = clamp(span / safeFactor, bounds.min, bounds.max);
+  const ratio = span > 0 ? clamp01((anchorTime - view.start) / span) : 0.5;
+  const anchor = Number.isFinite(anchorTime) ? anchorTime : view.start + span * ratio;
+  const nextStart = anchor - ratio * nextSpan;
+  return clampView({ start: nextStart, end: nextStart + nextSpan }, limits, minSpan);
+}
+
+/**
+ * 平移视图：正 delta 向未来（右）移，负值向过去（左）移；跨度不变。
+ * 越界只把起点钳到边界，不改变跨度。
+ */
+export function panView(
+  view: ViewWindow,
+  deltaMs: number,
+  limits: ViewLimits,
+  minSpan: number = MIN_VIEW_SPAN_MS,
+): ViewWindow {
+  const max = fullWindowSpan(limits);
+  if (max <= 0) return { start: limits.start, end: limits.start };
+  const bounds = viewSpanBounds(limits, minSpan);
+  const span = clamp(viewSpan(view) || bounds.max, bounds.min, bounds.max);
+  const delta = Number.isFinite(deltaMs) ? deltaMs : 0;
+  const start = clamp(view.start + delta, limits.start, limits.end - span);
+  return { start, end: start + span };
+}
+
+/** `ratio`（0–1）→ 绝对时间。 */
+export function timeAtRatio(view: ViewWindow, ratio: number): number {
+  return view.start + clamp01(ratio) * viewSpan(view);
+}
+
+/** 绝对时间 → `ratio`（0–1，视野外夹到边界）。 */
+export function ratioAtTime(view: ViewWindow, at: number): number {
+  const span = viewSpan(view);
+  if (span <= 0) return 0;
+  return clamp01((at - view.start) / span);
+}
+
+/**
+ * 等距刻度时刻：`count` 个点（含两端），首个 = `viewStart`、末个 = `viewEnd`。
+ * 视野退化（span ≤ 0）时返回 `count` 个相同的时刻。
+ *
+ * 拼写说明：规格把它写作 `tickTicks`，此处以 `tickTimes` 为主名（语义更准），
+ * 末尾保留 `tickTicks` 别名以免调用面漂移。
+ */
+export function tickTimes(viewStart: number, viewEnd: number, count: number): number[] {
+  const total = Math.max(2, Math.trunc(Number.isFinite(count) ? count : 2));
+  const span = viewEnd - viewStart;
+  if (!(span > 0)) {
+    return Array.from({ length: total }, () => viewStart);
+  }
+  return Array.from({ length: total }, (_, index) => viewStart + (span * index) / (total - 1));
+}
+
+/** 规格拼写别名（见上）。 */
+export const tickTicks = tickTimes;
+
+/** 刻度对象：时刻 + 在视野里的比例（渲染端直接 `ratio * 100` 当 left%）。 */
+export function axisTicks(
+  viewStart: number,
+  viewEnd: number,
+  count: number,
+): Array<{ at: number; ratio: number }> {
+  const span = viewEnd - viewStart;
+  return tickTimes(viewStart, viewEnd, count).map((at) => ({
+    at,
+    ratio: span > 0 ? clamp01((at - viewStart) / span) : 0,
+  }));
+}
+
+/** 已换算成像素区间的条（命中判定用）。 */
+export interface SpanBand<T> {
+  span: T;
+  /** 条左边缘（px，可为负 = 视野外）。 */
+  leftPx: number;
+  /** 条右边缘（px）；与 leftPx 相等表示零宽事件。 */
+  rightPx: number;
+}
+
+/**
+ * 命中判定：在指针 `x` 处挑一根条。
+ *
+ * 规则（与「2px 条也可点」+「重叠时取中心最近」两条要求对应）：
+ *   1. 候选 = 渲染区间按 `tolerancePx`（默认 3px，即 6px 命中带）向外扩后覆盖 `x` 的条；
+ *   2. 先取**真正压在指针下**的候选（宽条整段可点），其中中心离 `x` 最近者胜；
+ *   3. 没有压住的，再取扩展带内的候选，同样中心最近者胜；
+ *   4. 都没有 → null（点空白不选中）。
+ *
+ * 复杂度 O(n) 且只在点击/按下时跑一次（415 根 tool 条也就几微秒），
+ * 因此不需要为每根条生成 6px 的隐藏兄弟节点。
+ */
+export function pickSpanAt<T>(
+  bands: SpanBand<T>[],
+  x: number,
+  tolerancePx: number = HIT_BAND_PX / 2,
+): T | null {
+  const tolerance = Math.max(0, Number.isFinite(tolerancePx) ? tolerancePx : 0);
+  let inside: { item: T; distance: number } | null = null;
+  let near: { item: T; distance: number } | null = null;
+
+  for (const band of bands) {
+    const low = Math.min(band.leftPx, band.rightPx);
+    const high = Math.max(band.leftPx, band.rightPx);
+    if (x < low - tolerance || x > high + tolerance) continue;
+    const distance = Math.abs((low + high) / 2 - x);
+    if (x >= low && x <= high) {
+      if (!inside || distance < inside.distance) inside = { item: band.span, distance };
+    } else if (!near || distance < near.distance) {
+      near = { item: band.span, distance };
+    }
+  }
+
+  return (inside ?? near)?.item ?? null;
+}
+
+/* ───────────────────────── 刻度 / 范围文案 ─────────────────────────
+ *
+ * 这两条文案规则必须**跟着视野走**，否则缩放后会出现两种错：
+ *   1. 只用 `at - windowStart` 再夹到「视野跨度」里 → 缩放后每个刻度都被夹到
+ *      同一个上限，7 个刻度全显示同一个时刻（曾在 2 小时视野下复现：全 "13:29"）；
+ *   2. 窄视野仍用 `HH:MM` → 7 个刻度落进同一分钟，同样看起来全一样。
+ * 因此：整窗 ≥1h 用钟点（视野 <10 分钟自动补秒），短会话用相对**视野起点**的
+ * `+mm:ss`；偏移量永不夹到视野跨度里（`time → label` 是纯单调映射）。
+ */
+
+const HOUR_MS = 60 * 60 * 1000;
+/** 视野窄于 10 分钟时，`HH:MM` 会让多个刻度撞在同一分钟 → 补秒。 */
+const SECONDS_PRECISION_BELOW_MS = 10 * 60 * 1000;
+
+function pad2(value: number): string {
+  return String(Math.max(0, Math.trunc(value))).padStart(2, "0");
+}
+
+/** 本地时区的 `HH:MM`（`withSeconds` 时 `HH:MM:SS`）。 */
+export function clockLabel(at: number, withSeconds = false): string {
+  const date = new Date(at);
+  const base = `${pad2(date.getHours())}:${pad2(date.getMinutes())}`;
+  return withSeconds ? `${base}:${pad2(date.getSeconds())}` : base;
+}
+
+/** 相对 `origin` 的 `+mm:ss`（≥1 小时时分钟位自然溢出成 `+264:40` 这种形态）。 */
+export function offsetLabel(at: number, origin: number): string {
+  const totalSeconds = Math.max(0, Math.round((at - origin) / 1000));
+  return `+${pad2(Math.floor(totalSeconds / 60))}:${pad2(totalSeconds % 60)}`;
+}
+
+/** 轴刻度文案（见上方规则）。 */
+export function formatTickLabel(at: number, view: ViewWindow, fullSpanMs: number): string {
+  if (fullSpanMs >= HOUR_MS) return clockLabel(at, viewSpan(view) < SECONDS_PRECISION_BELOW_MS);
+  return offsetLabel(at, view.start);
+}
+
+/** hint 行的「当前视野范围」文案（同一套钟点/偏移规则）。 */
+export function formatViewRangeLabel(
+  view: ViewWindow,
+  windowStart: number,
+  fullSpanMs: number,
+): string {
+  if (fullSpanMs >= HOUR_MS) {
+    const withSeconds = viewSpan(view) < SECONDS_PRECISION_BELOW_MS;
+    return `${clockLabel(view.start, withSeconds)} – ${clockLabel(view.end, withSeconds)}`;
+  }
+  return `${offsetLabel(view.start, windowStart)} – ${offsetLabel(view.end, windowStart)}`;
+}
