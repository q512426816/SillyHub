+describe('2026-10-21-daemon-zombie-turn FR-02：interrupt no-op 回传', () => {
+  let daemons: Daemon[] = [];
+
+  afterEach(async () => {
+    for (const d of daemons) {
+      await (d as unknown as { stop(): Promise<void> | void }).stop?.();
+    }
+    daemons = [];
+    vi.restoreAllMocks();
