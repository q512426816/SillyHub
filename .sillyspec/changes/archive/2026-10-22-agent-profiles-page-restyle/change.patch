+                        "session_id": str(row.agent_session_id),
+                        "run_id": str(row.id),
+                        "status": "failed",
+                        "exit_code": row.exit_code,
+                        "error_code": INTERACTIVE_TURN_NOT_STARTED_ERROR_CODE,
+                        "input_tokens": row.input_tokens,
