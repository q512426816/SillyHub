+/* ── 3. E4 上报：capability 语义 + 覆盖写 + reporter 容错 ─────────────────── */
+
+describe('session-manager × turn-file-changes：上报出口', () => {
+  it('unavailable 快照也上报（不静默丢弃 → backend 才能给 tool_only 降级）', async () => {
