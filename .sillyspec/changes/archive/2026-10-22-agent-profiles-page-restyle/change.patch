+    await sm.inject('sess-1', 'hello', 'run-old');
+    // 模拟误报形态：布防轮已不是当前轮（新 inject 已切换 currentRunId）
+    state.currentRunId = 'run-new';
+    await vi.advanceTimersByTimeAsync(90_000);
+
+    expect(onTurnStartTimeout).not.toHaveBeenCalled();
+    // 状态不被误动（新轮语义保留）
