+    侧表行存在但快照字段为 NULL（老 daemon 只上报 tool_only / 异常降级）与
+    无行等价——一律 ``"tool_only"``，前端据此走降级卡，不看字段是否存在。
+    """
+    if snapshot is None or snapshot.capability != "full" or snapshot.file_changes is None:
+        return "tool_only"
+    return "full"
