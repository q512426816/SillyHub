+    await expect(
+      routeControl(built.daemon, MSG.SESSION_INTERRUPT, {
+        session_id: 'sess-1',
+        lease_id: 'lease-1',
+        runtime_id: 'runtime-uuid-123',
+        run_id: 'run-zombie',
