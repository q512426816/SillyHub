+class AgentGroupConsensusTask(BaseModel, table=True):
+    """群聊汇总收口任务（2026-09-10-group-agent-direct-chat design §5.2，D-008）。
+
+    一行 = 一条触发消息的汇总任务（状态机唯一状态源，崩溃可恢复）：
+    carrier_run_id UNIQUE 防同消息重复建任务；members JSONB 存被咨询成员
