+
+def _member_stub(name: str, member_id: uuid.UUID | None = None) -> AgentGroupMember:
+    return AgentGroupMember(
+        id=member_id or uuid.uuid4(),
+        group_id=uuid.uuid4(),
+        member_type="agent",
+        display_name=name,
+        joined_at=datetime.now(UTC),
+    )
