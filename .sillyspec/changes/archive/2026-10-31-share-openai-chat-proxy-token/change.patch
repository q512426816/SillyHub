+    raw = base64.urlsafe_b64decode(payload_b64 + "=" * (-len(payload_b64) % 4))
+    payload = json.loads(raw)
+    payload["o"] = str(uuid.uuid4())  # 换属主：签名不再匹配
+    forged = base64.urlsafe_b64encode(json.dumps(payload).encode()).decode().rstrip("=")
