+async def _create_grantee(
+    db_session: AsyncSession, *, label: str = "g"
+) -> tuple[uuid.UUID, dict[str, str], str]:
+    """建被共享方用户并签发 Bearer（复刻 conftest.auth_admin_token 范式）。
