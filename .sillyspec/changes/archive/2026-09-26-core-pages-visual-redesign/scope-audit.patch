+          {titleExtra}
+        </div>
+        {actions ? (
+          <div className="flex flex-shrink-0 items-center gap-2">{actions}</div>
+        ) : null}
+      </div>
+      {subtitle ? (
+        <div className="text-xs leading-5 text-muted-foreground">{subtitle}</div>
+      ) : null}
+    </div>
+  );
+}
