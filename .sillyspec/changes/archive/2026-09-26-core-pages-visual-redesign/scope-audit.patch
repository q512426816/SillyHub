+        <nav className="text-xs text-muted-foreground" aria-label="面包屑">
+          {breadcrumb}
+        </nav>
+      ) : null}
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex min-w-0 flex-wrap items-center gap-2.5">
