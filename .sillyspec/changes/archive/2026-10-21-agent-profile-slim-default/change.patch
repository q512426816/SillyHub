+from app.modules.daemon.model import DaemonRuntime
+from app.modules.workspace.model import Workspace
+
+
+async def _mk_user(session: AsyncSession, label: str) -> User:
+    u = User(
+        id=uuid.uuid4(),
+        email=f"gdp-{label}-{uuid.uuid4()}@example.com",
+        password_hash="x",
+        status="active",
+    )
+    session.add(u)
+    await session.flush()
+    return u
+
+
+async def _mk_ws(session: AsyncSession, owner: User) -> Workspace:
+    ws = Workspace(
+        id=uuid.uuid4(),
+        name="群默认档案工作区",
+        slug=f"gdp-{uuid.uuid4().hex[:8]}",
+        created_by=owner.id,
+        root_path="C:/gdp-root",
+        status="active",
+    )
+    session.add(ws)
+    await session.flush()
+    return ws
+
+
+async def _mk_group_and_member(
+    session: AsyncSession,
+    owner: User,
+    ws: Workspace,
+    *,
+    with_profile: bool,
+) -> tuple:
+    from app.modules.agent.model import AgentGroupChat, AgentGroupMember
+
+    rt = DaemonRuntime(
+        id=uuid.uuid4(),
+        user_id=owner.id,
+        name="Claude Code",
+        provider="claude",
+        status="online",
+        last_heartbeat_at=datetime.now(UTC),
+    )
+    session.add(rt)
+    group = AgentGroupChat(
+        id=uuid.uuid4(),
+        # 群时间线会话 1:1 载体 id（test_group_consensus 同范式，不建真实会话行）。
+        session_id=uuid.uuid4(),
+        title="默认档案群",
+        workspace_id=ws.id,
+        project_id=None,
+        created_by=owner.id,
+        created_at=datetime.now(UTC),
+    )
+    session.add(group)
+    member = AgentGroupMember(
+        id=uuid.uuid4(),
+        group_id=group.id,
+        member_type="agent",
+        display_name="小码",
+        runtime_id=rt.id,
+        workspace_id=ws.id,
