+ */
+export function diffRowsToText(rows: readonly DiffRow[]): string {
+  const lines: string[] = [];
+  for (const row of rows) {
+    if (row.type === "ctx" && row.oldNo == null && row.newNo == null) continue;
+    const prefix = row.type === "del" ? "-" : row.type === "add" ? "+" : " ";
+    lines.push(prefix + row.text);
+  }
+  return lines.join("\n");
+}
