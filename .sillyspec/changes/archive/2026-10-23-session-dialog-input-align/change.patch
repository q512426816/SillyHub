+  baseRows: AgentRunLogEntry[],
+): AgentRunLogEntry[] {
+  const seen = new Set(full.map((l) => l.id));
+  const tail = baseRows.filter((l) => !seen.has(l.id));
+  return tail.length > 0 ? [...full, ...tail] : full;
