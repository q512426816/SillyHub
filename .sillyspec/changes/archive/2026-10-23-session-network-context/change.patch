+    const fullR1 = makeLogs("r1", "e1", 5000, 999);
+    const fetchRunLogs = vi.fn(async (runId: string) => {
+      if (runId === "r2") return fullR2;
+      return fullR1;
+    });
+
+    // 预算压到刚好容不下 r1：fullR2=500 + 999 > 1400。
+    const result = await buildInitialWindow({
