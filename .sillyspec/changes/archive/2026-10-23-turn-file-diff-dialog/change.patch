+      rerender(<TurnLiveMarquee entries={deriveLiveMarqueeEntries(segs2)} />);
+      expect(rafCallbacks.length).toBeGreaterThanOrEqual(1);
+    } finally {
+      rafSpy.mockRestore();
+    }
+  });
