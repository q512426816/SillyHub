+def test_proxy_embed_timeout_sec_tight_budget(silent_worker_path: Path):
+    """embed(timeout_sec=) 紧预算（2026-11-05-knowledge-vector-async-refresh FR-04）：
+    worker 挂起（读请求永不响应）时按传入限时抛 EmbeddingSubprocessError 并杀子进程，
+    不拖满 300s 缺省批预算。"""
+    proxy = EmbeddingSubprocessProxy("fake-model", worker_cmd=_cmd(silent_worker_path))
+    try:
+        t0 = time.monotonic()
+        with pytest.raises(EmbeddingSubprocessError):
+            proxy.embed(["q"], timeout_sec=0.5)
+        elapsed = time.monotonic() - t0
+        assert elapsed < 5.0, f"按传入限时放弃（实际 {elapsed:.2f}s——用了 300s 缺省？）"
+        # 缺省路契约不回归：不传 timeout_sec 仍是 REQUEST_TIMEOUT_SEC 批预算
+        assert EmbeddingSubprocessProxy.REQUEST_TIMEOUT_SEC == 300.0
+    finally:
+        proxy.close()
+
+
+def test_proxy_embed_lock_contention_respects_timeout(fake_worker_path: Path):
+    """锁排队计入预算（评审 P3 清偿）：锁被他方持有时 embed(timeout_sec=) 按预算
+    放弃（EmbeddingSubprocessError lock busy）——紧预算必须覆盖锁等待，否则查询路
+    可被持锁语料批（批预算 300s）变相拖满。"""
+    proxy = EmbeddingSubprocessProxy("fake-model", worker_cmd=_cmd(fake_worker_path))
+    try:
+        assert proxy._lock.acquire(timeout=1.0), "测试预取锁（模拟并发语料批持锁）"
+        t0 = time.monotonic()
+        with pytest.raises(EmbeddingSubprocessError, match="lock busy"):
+            proxy.embed(["q"], timeout_sec=0.3)
+        elapsed = time.monotonic() - t0
+        assert elapsed < 5.0, f"按传入限时放弃锁等待（实际 {elapsed:.2f}s）"
+        assert proxy.consecutive_crashes == 0, "锁放弃不是崩溃（不计崩溃退避）"
+    finally:
+        proxy._lock.release()
+        proxy.close()
+
+
