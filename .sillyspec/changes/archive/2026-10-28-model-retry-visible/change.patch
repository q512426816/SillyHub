+  it('2026-10-28-model-retry-visible：api_retry 连接类（error_status=null）保留 null、缺字段不伪造、error 对象截断', () => {
+    const norm = makeNormalizer([]);
+    // 连接类重试：error_status=null（无 HTTP 响应），null 必须原样保留。
+    const connRetry = {
+      type: 'system',
+      subtype: 'api_retry',
+      attempt: 1,
+      max_retries: 10,
