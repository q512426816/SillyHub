+                    KnowledgeHit.change_name == change_key,
+                    KnowledgeHit.type == "inject",
+                )
+                .order_by(KnowledgeHit.occurred_at)
+            )
+        )
+        .scalars()
+        .all()
+    )
+    seen: set[tuple[str, str]] = set()
+    out: list[tuple[str, str, str]] = []
+    for anchors in rows:
