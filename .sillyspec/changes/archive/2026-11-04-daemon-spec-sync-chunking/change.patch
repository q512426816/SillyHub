+    const client = makeClient({ postSpecSyncIncremental: incrSpy, postSpecSync: postSpy });
+
+    await expect(postSpecSync(client, wsId, scratch)).rejects.toThrow(
+      /ECONNRESET: simulated mid-push network drop/,
+    );
