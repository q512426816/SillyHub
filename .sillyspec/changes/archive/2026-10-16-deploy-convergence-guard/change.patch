+DEPLOY_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
+DEPLOY_COMMIT="$(git rev-parse --short HEAD)"
+echo "    打包源: 分支 $DEPLOY_BRANCH @ $DEPLOY_COMMIT"
+if [ "$DEPLOY_BRANCH" != "main" ]; then
