+
+  it("用量七项压缩行与用量卡同源（耗时/轮次/输入/输出/缓存读取/请求次数/命中率）", async () => {
+    renderSide();
+    expect(await screen.findByText("耗时")).toBeInTheDocument();
+    for (const label of ["轮次", "输入", "输出", "缓存读取", "请求次数", "缓存命中率"]) {
+      expect(screen.getByText(label)).toBeInTheDocument();
