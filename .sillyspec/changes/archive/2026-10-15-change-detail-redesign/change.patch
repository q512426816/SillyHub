+}));
+
+const mockAssets = vi.mocked(getChangeAssets);
+const mockUsage = vi.mocked(getChangeUsage);
+const mockAudit = vi.mocked(getScopeAudit);
+
+const CHANGE = {
+  id: "c-1",
+  workspace_id: "ws-1",
+  change_key: "2026-10-15-demo",
