+ * 首屏按变更状态适配（D-001）：
+ * - 在途：待办卡（仅当前有待办时渲染，语义由 `ChangeStageActions` 既有分支承担）→ 变更摘要
+ *   四格（当前阶段 / 任务进度 / 已用时长 / 最后信号）→ 最近动态（统一时间线尾部 5 条，**倒序**、
+ *   轻量行、**不带**阶段筛选 chips 与合并口径说明——那两者只属「过程」tab）；
+ * - 归档：成果总结四格（需求 / 决策 / 改动文件 / 净增行）+ 归档留档摘要（统计行 + 指路产出 tab）
+ *   + 最终动态（倒序轻量行）。归档态 MUST NOT 出现执行中类文案，在途态 MUST NOT 出现归档空位。
+ *
+ * 右信息栏见 `change-overview-side.tsx`（两栏在 lg 以下堆叠）。
+ *
+ * 取数：本面板**不新增端点**——资产统计复用 `["changeAssets", …]` 既有 queryKey（同 key 命中
+ * react-query 缓存，与产出面板/信息栏单一数据源）。最近动态数据由调用方注入（`recentRows`）。
+ */
+import { useQuery } from "@tanstack/react-query";
+
+import { StatGrid, StateIcon } from "@/components/primer";
+import {
+  ChangeLastSignal,
+  lastSignalFromSteps,
+} from "@/components/changes/change-activity-badge";
+import { WORKFLOW_STAGE_LABELS } from "@/components/changes/detail/change-stage-header";
+import { ChangeStageActions } from "@/components/changes/detail/change-stage-actions";
+import { formatDurationZh, useChangeUsage } from "@/components/changes/detail/change-usage-card";
+import { ChangeOverviewSide } from "@/components/changes/detail/change-overview-side";
+import { getChangeAssets, type ChangeRead } from "@/lib/changes";
+import type { AgentSessionListItem } from "@/lib/daemon";
+import type { UnifiedRow } from "@/components/changes/detail/merge-change-timeline";
+
+/** 最近动态展示条数（轻量预览；全量在「过程」tab）。 */
+const RECENT_LIMIT = 5;
+
+/** 时间显示：本地 MM-DD HH:mm（不可解析保留原文）。 */
+function shortTime(at: string | null): string {
+  if (!at) return "—";
+  const ms = Date.parse(at);
+  if (Number.isNaN(ms)) return at;
+  const d = new Date(ms);
+  const p = (n: number) => String(n).padStart(2, "0");
+  return `${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
+}
+
+function RecentRows({ rows }: { rows: UnifiedRow[] }) {
+  return (
+    <div className="flex flex-col">
+      {rows.map((row) => (
+        <div
+          key={row.key}
+          data-testid="change-overview-recent-row"
+          className="flex items-center gap-2 border-b border-dashed py-1.5 last:border-b-0"
+        >
+          {row.tone === "success" ? (
+            <StateIcon name="check" size={14} className="text-success" />
+          ) : row.tone === "current" ? (
+            <StateIcon name="openCircle" size={14} className="text-brand-600" />
+          ) : row.tone === "warning" ? (
+            <StateIcon name="zap" size={14} className="text-amber-600" />
+          ) : (
+            <StateIcon name="clock" size={14} className="text-muted-foreground" />
+          )}
+          <span className="min-w-0 flex-1 truncate text-xs" title={row.title}>
+            {row.title}
+          </span>
+          {row.stage ? (
+            <span
+              className="shrink-0 rounded-full border px-2 py-px text-[11px] text-muted-foreground"
+              style={{ borderColor: "hsl(var(--border))" }}
+            >
+              {WORKFLOW_STAGE_LABELS[row.stage] ?? row.stage}
+            </span>
+          ) : null}
+          <span className="shrink-0 text-[11px] text-muted-foreground">{shortTime(row.at)}</span>
+        </div>
+      ))}
+    </div>
+  );
+}
+
+export interface OverviewPanelProps {
+  change: ChangeRead;
+  workspaceId: string;
+  changeId: string;
+  archived: boolean;
+  /** 统一时间线合并结果（由调用方注入；本面板只取尾部若干条并倒序）。 */
+  recentRows: UnifiedRow[];
+  /** 任务进度（tasks[] 勾选比；与「过程」tab 的任务清单同源）。 */
+  taskSummary: { checked: number; total: number };
+  /** 工作区最近会话（信息栏显示最近 3 条）。 */
+  sessions: AgentSessionListItem[];
+  /** 待办卡透传（语义与分支全在 `ChangeStageActions` 内，本面板不做判断）。 */
+  boundSession: AgentSessionListItem | null;
+  gateComment: string;
+  onGateCommentChange: (_v: string) => void;
+  onGateAction: (_action: string) => void;
+  transitioning: boolean;
+  notifyResult: { notified_session: boolean; notify_error: string | null } | null;
+}
+
+export function ChangeOverviewPanel({
+  change,
+  workspaceId,
+  changeId,
+  archived,
+  recentRows,
+  taskSummary,
+  sessions,
+  boundSession,
+  gateComment,
+  onGateCommentChange,
+  onGateAction,
+  transitioning,
+  notifyResult,
+}: OverviewPanelProps) {
+  // 资产统计（复用产出面板/信息栏同一 queryKey；零额外请求）。
+  const assetsQ = useQuery({
+    queryKey: ["changeAssets", workspaceId, changeId],
+    queryFn: () => getChangeAssets(workspaceId, changeId),
+    retry: false,
+    refetchOnWindowFocus: false,
+  });
+  const assets = assetsQ.data;
+  // 用量（与信息栏/用量卡同一 hook 与 queryKey：零额外请求）。
+  const usageQ = useChangeUsage("change", workspaceId, changeId);
+  const usage = usageQ.data;
+  const durationText =
+    usage?.duration_ms == null
+      ? "—"
+      : `${formatDurationZh(usage.duration_ms)}${
+          usage.started_at != null && usage.finished_at == null ? "（进行中）" : ""
+        }`;
+
+  const recent = [...recentRows].reverse().slice(0, RECENT_LIMIT);
+  const lastSignal = lastSignalFromSteps(change.steps);
+
+  const inflightItems = [
+    {
+      label: "当前阶段",
+      value: change.current_stage
+        ? (WORKFLOW_STAGE_LABELS[change.current_stage] ?? change.current_stage)
+        : "—",
+      tone: "brand" as const,
+    },
+    {
+      label: "任务进度",
+      value: taskSummary.total === 0 ? "—" : `${taskSummary.checked} / ${taskSummary.total}`,
+    },
+    {
+      label: "已用时长",
+      value: durationText,
+    },
+    {
+      label: "最后信号",
+      value: lastSignal ? shortTime(lastSignal) : "—",
+    },
+  ];
+
+  const archivedItems = [
+    { label: "需求规则", value: String(assets?.fr_entries?.length ?? 0), tone: "brand" as const },
+    { label: "决策蒸馏", value: String(assets?.decisions?.length ?? 0) },
+    { label: "改动文件", value: assets?.patch?.files != null ? String(assets.patch.files) : "—" },
+    {
+      label: "净增行",
+      value: assets?.patch
+        ? `+${assets.patch.additions ?? 0} / −${assets.patch.deletions ?? 0}`
+        : "—",
+    },
+  ];
+
+  return (
+    <div className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_288px]" data-testid="change-overview-panel">
+      <div className="flex flex-col gap-3">
+        {archived ? null : (
+          <ChangeStageActions
+            change={change}
+            boundSession={boundSession}
+            gateComment={gateComment}
+            onGateCommentChange={onGateCommentChange}
+            onGateAction={onGateAction}
+            transitioning={transitioning}
+            notifyResult={notifyResult}
+          />
+        )}
+
+        <section className="rounded-md border bg-card" data-testid="change-overview-summary">
+          <div className="flex items-center justify-between gap-2 border-b px-3.5 py-2.5">
+            <h2 className="text-xs font-medium">{archived ? "成果总结" : "变更摘要"}</h2>
+            <span className="text-[11px] text-muted-foreground">
+              {archived ? "已归档" : "非终态每 10 秒自动刷新"}
+            </span>
+          </div>
+          <div className="px-3.5 py-3">
+            <StatGrid items={archived ? archivedItems : inflightItems} />
+          </div>
+        </section>
+
+        {archived ? (
+          <section className="rounded-md border bg-card" data-testid="change-overview-ledger">
+            <div className="flex items-center justify-between gap-2 border-b px-3.5 py-2.5">
+              <h2 className="text-xs font-medium">归档留档</h2>
+              <span className="text-[11px] text-muted-foreground">
+                change.patch（收尾时点冻结）
+              </span>
+            </div>
+            <div className="flex flex-col gap-1.5 px-3.5 py-3 text-xs">
+              {assets?.patch ? (
+                <span>
+                  patch：<span className="font-mono">{assets.patch.files} 文件 +{assets.patch.additions ?? 0} / −{assets.patch.deletions ?? 0}</span>
+                </span>
+              ) : (
+                <span className="text-muted-foreground">暂无 change.patch 记录。</span>
+              )}
+              {assets?.delta ? (
+                <span className="text-muted-foreground">
+                  delta：<span className="font-mono">Before {assets.delta.before_lines ?? "?"} 行 / Delta {assets.delta.delta_lines ?? "?"} 行</span>
+                </span>
+              ) : null}
+              <span className="text-[11px] text-muted-foreground">
+                改动文件清单与单文件 diff 见「产出 · 归档留档」。
+              </span>
+            </div>
+          </section>
+        ) : null}
+
+        <section className="rounded-md border bg-card" data-testid="change-overview-recent">
+          <div className="flex items-center justify-between gap-2 border-b px-3.5 py-2.5">
+            <h2 className="text-xs font-medium">{archived ? "最终动态" : "最近动态"}</h2>
+            <span className="text-[11px] text-muted-foreground">全量见「过程」</span>
+          </div>
+          <div className="px-3.5 py-1.5">
+            {recent.length === 0 ? (
+              <p className="py-3 text-center text-[11px] text-muted-foreground">暂无过程记录。</p>
+            ) : (
+              <RecentRows rows={recent} />
+            )}
+          </div>
+        </section>
+
+        {/* 最后信号（既有纯前端派生口径，FR-auto-frontend-012 承接）：无信号整行不渲染。 */}
+        <ChangeLastSignal lastPushedAt={lastSignal} />
+      </div>
+
+      <ChangeOverviewSide
+        change={change}
+        workspaceId={workspaceId}
+        changeId={changeId}
+        archived={archived}
+        sessions={sessions}
+      />
+    </div>
+  );
+}
diff --git a/frontend/src/components/changes/detail/change-overview-side.tsx b/frontend/src/components/changes/detail/change-overview-side.tsx
new file mode 100644
index 000000000..987858e3f
--- /dev/null
+++ b/frontend/src/components/changes/detail/change-overview-side.tsx
@@ -0,0 +1,240 @@
+"use client";
+
+/**
+ * 概览右侧信息栏（2026-10-15-change-detail-redesign / FR-08 / D-006@v1 / D-016@v1）。
+ *
+ * primer `MetaPanel` 五组压缩承载元信息：基本信息 / 执行用量 / 会话 / 范围对账计数 /
+ * 产出速览——原「执行用量全宽卡」与「会话卡」的位置由本栏承接，首屏不再被三行全宽
+ * 弱信息占据（D-001）。
+ *
+ * 取数纪律（D-016@v1 Q-4）：用量走 `useChangeUsage`（与 `ChangeUsageCard` **同一实现**
+ * 与同一 queryKey）；范围对账与产出计数**复用**各自卡片既有 queryKey（`["scope-audit-card",
+ * "audit", …]` / `["changeAssets", …]`）——同 key 命中 react-query 缓存，零额外请求，
+ * 也天然与卡片保持单一数据源。本文件 MUST NOT 另写取数/格式化实现。
+ *
+ * 归档态两处契约（Phase 4）：用量区标题改「执行用量（合计）」且 MUST NOT 提供「按模型
+ * 明细」展开；范围对账入口改指「产出 · 归档留档」（MUST NOT 指向已隐藏的「文件与对账」tab）。
+ */
+import Link from "next/link";
+import { useQuery } from "@tanstack/react-query";
+
+import { MetaPanel, MetaPanelSection } from "@/components/primer";
+import {
+  cacheHitRate,
+  formatCompactTime,
+  formatDurationZh,
+  formatHitRate,
+  hasNoExecution,
+  useChangeUsage,
+} from "@/components/changes/detail/change-usage-card";
+import { getChangeAssets, getScopeAudit, type ChangeRead } from "@/lib/changes";
+import type { AgentSessionListItem } from "@/lib/daemon";
+
+interface Row {
+  k: string;
+  v: string;
+}
+
+const DASH = "—";
+
+/** 用量七项压缩行（与卡片同源口径，仅改排版密度）。 */
+function usageRows(usage: NonNullable<ReturnType<typeof useChangeUsage>["data"]>): Row[] {
+  const t = usage.totals;
+  return [
+    { k: "耗时", v: usage.duration_ms == null ? DASH : formatDurationZh(usage.duration_ms) },
+    { k: "轮次", v: t.num_turns === 0 ? DASH : String(t.num_turns) },
+    { k: "输入", v: t.input_tokens.toLocaleString("en-US") },
+    { k: "输出", v: t.output_tokens.toLocaleString("en-US") },
+    { k: "缓存读取", v: t.cache_read_tokens.toLocaleString("en-US") },
+    { k: "请求次数", v: t.api_requests === 0 ? DASH : String(t.api_requests) },
+    { k: "缓存命中率", v: formatHitRate(cacheHitRate(t)) },
+  ];
+}
+
+function RowView({ k, v }: Row) {
+  return (
+    <div className="flex items-center justify-between gap-3 text-xs">
+      <span className="text-muted-foreground">{k}</span>
+      <span className="min-w-0 truncate text-right font-mono" title={v}>
+        {v}
+      </span>
+    </div>
+  );
+}
+
+export interface ChangeOverviewSideProps {
+  change: ChangeRead;
+  workspaceId: string;
+  changeId: string;
+  archived: boolean;
+  /** 工作区最近会话（页面层已取；本栏显示最近 3 条）。 */
+  sessions: AgentSessionListItem[];
+}
+
+export function ChangeOverviewSide({
+  change,
+  workspaceId,
+  changeId,
+  archived,
+  sessions,
+}: ChangeOverviewSideProps) {
+  // 复用卡片既有 queryKey（零额外请求；同一数据源）。
+  const changeKey = change.change_key;
+  const usageQ = useChangeUsage("change", workspaceId, changeId);
+  const auditQ = useQuery({
+    queryKey: ["scope-audit-card", "audit", workspaceId, changeKey],
+    queryFn: () => getScopeAudit(workspaceId, changeKey),
+    refetchOnWindowFocus: false,
+  });
+  const assetsQ = useQuery({
+    queryKey: ["changeAssets", workspaceId, changeId],
+    queryFn: () => getChangeAssets(workspaceId, changeId),
+    retry: false,
+    refetchOnWindowFocus: false,
+  });
+
+  const usage = usageQ.data;
+  const usageEmpty = usage == null || hasNoExecution(usage);
+
+  // 范围对账计数：分组形态取信封 repos[].totals 合计（单一源）；单段形态按行 verdict 计数。
+  const audit = auditQ.data;
+  const auditCounts = (() => {
+    if (!audit) return null;
+    const repos = Array.isArray(audit.repos) ? audit.repos : [];
+    if (repos.length > 0) {
+      return repos.reduce(
+        (acc, r) => {
+          const t = (r.totals ?? {}) as Record<string, number>;
+          acc.planned += t.planned ?? 0;
+          acc.unplanned += t.unplanned ?? 0;
+          acc.untouched += t.untouched ?? 0;
+          return acc;
+        },
+        { planned: 0, unplanned: 0, untouched: 0 },
+      );
+    }
+    const rows = audit.rows ?? [];
+    if (rows.length === 0) return null;
+    return rows.reduce(
+      (acc, r) => {
+        const v = audit.mode === "quick" ? r.attribution : r.verdict;
+        if (v === "planned") acc.planned += 1;
+        else if (v === "unplanned") acc.unplanned += 1;
+        else if (v === "untouched") acc.untouched += 1;
+        return acc;
+      },
+      { planned: 0, unplanned: 0, untouched: 0 },
+    );
+  })();
+
+  const assets = assetsQ.data;
+  const assetCounts = {
+    fr: assets?.fr_entries?.length ?? 0,
+    decisions: assets?.decisions?.length ?? 0,
+    touch: assets?.knowledge_touch?.length ?? 0,
+    files: assets?.patch?.files ?? 0,
+  };
+
+  const recentSessions = sessions.slice(0, 3);
+
+  return (
+    <div data-testid="change-overview-side">
+      <MetaPanel className="w-full">
+      <MetaPanelSection title="基本信息">
+        <RowView k="变更 key" v={change.change_key} />
+        <RowView k="类型" v={change.change_type ?? DASH} />
+        <RowView k="创建" v={change.created_at ? formatCompactTime(change.created_at) : DASH} />
+        <RowView k="负责人" v={change.owner_name ?? DASH} />
+      </MetaPanelSection>
+
+      <MetaPanelSection title={archived ? "执行用量（合计）" : "执行用量"}>
+        {usageQ.isPending ? (
+          <p className="text-[11px] text-muted-foreground" data-testid="overview-side-usage-loading">
+            用量加载中…
+          </p>
+        ) : usageEmpty ? (
+          <p className="text-[11px] text-muted-foreground" data-testid="overview-side-usage-empty">
+            暂无用量数据
+          </p>
+        ) : (
+          <>
+            {usageRows(usage).map((row) => (
+              <RowView key={row.k} {...row} />
+            ))}
+            {/* 归档态 MUST NOT 提供按模型明细展开（Phase 4 契约）。 */}
+            {archived ? null : (
+              <div className="pt-1">
+                <Link
+                  href={`/workspaces/${workspaceId}/changes/${changeId}/sessions`}
+                  className="text-xs text-muted-foreground hover:underline"
+                >
+                  按模型明细 →
+                </Link>
+              </div>
+            )}
+          </>
+        )}
+      </MetaPanelSection>
+
+      <MetaPanelSection title="会话">
+        {recentSessions.length === 0 ? (
+          <p className="text-[11px] text-muted-foreground">暂无会话</p>
+        ) : (
+          recentSessions.map((s) => (
+            <div key={s.id} className="flex items-center justify-between gap-2 text-xs">
+              <Link
+                href={`/workspaces/${workspaceId}/sessions?session=${s.id}`}
+                className="truncate font-mono text-primary hover:underline"
+                title={s.title ?? s.id}
+              >
+                {s.title?.trim() || s.id.slice(0, 8)}
+              </Link>
+              <span className="shrink-0 text-muted-foreground">{s.status}</span>
+            </div>
+          ))
+        )}
+        <div className="pt-1">
+          <Link
+            href={`/workspaces/${workspaceId}/sessions`}
+            className="text-xs text-primary hover:underline"
+          >
+            打开会话工作台 →
+          </Link>
+        </div>
+      </MetaPanelSection>
+
+      <MetaPanelSection title="范围对账">
+        {auditCounts === null ? (
+          <p className="text-[11px] text-muted-foreground">暂无对账数据</p>
+        ) : (
+          <>
+            <RowView k="计划内" v={String(auditCounts.planned)} />
+            <RowView k="计划外" v={String(auditCounts.unplanned)} />
+            <RowView k="计划未动" v={String(auditCounts.untouched)} />
+          </>
+        )}
+        <div className="pt-1">
+          {/* 归档态「文件与对账」tab 不渲染（D-007）→ 入口改指「产出 · 归档留档」，不留死链。 */}
+          {archived ? (
+            <span className="text-xs text-muted-foreground">
+              真实改动面见「产出 · 归档留档」
+            </span>
+          ) : (
+            <span className="text-xs text-muted-foreground">明细见「文件与对账」</span>
+          )}
+        </div>
+      </MetaPanelSection>
+
+      <MetaPanelSection title="产出速览">
+        <RowView k="需求规则" v={String(assetCounts.fr)} />
+        <RowView k="决策蒸馏" v={String(assetCounts.decisions)} />
+        <RowView k="知识触达" v={String(assetCounts.touch)} />
+        <RowView k="改动文件" v={assetCounts.files === 0 ? DASH : String(assetCounts.files)} />
+        <div className="pt-1">
+          <span className="text-xs text-muted-foreground">明细见「产出」</span>
+        </div>
+      </MetaPanelSection>
+      </MetaPanel>
+    </div>
+  );
+}
diff --git a/frontend/src/components/changes/detail/change-tabs.tsx b/frontend/src/components/changes/detail/change-tabs.tsx
