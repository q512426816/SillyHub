+      'utf-8',
+    );
+    await uploadKnowledgeHitsIfNeeded(client as never, wsId, specDir);
+    expect(client.postKnowledgeHitsBatch).toHaveBeenCalledWith(wsId, [
+      '{"n":3,"partial":true}',
