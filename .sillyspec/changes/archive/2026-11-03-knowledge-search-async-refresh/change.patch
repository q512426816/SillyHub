+def _gate_bg_sync(monkeypatch: pytest.MonkeyPatch) -> tuple[asyncio.Event, asyncio.Event]:
+    """把 _bg_sync 换成可门控版本，返回 (started, release)。
+
+    StaticPool 下后台任务与请求会话共享同一 aiosqlite 连接，任务体一旦开跑即可能
