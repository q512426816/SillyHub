+});
+
+// ── C3：usage 透传与 totalUsage ──────────────────────────────────────────────
+
+describe('parseClaudeCodeJsonlLog — usage 透传与 totalUsage（C3）', () => {
+  const content = jsonl(
+    // 三段共享同一次调用的 usage（input=10/output=20/cache 100/50）。
+    asstLine(
+      [
