+    const resultGate = new Promise<void>((r) => {
+      releaseResult = r;
+    });
+
+    const interruptSpy = vi.fn(async () => {});
+    const gen = (async function* (): AsyncGenerator<SDKMessage, void> {
+      orderLog.push('assistant_yielded');
