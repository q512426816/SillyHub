+      message: { role: 'user', content: '忙轮引导：改用方案B' },
+      parent_tool_use_id: null,
+    });
+    // 顺序：inject 消费先于 turn1 result 产出（不排队等轮边界）。
+    expect(orderLog).toEqual([
