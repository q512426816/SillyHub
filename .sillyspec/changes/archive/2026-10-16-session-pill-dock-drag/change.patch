+        <button type="button">待决策 0</button>
+      </SessionFloatingPillDock>,
+    );
+    const dock = dockEl();
+    // 无边界元素：x 用视口右缘；y 因传了 boundsSelector 按 EDGE_GAP 贴底（元素出现后 settle 自愈）
+    expect(dock.style.left).toBe("1008px");
+    expect(dock.style.top).toBe("752px");
+  });
+});
