+async def _seed_log_line(
+    db_session: AsyncSession,
+    run_id: uuid.UUID,
+    content: str,
+) -> None:
+    """种一条 stdout 日志行（对齐 daemon 落库形态：channel='stdout'）。"""
+    db_session.add(
+        AgentRunLog(
+            run_id=run_id,
+            timestamp=datetime.now(UTC),
+            channel="stdout",
+            content_redacted=content,
+        )
+    )
+    await db_session.commit()
