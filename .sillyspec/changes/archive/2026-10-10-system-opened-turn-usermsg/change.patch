+      makeLog("o1", "run-1", "stdout", "正文", { timestamp: TS(30) }),
+    ]);
+    const turn = turns[0]!;
+    expect(turn.prompt).toBe("");
+    expect((turn.segments ?? []).some((s) => s.kind === "user_msg")).toBe(false);
+  });
