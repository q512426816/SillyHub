-                  {turns.map((turn) =>
-                    turn.role === "user" ? (
-                      <div key={turn.key} className="flex justify-end">
-                        <div className="max-w-[82%] whitespace-pre-wrap break-words rounded-2xl rounded-tr-sm bg-brand-600 px-3 py-2 text-[12.5px] leading-relaxed text-white">
