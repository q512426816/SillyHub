-          <MarkdownText content={seg.text} />
-        </div>
-      );
-    case "thinking":
-      return (
-        <CollapsibleSection
-          key={seg.seq}
-          title="思考过程"
-          defaultOpen={false}
-          summary={thinkingSummary(seg.text)}
-        >
-          <div className="whitespace-pre-wrap break-words text-[11.5px] leading-relaxed text-muted-foreground">
