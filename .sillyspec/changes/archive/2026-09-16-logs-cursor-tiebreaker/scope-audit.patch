+        status="completed",
+        agent_session_id=sess.id,
+        session_id=None,
+        started_at=now,
+    )
+    db_session.add(run)
+    await db_session.flush()
+    batch_ts = now - timedelta(minutes=5)
+    log_ids: list[uuid.UUID] = []
