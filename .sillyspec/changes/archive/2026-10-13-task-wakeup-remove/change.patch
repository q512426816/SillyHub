-function formatSegmentTime(ts: string | null): string | null {
-  if (!ts) return null;
-  const t = new Date(ts);
-  if (Number.isNaN(t.getTime())) return null;
-  return t.toLocaleString("zh-CN", {
-    hour12: false,
-    month: "2-digit",
-    day: "2-digit",
-    hour: "2-digit",
-    minute: "2-digit",
-  });
-}
