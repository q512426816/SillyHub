+
+    model_config = ConfigDict(populate_by_name=True)
+
+    from_: str = Field(alias="from")
+    to: str
+    found: bool
+    reason: str = ""
+    hop_count: int = 0
+    hops: list[GraphHop]
+
+
+class GraphDecisionRef(BaseModel):
