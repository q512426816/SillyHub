+
+  // 默认视图（D-006）：overview 可用即自动发起（?preset=dangling 深链优先，
+  // 缺省 orphans）——只在首次可用落定时执行一次（bootstrappedRef 守卫）。
+  const bootstrappedRef = useRef(false);
