+#: query 端点 data 按 sub 分型的联合（五查询主链路 + summary/nodes 直通）。
+GraphQueryData = (
+    GraphNeighborsData
+    | GraphPathData
+    | GraphImpactData
+    | GraphOrphansData
+    | GraphDanglingData
+    | GraphSummary
+    | GraphNodesData
+)
+GraphQueryOut = GraphEnvelope[GraphQueryData]
+GraphOverviewOut = GraphEnvelope[GraphOverviewData]
+GraphNodesOut = GraphEnvelope[GraphNodesData]
