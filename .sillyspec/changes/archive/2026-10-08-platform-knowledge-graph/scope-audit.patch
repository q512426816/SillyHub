+  const onPointerUp = (e: React.PointerEvent<HTMLCanvasElement>) => {
+    if (dragRef.current) {
+      dragRef.current.drag = false;
+      dragRef.current = null;
+    }
+    panRef.current = null;
+    canvasRef.current?.releasePointerCapture(e.pointerId);
