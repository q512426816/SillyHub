+      return;
+    }
+    const hit = pickNode(simRef.current, p.x, p.y, viewRef.current.k);
+    const nextHover = hit?.id ?? null;
+    if (nextHover !== hoverRef.current) {
+      hoverRef.current = nextHover;
+      dirtyRef.current = true;
+    }
