+  const selectedNode = selectedId ? nodeMap.get(selectedId) ?? null : null;
+
+  // ── 全页三态：isPending 骨架 / unavailable 六键降级 / 可用三栏 ────────────
+  if (overviewQ.isPending) {
+    return (
+      <PageContainer size="full">
