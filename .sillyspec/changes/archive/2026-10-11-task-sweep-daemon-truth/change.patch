+  useShell: boolean,
+  env: NodeJS.ProcessEnv,
+): Promise<number> {
+  return new Promise((resolve) => {
+    let settled = false;
+    const done = (v: number) => {
+      if (!settled) {
+        settled = true;
+        resolve(v);
+      }
+    };
+    let child;
+    try {
+      child = spawn(cmdPath, ['--version'], {
+        env,
+        stdio: ['ignore', 'pipe', 'pipe'],
+        shell: useShell,
+        windowsHide: true,
+      });
+    } catch {
+      done(-1);
+      return;
+    }
+    let out = '';
+    child.stdout?.on('data', (d: unknown) => {
+      out += String(d);
+    });
+    child.on('error', () => done(-1));
+    child.on('close', () => done(parsePiMajorVersion(out)));
+    setTimeout(() => {
+      done(-1);
+      try {
+        child.kill();
+      } catch {
+        /* noop */
+      }
