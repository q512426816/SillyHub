+          { id: "b", label: "钉住", layer: 1 },
+        ]}
+        edges={[{ from: "a", to: "b" }]}
+      />,
+    );
+    // a 在第 3 列，b 钉在第 1 列——若被边推挤会落到第 4 列。
+    expect(nodeX(container, "b")).toBeLessThan(nodeX(container, "a"));
+  });
+});
