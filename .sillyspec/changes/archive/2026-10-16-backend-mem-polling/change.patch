+
+        outer = asyncio.create_task(hub.send_rpc(rid, "list_dir", {"path": "/x"}, timeout=5.0))
+        await asyncio.sleep(0.05)  # 让 send_rpc 注册 pending 并进入等待
+        outer.cancel()
+        with pytest.raises((asyncio.CancelledError, DaemonRuntimeOffline)):
