+"""alembic 迁移单头守卫（2026-10-11-alembic-single-head-guard FR-01）。
+
+生产实证（2026-10-11）：并行变更各自新增迁移未合流即部署——两条 revision 同父分叉，
+backend 容器 ``alembic upgrade head`` 报 ``Multiple head revisions`` crash-loop，平台
+宕机约 2 分钟（回滚 backup-20261011-1907 保服务后手工 ``alembic merge heads`` 修复）。
+本测试在 CI 测试套件内把该形态提前拦成红灯：heads 必须恰一个，多头即 fail 并给出
+merge 解法提示。
+
+实现走 alembic API（ScriptDirectory.get_heads），不 shell out——CI/本地环境无差异。
+部署侧同款守卫见 deploy/scripts/build-and-save.sh 预检步骤（双闸：CI 拦 PR、脚本拦
+打镜像）。
+"""
+
+from pathlib import Path
+
+from alembic.config import Config
+from alembic.script import ScriptDirectory
+
+
+def test_alembic_single_head() -> None:
+    backend_root = Path(__file__).resolve().parents[1]
+    script = ScriptDirectory.from_config(Config(str(backend_root / "alembic.ini")))
+    heads = script.get_heads()
+    assert len(heads) == 1, (
+        "alembic 迁移多头（并行变更各自加迁移未合流）——部署会 crash-loop："
+        f"当前 heads={heads}。解法：cd backend && python -m alembic merge heads "
+        '-m "merge parallel heads ..." 后提交 merge revision（纯 DAG 接线无 DDL）。'
+        "（生产实证 2026-10-11：Multiple head revisions 宕机）"
+    )
diff --git a/deploy/scripts/build-and-save.sh b/deploy/scripts/build-and-save.sh
index fe374ff0c..76b3f6759 100644
--- a/deploy/scripts/build-and-save.sh
+++ b/deploy/scripts/build-and-save.sh
@@ -28,6 +28,23 @@ for f in sillyhub-daemon/build/bundle/sillyhub-daemon.js sillyhub-daemon/build/b
 done
 echo "    bundle OK"
 
+echo "==> [2.5/5] alembic 迁移单头预检（2026-10-11 生产实证：多头部署 crash-loop 宕机）"
+# 双闸之二（闸一为 backend/tests/test_migration_single_head.py 随 CI 跑）：打镜像前
+# 本地 fail-fast——多头直接退出，省掉「传 300M 镜像上服务器才发现起不来」的往返。
+ALEMBIC_HEADS="$(cd backend && python -m alembic heads 2>&1)" || {
+  echo "    ❌ alembic 命令失败（本地 Python 环境缺依赖？cd backend && uv sync 修复后重试）:"
+  echo "       $ALEMBIC_HEADS"
+  exit 1
+}
+ALEMBIC_HEAD_COUNT="$(printf '%s\n' "$ALEMBIC_HEADS" | grep -c '(head)')"
+if [ "$ALEMBIC_HEAD_COUNT" -ne 1 ]; then
+  echo "    ❌ alembic 迁移多头（并行变更各自加迁移未合流）——部署后 backend upgrade head 会 crash-loop："
+  printf '%s\n' "$ALEMBIC_HEADS" | sed 's/^/       /'
+  echo "    解法：cd backend && python -m alembic merge heads -m \"merge parallel heads ...\" 后提交再打包"
+  exit 1
+fi
+echo "    单头 OK: $(printf '%s\n' "$ALEMBIC_HEADS" | grep '(head)' | head -1)"
+
 echo "==> [3/5] 准备 build-arg"
 # COMMIT_SHA 焙进镜像（health 端点回显版本）；export 到环境后 compose 读 ${COMMIT_SHA:-} 覆盖 .env 空值。
 export COMMIT_SHA="${COMMIT_SHA:-$(git rev-parse --short HEAD)}"
