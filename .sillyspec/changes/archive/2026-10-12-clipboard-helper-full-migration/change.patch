+    setNearBottom(true);
+    setBottomAnchor(null);
+  }, []);
+
+  // quick（ql-20260921-003-42be）：贴底重申循环——组件级自管理，刻意不挂 effect
+  // cleanup：establish 后 SSE 对账等任何二次 turns 提交都会重跑 [turns] effect，
+  // cleanup 会误杀仍在窗口期内的循环（新 effect 因末轮签名不变不再启动，视口
