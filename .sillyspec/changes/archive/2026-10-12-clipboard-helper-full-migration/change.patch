+/** 工具行图标——原型 t-icon 语义映射（未列工具统一 🔧 扳手，同现有 Wrench 语义）。 */
+const TOOL_ICON: Record<string, string> = {
+  Read: "📂",
+  Write: "🎨",
+  Edit: "✏️",
+  Grep: "🔧",
+  Glob: "🔧",
+  Bash: "💻",
+  Task: "🤖",
+  Agent: "🤖",
+};
