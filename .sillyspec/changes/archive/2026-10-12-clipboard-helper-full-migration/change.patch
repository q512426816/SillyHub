+/* ────────────── 轮头分叉入口（2026-09-22-session-fork-continuation task-07 / FR-01 / FR-04） ────────────── */
+
+/** caps sessionFork 三档（@/lib/provider-caps 单源派生，勿手抄字面量）。 */
+export type SessionForkTier = ProviderCaps["sessionFork"];
