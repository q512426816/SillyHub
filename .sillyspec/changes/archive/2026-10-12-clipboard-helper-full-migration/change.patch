+    lastIdentity: string | null;
+  } | null>(null);
+
+  // ── task-07（2026-09-09-askuser-pi-cursor / FR-03 / design §Wave B.3）：
+  //    marker 提问卡已答态 best-effort 判定——该轮之后已存在用户消息（后续 turn
