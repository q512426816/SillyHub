-/** 汇总收口状态卡数据（后端 metadata.consensus_card 同构；task-10）。 */
-export interface ConsensusCardData {
-  coordinatorName: string;
-  /** collecting / converging / closed / timeout / aborted（后端词表镜像）。 */
-  phase: string;
-  members: { name: string; state: string }[];
-  updatedAt: string;
-}
