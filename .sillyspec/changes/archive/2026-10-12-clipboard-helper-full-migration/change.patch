-/** 实时 log 事件的消费产物：新条目 / 撤回令箭（按段撤回半截行）/ 忽略。 */
-export type GroupLiveLogResult =
-  | { type: "entry"; entry: GroupTimelineEntry }
-  | { type: "revoke"; segmentId: string }
-  | { type: "ignore" };
