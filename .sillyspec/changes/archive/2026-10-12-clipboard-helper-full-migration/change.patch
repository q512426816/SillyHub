+        return (
+          <div key={idx} className="flex items-start gap-1.5 text-[11px] text-amber-700">
+            <span aria-hidden className="shrink-0">⚠</span>
+            <span className="min-w-0 whitespace-pre-wrap break-words">{item.text}</span>
+          </div>
+        );
+      })}
+    </div>
+  );
