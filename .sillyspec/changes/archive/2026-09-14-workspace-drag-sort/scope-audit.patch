+// 单列确定性布局：第 i 张卡 top=i*120（高 100）；上带 top=-60、下带紧随末卡下方。
+const makeRect = (top: number, width: number, height: number) => {
+  const rect = {
+    x: 0,
+    y: top,
+    top,
+    left: 0,
+    right: width,
+    bottom: top + height,
+    width,
+    height,
+    toJSON() {
+      return rect;
+    },
+  };
+  return rect as unknown as DOMRect;
+};
