+  it("move 成功：onMoved.page=floor(rank/12) + 目标卡高亮 1.6s 出现与消退", async () => {
+    wsApi.moveWorkspace.mockImplementationOnce(() => okMove(14)); // 14/12 → page 1
+    const { container, onMoved } = renderGrid({ page: 0, total: 30 });
