+        sa_column=Column(
+            Uuid(as_uuid=True),
+            ForeignKey("users.id"),
+            nullable=False,
+        ),
+    )
+    workspace_id: uuid.UUID = Field(
+        sa_column=Column(
+            Uuid(as_uuid=True),
+            ForeignKey("workspaces.id"),
+            nullable=False,
