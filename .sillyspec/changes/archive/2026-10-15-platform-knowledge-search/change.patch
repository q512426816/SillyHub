+def test_kind_derivation_full_table(tmp_path: Path, spec_path: str, kind: str) -> None:
+    chunks = chunk_markdown(spec_path, "## 小节\n\n正文。\n")
+    assert chunks, "至少产出一个块"
+    assert all(c.kind == kind for c in chunks)
