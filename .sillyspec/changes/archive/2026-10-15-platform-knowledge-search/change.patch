+    )
+    fake = FakeEmbedder()
+    # 「会话状态」在语料中无连续子串（「会话过程」/「状态点」分离）→ 纯语义路召回
+    out = search_sync(tmp_path, "ws-sem", "会话状态", 5, fake, "fake-model")
+    results = out["results"]
+    assert results, "纯语义应可召回"
+    assert results[0]["spec_path"] == "knowledge/manual.md"
+    assert results[0]["title"] == "会话过程"
