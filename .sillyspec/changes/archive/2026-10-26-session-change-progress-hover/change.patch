+import { describe, it, expect } from "vitest";
+import { render, screen } from "@testing-library/react";
+
+import {
+  ChangeTotalProgressRing,
+  computeTotalRatio,
+  pickLatestActive,
+  type TotalProgressChange,
+} from "@/components/daemon/change-total-progress-ring";
+
+// ── 测试数据构造 ──────────────────────────────────────────────────────────
+// TotalProgressChange 是本组件的手写最小结构视图（api-types 生成版
+// ChangeSummary 待 task-11 gen:types；task-10 悬浮框接线时结构子类型兼容）。
+
+function thinFlow(partial: Partial<NonNullable<TotalProgressChange["thin_flow"]>> = {}) {
+  // as 断言收口：默认对象已含全字段（生成物 ThinFlowProgress 全必填——backend
+  // pydantic 无 default），Partial 展开后 TS 无法静态证明完整性。
+  return {
+    phase: "executing",
+    approved: true,
+    autopilot: false,
+    adopted_from: null,
+    tasks_total: 0,
+    tasks_done: 0,
+    substeps_done: 0,
+    substeps_total: 8,
+    upgraded: false,
+    ...partial,
+  } as NonNullable<TotalProgressChange["thin_flow"]>;
+}
+
+function stepProgress(
+  step_total: number,
+  steps_completed: number,
+): NonNullable<TotalProgressChange["step_progress"]> {
+  return { step_total, steps_completed };
+}
+
+function changeLike(partial: Partial<TotalProgressChange>): TotalProgressChange {
+  return {
+    change_key: "2026-10-26-demo-change",
+    updated_at: "2026-10-26T12:00:00Z",
+    is_thin: false,
+    step_progress: null,
+    thin_flow: null,
+    ...partial,
+  };
+}
+
+// ── computeTotalRatio（口径函数单源，design FR-05）────────────────────────
+
+describe("computeTotalRatio（全量口径：steps_completed/step_total）", () => {
+  it("非 thin 变更按 step_progress 步数比计算", () => {
+    const c = changeLike({ step_progress: stepProgress(24, 10) });
+    expect(computeTotalRatio(c)).toBeCloseTo(10 / 24, 5);
+  });
+
+  it("step_progress 缺失（旧数据/六表未上行）→ null（环不渲染，FR-07 降级）", () => {
+    expect(computeTotalRatio(changeLike({ step_progress: null }))).toBeNull();
+  });
+
+  it("step_total=0（除零防御）→ null", () => {
+    expect(computeTotalRatio(changeLike({ step_progress: stepProgress(0, 0) }))).toBeNull();
+  });
+
+  it("steps_completed 超过 step_total（异常数据）→ 钳制 1，不出 >100%", () => {
+    const c = changeLike({ step_progress: stepProgress(24, 30) });
+    expect(computeTotalRatio(c)).toBe(1);
+  });
+});
+
+describe("computeTotalRatio（轻量口径：相位加权，design 接口定义）", () => {
+  it("spec 相位 → 0.1", () => {
+    const c = changeLike({ is_thin: true, thin_flow: thinFlow({ phase: "spec" }) });
+    expect(computeTotalRatio(c)).toBeCloseTo(0.1, 5);
+  });
+
+  it("awaiting_approval 相位 → 0.15", () => {
+    const c = changeLike({
+      is_thin: true,
+      thin_flow: thinFlow({ phase: "awaiting_approval" }),
+    });
+    expect(computeTotalRatio(c)).toBeCloseTo(0.15, 5);
+  });
+
+  it("executing 相位 → 0.33 + 0.34×tasks_done/tasks_total", () => {
+    const c = changeLike({
+      is_thin: true,
+      thin_flow: thinFlow({ phase: "executing", tasks_done: 2, tasks_total: 5 }),
+    });
+    expect(computeTotalRatio(c)).toBeCloseTo(0.33 + 0.34 * (2 / 5), 5);
+  });
+
+  it("executing tasks_total=0 → 分母 max(,1) 兜底，不除零（盲区口径）", () => {
+    const c = changeLike({
+      is_thin: true,
+      thin_flow: thinFlow({ phase: "executing", tasks_done: 0, tasks_total: 0 }),
+    });
+    expect(computeTotalRatio(c)).toBeCloseTo(0.33, 5);
+  });
+
+  it("closing 相位 → 0.67 + 0.33×substeps_done/8", () => {
+    const c = changeLike({
+      is_thin: true,
+      thin_flow: thinFlow({ phase: "closing", substeps_done: 4 }),
+    });
+    expect(computeTotalRatio(c)).toBeCloseTo(0.67 + 0.33 * (4 / 8), 5);
+  });
+
+  it("is_thin 但 thin_flow 缺失（旧 daemon 无新键）→ null（环不渲染）", () => {
+    expect(computeTotalRatio(changeLike({ is_thin: true, thin_flow: null }))).toBeNull();
+  });
+
+  it("未知 phase（backend 归一枚举外透传值）→ null", () => {
+    const c = changeLike({ is_thin: true, thin_flow: thinFlow({ phase: "weird" }) });
+    expect(computeTotalRatio(c)).toBeNull();
+  });
+
+  it("升厚（thin_flow.upgraded）→ 切全量口径读 step_progress（FR-04 分支优先级单源）", () => {
+    const c = changeLike({
+      is_thin: true,
+      thin_flow: thinFlow({ phase: "executing", upgraded: true }),
+      step_progress: stepProgress(24, 10),
+    });
+    expect(computeTotalRatio(c)).toBeCloseTo(10 / 24, 5);
+  });
+
+  it("executing 加权超 1（异常勾选数据）→ 钳制 1", () => {
+    const c = changeLike({
+      is_thin: true,
+      thin_flow: thinFlow({ phase: "executing", tasks_done: 5, tasks_total: 2 }),
+    });
+    expect(computeTotalRatio(c)).toBe(1);
+  });
+});
+
+// ── pickLatestActive（updated_at 显式重排选取，D-013@v1 / 盲区#6）────────
+
+describe("pickLatestActive（updated_at 显式重排，禁用后端列表序）", () => {
+  // 后端列表序 = 未归档优先 + created_at desc（session-change-files-hover.tsx:63
+  // 注释）——构造「created 晚（后端排前）但 updated_at 早」与相反的 A/B 对，
+  // 证明取首项 ≠ updated_at 最新，必须显式重排（D-013@v1）。
+  const createdLateUpdatedEarly = changeLike({
+    change_key: "2026-10-25-a",
+    updated_at: "2026-10-26T10:00:00Z",
+  });
+  const createdEarlyUpdatedLate = changeLike({
+    change_key: "2026-10-20-b",
+    updated_at: "2026-10-26T12:00:00Z",
+  });
+
+  it("后端序取首不成立的场景：选 updated_at 最新（与输入顺序无关）", () => {
+    expect(pickLatestActive([createdLateUpdatedEarly, createdEarlyUpdatedLate])).toBe(
+      createdEarlyUpdatedLate,
+    );
+    expect(pickLatestActive([createdEarlyUpdatedLate, createdLateUpdatedEarly])).toBe(
+      createdEarlyUpdatedLate,
+    );
+  });
+
+  it("并列 updated_at 回退 change_key 码点序（结果与输入顺序无关，盲区#6）", () => {
+    const keyB = changeLike({ change_key: "2026-10-26-b", updated_at: "2026-10-26T12:00:00Z" });
+    const keyA = changeLike({ change_key: "2026-10-26-a", updated_at: "2026-10-26T12:00:00Z" });
+    expect(pickLatestActive([keyB, keyA])).toBe(keyA);
+    expect(pickLatestActive([keyA, keyB])).toBe(keyA);
+  });
+
+  it("空数组 → null", () => {
+    expect(pickLatestActive([])).toBeNull();
+  });
+
+  it("updated_at 非法串（数据异常）排最后，不 NaN 崩溃", () => {
+    const bad = changeLike({ change_key: "2026-10-26-bad", updated_at: "not-a-date" });
+    const good = changeLike({ change_key: "2026-10-26-good", updated_at: "2026-01-01T00:00:00Z" });
+    expect(pickLatestActive([bad, good])).toBe(good);
+  });
+});
+
+// ── ChangeTotalProgressRing（组件渲染）────────────────────────────────────
+
+describe("ChangeTotalProgressRing（入口总进度圈渲染）", () => {
+  it("全量口径渲染：环容器 + 中心百分比文字 + aria-label 文本化（R-05）", () => {
+    const c = changeLike({ step_progress: stepProgress(24, 10) });
+    render(<ChangeTotalProgressRing change={c} />);
+    // 10/24 = 41.67% → round 42
+    expect(screen.getByTestId("change-total-progress-ring")).toBeTruthy();
+    expect(screen.getByTestId("change-total-progress-ring-percent").textContent).toBe("42%");
+    expect(screen.getByRole("img", { name: "变更总进度 42%" })).toBeTruthy();
+  });
+
+  it("进度弧 stroke-dasharray 按比值填充圆周（2πr×ratio）", () => {
+    const c = changeLike({ step_progress: stepProgress(24, 10) });
+    render(<ChangeTotalProgressRing change={c} />);
+    const arc = screen.getByTestId("change-total-progress-ring-arc");
+    const dash = Number(arc.getAttribute("stroke-dasharray")!.split(" ")[0]);
+    expect(dash).toBeCloseTo(2 * Math.PI * 10 * (10 / 24), 3);
+  });
+
+  it("轻量口径渲染：executing 相位 2/5 任务 → 47%", () => {
+    const c = changeLike({
+      is_thin: true,
+      thin_flow: thinFlow({ phase: "executing", tasks_done: 2, tasks_total: 5 }),
+    });
+    render(<ChangeTotalProgressRing change={c} />);
+    // 0.33 + 0.34×0.4 = 0.466 → round 47
+    expect(screen.getByTestId("change-total-progress-ring-percent").textContent).toBe("47%");
+  });
+
+  it("ratio null（数据缺失）→ 不渲染（FR-05 降级，入口按钮区不受影响）", () => {
+    const c = changeLike({ is_thin: true, thin_flow: null, step_progress: null });
+    const { container } = render(<ChangeTotalProgressRing change={c} />);
+    expect(container.innerHTML).toBe("");
+    expect(screen.queryByTestId("change-total-progress-ring")).toBeNull();
+  });
+});

diff --git a/frontend/src/components/daemon/change-progress-row.tsx b/frontend/src/components/daemon/change-progress-row.tsx
new file mode 100644
--- /dev/null
+++ b/frontend/src/components/daemon/change-progress-row.tsx
@@ -0,0 +1,265 @@
+"use client";
+
+/**
+ * 会话悬浮变更面板·下拉项进度行（2026-10-26-session-change-progress-hover
+ * task-08 / FR-01~FR-04）。双分支单源规则（FR-04）：
+ *   is_thin && !upgraded && change_type!=='quick' → 轻量 ①②③ 相位行；
+ *   否则（含升厚 D-007——忽略 thin_flow 残留相位值；change_type==='quick' 存量
+ *   出身独立判 thin 场景，backend _is_thin_lineage 分支②）→ 全量 5 圈行。
+ * 降级（FR-07）：分支数据缺失（轻量无 thin_flow / 全量无 stage_progress）→
+ * 返回 null 不渲染（现状保底不报错）；归档项挂载由消费方控制（D-009）。
+ * 色阶铁律（FRONTEND_PAGE_STYLE §0.5 / R-05）：全走主题 CSS 变量，无裸 hex；
+ * 圈为 conic-gradient 占比填充的 h-2.5 w-2.5 紧凑小圈。
+ */
+
+import {
+  WORKFLOW_STAGES,
+  WORKFLOW_STAGE_LABELS,
+} from "@/components/changes/detail/change-stage-header";
+import type { components } from "@/lib/api-types";
+import type { ChangeSummary } from "@/lib/changes";
+
+// ── 类型（task-11 gen:types 落地后）：三 DTO 切生成物（components["schemas"]，
+// 与 backend schema.py 逐字对齐，生成物 15088-15090 行 ChangeSummary 已含三新
+// 字段）；导出名保留手写期形态，既有消费方（hover/ring/测试）import 面零变化。──
+
+/** 主线单阶段进度项（生成物 StageProgressEntry）。status 为 CLI 原值透传不归一。 */
+export type StageProgressEntry = components["schemas"]["StageProgressEntry"];
+
+/** execute 阶段任务进度（生成物 TaskProgressSummary；Task 表口径 D-005@v1）。 */
+export type TaskProgressSummary = components["schemas"]["TaskProgressSummary"];
+
+/** 轻量变更相位进度（生成物 ThinFlowProgress；phase 归一四枚举）。 */
+export type ThinFlowProgress = components["schemas"]["ThinFlowProgress"];
+
+/** ChangeSummary + 三新字段（生成版已含三字段；别名保住既有 import 面）。 */
+export type ChangeSummaryWithProgress = ChangeSummary;
+
+export interface ChangeProgressRowProps {
+  change: ChangeSummaryWithProgress;
+  /** 轻量总时长起点（FR-03 created_at→updated_at）。ChangeSummary 后端 DTO
+   * 不返回 created_at，消费方无来源时省略 → 总时长段不渲染（fail-open）。 */
+  createdAt?: string | null;
+}
+
+/** 耗时人性化（m/h 自适应）：秒级显秒 / 分钟级显分 / 小时级一位小数。 */
+export function formatDurationSeconds(
+  seconds: number | null | undefined,
+): string {
+  if (seconds == null || !Number.isFinite(seconds) || seconds < 0) return "";
+  if (seconds < 60) return `${Math.round(seconds)}秒`;
+  if (seconds < 3600) return `${Math.round(seconds / 60)}分`;
+  return `${(seconds / 3600).toFixed(1)}时`;
+}
+
+// ── 全量支（FR-01/FR-02）────────────────────────────────────────────────────
+
+/** 异常态映射（D-002@v1）：waiting/stale/revising=warning、blocked/failed=error；revising 带 revision 轮次。 */
+const ABNORMAL_STATUSES: Record<
+  string,
+  { label: (e: StageProgressEntry) => string; tone: "warning" | "error" }
+> = {
+  waiting: { label: () => "等待中", tone: "warning" },
+  stale: { label: () => "过期", tone: "warning" },
+  revising: {
+    label: (e) => (e.revision != null ? `修订${e.revision}` : "修订中"),
+    tone: "warning",
+  },
+  blocked: { label: () => "阻塞", tone: "error" },
+  failed: { label: () => "失败", tone: "error" },
+};
+
+/** 单阶段小圈：completed=绿勾 / in-progress=conic 占比 / 异常态=warning·error
+ *  实色 / pending=空圈 / 未知值（盲区#10）=灰态。 */
+function StageDot({ entry, testid }: { entry: StageProgressEntry | undefined; testid: string }) {
+  const status = entry?.status ?? "pending";
+  const abnormal = ABNORMAL_STATUSES[status];
+  if (status === "completed") {
+    return (
+      <span data-testid={testid} className="text-[11px] font-bold leading-none text-success">✓</span>
+    );
+  }
+  if (abnormal) {
+    return (
+      <span data-testid={testid} aria-hidden className={`h-2.5 w-2.5 shrink-0 rounded-full ${
+        abnormal.tone === "error" ? "bg-error" : "bg-warning"
+      }`} />
+    );
+  }
+  if (status === "in-progress") {
+    // 盲区#1：steps 空（阶段未初始化）steps_total=0 → 0% 填充不除零
+    const total = entry?.steps_total ?? 0;
+    const done = entry?.steps_completed ?? 0;
+    const deg = total > 0 ? Math.round((done / total) * 360) : 0;
+    return (
+      <span data-testid={testid} data-progress={total > 0 ? `${done}/${total}` : "0"} aria-hidden
+        className="h-2.5 w-2.5 shrink-0 rounded-full"
+        style={{ background: `conic-gradient(hsl(var(--primary)) ${deg}deg, hsl(var(--border)) 0deg)` }} />
+    );
+  }
+  // pending=空圈；CLI 新枚举未知值（盲区#10）=灰态圈（原值文字由外层单元渲染）
+  const isPending = status === "pending";
+  return (
+    <span data-testid={testid} data-unknown={isPending ? undefined : status} aria-hidden
+      className={`h-2.5 w-2.5 shrink-0 rounded-full ${isPending ? "border-2 border-border" : "bg-muted-foreground"}`} />
+  );
+}
+
+/** 全量 5 圈行。stage_progress 缺行按 pending 空圈补位（WORKFLOW_STAGES 序）。 */
+function FullStageRow({ entries, taskProgress, upgraded }: {
+  entries: StageProgressEntry[];
+  taskProgress: TaskProgressSummary | null;
+  upgraded: boolean;
+}) {
+  const byStage = new Map(entries.map((e) => [e.stage, e]));
+  // 盲区#2：total=0（全 cancelled）显 —，不用 0/0
+  const taskText = !taskProgress
+    ? null
+    : taskProgress.total > 0
+      ? `${taskProgress.done}/${taskProgress.total} 任务`
+      : "—";
+
+  const ariaText = WORKFLOW_STAGES.map((s) => {
+    const e = byStage.get(s);
+    const status = e?.status ?? "pending";
+    const label = WORKFLOW_STAGE_LABELS[s];
+    const abnormal = ABNORMAL_STATUSES[status];
+    if (status === "completed") return `${label}已完成`;
+    if (status === "in-progress") {
+      const stepInfo = e && e.steps_total > 0 ? `，${e.steps_completed}/${e.steps_total}步` : "";
+      return `${label}进行中${stepInfo}`;
+    }
+    if (abnormal && e) return `${label}${abnormal.label(e)}`;
+    if (status === "pending") return `${label}未开始`;
+    return `${label}${status}`; // 盲区#10：未知值原样文本化
+  }).join("，");
+
+  return (
+    <div data-testid="change-progress-row" data-variant="full"
+      aria-label={`变更进度：${ariaText}${taskText ? `，任务${taskText}` : ""}`}
+      className="mt-1 flex flex-wrap items-start gap-x-2 gap-y-0.5">
+      {WORKFLOW_STAGES.map((stage) => {
+        const e = byStage.get(stage);
+        const abnormal = e ? ABNORMAL_STATUSES[e.status] : undefined;
+        const isUnknown = !!e && !abnormal && !["completed", "in-progress", "pending"].includes(e.status);
+        const sideText = abnormal && e ? abnormal.label(e) : isUnknown && e ? e.status : null;
+        const sideClass = abnormal && abnormal.tone === "error" ? "text-error" : abnormal ? "text-warning" : "text-muted-foreground";
+        return (
+          <div key={stage} className="flex min-w-0 flex-col items-center gap-0.5">
+            <div className="flex items-center gap-1">
+              <StageDot entry={e} testid={`progress-circle-${stage}`} />
+              {stage === "execute" && taskText && (
+                <span data-testid="progress-task-count" className="text-[10px] leading-3 text-muted-foreground">{taskText}</span>
+              )}
+              {sideText && (
+                <span data-testid={`progress-status-${stage}`} className={`text-[10px] leading-3 ${sideClass}`}>{sideText}</span>
+              )}
+            </div>
+            <span data-testid={`progress-duration-${stage}`} className="text-[9px] leading-3 text-muted-foreground">
+              {formatDurationSeconds(e?.duration_seconds) || " "}
+            </span>
+          </div>
+        );
+      })}
+      {upgraded && (
+        <span data-testid="progress-upgraded-tag" className="text-[10px] leading-3 text-warning">已升厚→走全量</span>
+      )}
+    </div>
+  );
+}
+
+// ── 轻量支：①②③ 相位行（FR-03/FR-04）───────────────────────────────────────
+
+const THIN_PHASE_STEPS = [
+  { key: "spec", label: "①规格" },
+  { key: "executing", label: "②执行" },
+  { key: "closing", label: "③归档" },
+] as const;
+
+const THIN_PHASE_ARIA: Record<string, string> = {
+  spec: "规格",
+  awaiting_approval: "规格待批准",
+  executing: "执行",
+  closing: "收口",
+};
+
+function ThinPhaseRow({ thin, updatedAt, createdAt }: {
+  thin: ThinFlowProgress;
+  updatedAt: string;
+  createdAt: string | null;
+}) {
+  // awaiting_approval 是 spec 位的待批准子态（design FR-03）
+  const phasePos = thin.phase === "awaiting_approval" ? "spec" : thin.phase;
+  const approvalText = thin.autopilot ? "autopilot 豁免" : thin.approved ? "已批准" : "未批准";
+  const approvalClass = thin.autopilot ? "text-info" : thin.approved ? "text-success" : "text-muted-foreground";
+  // 盲区#8：spec 阶段未建任务 tasks_total=0 → 不显「任务 0/0」
+  const tasksText = thin.phase === "executing" && thin.tasks_total > 0
+    ? `任务 ${thin.tasks_done}/${thin.tasks_total}` : null;
+  const substepsText = thin.phase === "closing"
+    ? `子步 ${thin.substeps_done}/${thin.substeps_total || 8}` : null;
+  // 总时长（D-001@v1）：created→updated；缺 created / 畸形时间 → 不显
+  let durationText = "";
+  if (createdAt) {
+    const ms = new Date(updatedAt).getTime() - new Date(createdAt).getTime();
+    if (Number.isFinite(ms) && ms >= 0) durationText = formatDurationSeconds(ms / 1000);
+  }
+  const adoptedText = thin.adopted_from === "brainstorm" ? "自头脑风暴转入" : "";
+  const chips: Array<[string, string, string]> = [
+    ["progress-thin-approval", approvalText, approvalClass],
+    ...(tasksText
+      ? ([["progress-thin-tasks", tasksText, "text-muted-foreground"]] as Array<[string, string, string]>) : []),
+    ...(substepsText
+      ? ([["progress-thin-substeps", substepsText, "text-muted-foreground"]] as Array<[string, string, string]>) : []),
+    ...(durationText
+      ? ([["progress-thin-duration", `总时长 ${durationText}`, "text-muted-foreground"]] as Array<[string, string, string]>) : []),
+    ...(adoptedText
+      ? ([["progress-thin-adopted", adoptedText, "text-muted-foreground"]] as Array<[string, string, string]>) : []),
+  ];
+  const aria = `轻量进度：${THIN_PHASE_ARIA[thin.phase] ?? thin.phase}；${chips.map(([, text]) => text).join("；")}`;
+
+  return (
+    <div data-testid="change-progress-row" data-variant="thin" aria-label={aria}
+      className="mt-1 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-[10px] leading-4">
+      {THIN_PHASE_STEPS.map((p, i) => {
+        const active = phasePos === p.key;
+        const pendingApproval = active && thin.phase === "awaiting_approval";
+        return (
+          <span key={p.key} className="flex items-center gap-1.5">
+            <span data-testid={`progress-thin-phase-${p.key}`}
+              className={pendingApproval ? "font-semibold text-warning" : active ? "font-semibold text-brand-600" : "text-muted-foreground"}>
+              {p.label}{pendingApproval ? "·待批准" : ""}
+            </span>
+            {i < THIN_PHASE_STEPS.length - 1 && (
+              <span aria-hidden className="text-muted-foreground">→</span>
+            )}
+          </span>
+        );
+      })}
+      {chips.map(([testid, text, cls]) => (
+        <span key={testid} data-testid={testid} className={cls}>{text}</span>
+      ))}
+    </div>
+  );
+}
+
+/**
+ * 进度行入口。归档变更不应挂载本组件（D-009 非目标，消费方 task-10 控制）；
+ * 升厚变更走全量支并保留「已升厚」标注（thin_flow 残留相位值不展示，盲区#9）。
+ */
+export function ChangeProgressRow({ change, createdAt }: ChangeProgressRowProps) {
+  const thin = change.thin_flow ?? null;
+  const upgraded = thin?.upgraded ?? false;
+  const useThinBranch = change.is_thin && !upgraded && change.change_type !== "quick";
+
+  if (useThinBranch) {
+    // 降级（FR-07/盲区#5）：旧 daemon 无 thin_flows 键 → 不渲染（现状保底）
+    if (!thin) return null;
+    return <ThinPhaseRow thin={thin} updatedAt={change.updated_at} createdAt={createdAt ?? null} />;
+  }
+  // 降级（FR-01 场景：畸形 latest_progress fail-open → null / 空数组）同样不渲染
+  const stages = change.stage_progress;
+  if (!stages || stages.length === 0) return null;
+  return (
+    <FullStageRow entries={stages} taskProgress={change.task_progress ?? null} upgraded={upgraded} />
+  );
+}

diff --git a/frontend/src/components/daemon/change-total-progress-ring.tsx b/frontend/src/components/daemon/change-total-progress-ring.tsx
new file mode 100644
--- /dev/null
+++ b/frontend/src/components/daemon/change-total-progress-ring.tsx
@@ -0,0 +1,188 @@
+"use client";
+
+/**
+ * 入口总进度圈（2026-10-26-session-change-progress-hover task-09 / FR-05 /
+ * D-003@v1 / D-013@v1）：悬浮框「变更」按钮旁仅露单个总进度圆环 + 中心百分比，
+ * 展示最新进行中（updated_at 最新非归档）变更的总完成度。
+ *
+ * - 双口径单源（design「接口定义·入口总进度圈口径」，两纯函数导出不散落）：
+ *   全量 = step_progress.steps_completed / step_total；
+ *   轻量 = 相位加权 spec=0.1 / awaiting_approval=0.15 /
+ *          executing=0.33 + 0.34×tasks_done/max(tasks_total,1) /
+ *          closing=0.67 + 0.33×substeps_done/8；
+ *   数据缺失（口径数据源缺失）→ null → 环不渲染（FR-07 降级，按钮区不受影响）。
+ * - 选取：pickLatestActive（纯函数导出，task-10 悬浮框侧调用）对 active 显式
+ *   updated_at 重排取最新——禁用后端列表序直接取首（后端序=未归档优先+
+ *   created_at desc，session-change-files-hover.tsx:63 注释，active[0] ≠
+ *   updated_at 最新，D-013@v1）；并列 updated_at 回退 change_key 码点序，
+ *   结果与输入顺序无关（盲区#6）。
+ * - 类型：task-01 契约已落 backend（backend/app/modules/change/schema.py
+ *   ThinFlowProgress / StepProgressSummary），api-types.ts 待 task-11
+ *   gen:types 再生成——生成前本组件手写最小结构视图（TotalProgressChange），
+ *   task-10 接线时传生成版 ChangeSummary 结构子类型兼容，task-11 落盘后
+ *   可切换为生成类型并删除本段手写视图。
+ * - 主题：色阶走语义 token 类（stroke-brand-500 / text-brand-600 / stroke-border
+ *   随 html data-theme 换肤），无裸 hex（FRONTEND_PAGE_STYLE §0.5 多主题铁律）。
+ */
+
+/**
+ * 轻量变更相位进度（task-11 gen:types 落地后切生成物——与 task-08 进度行
+ * 的 ThinFlowProgress 同源（生成物 components["schemas"]）；最小视图时期的
+ * 导出名保留，既有消费方 import 面零变化）。
+ */
+export type ThinFlowProgressLike = import("../daemon/change-progress-row").ThinFlowProgress;
+
+/**
+ * 总进度圈消费的变更最小结构视图（api-types 生成版 ChangeSummary 的结构
+ * 子类型；task-11 gen:types 落盘后调用方可直接传生成版类型）。
+ */
+export interface TotalProgressChange {
+  change_key: string;
+  updated_at: string;
+  is_thin: boolean;
+  /** 全量口径数据源（StepProgressSummary 消费子集） */
+  step_progress?: { step_total: number; steps_completed: number } | null;
+  /** 轻量口径数据源（旧 daemon 无该键 → null，环不渲染） */
+  thin_flow?: ThinFlowProgressLike | null;
+}
+
+/** 比值钳制 [0,1]——异常计数（completed>total / done>total）不出 >100% 或负值。 */
+function clamp01(v: number): number {
+  return Math.min(1, Math.max(0, v));
+}
+
+/**
+ * 总进度口径函数（单源导出，design FR-05）：
+ *
+ * - 分支优先级单源（FR-04 同款规则）：is_thin && thin_flow 存在且未升厚 →
+ *   轻量相位加权；否则（含升厚 upgraded）→ 全量步数比；
+ * - 全量：step_progress.steps_completed / step_total（缺失或 step_total=0 → null）；
+ * - 轻量：spec=0.1 / awaiting_approval=0.15 /
+ *   executing=0.33 + 0.34×tasks_done/max(tasks_total,1) /
+ *   closing=0.67 + 0.33×substeps_done/8（substeps_total 恒 8 定长）；
+ *   thin_flow 缺失（旧 daemon）或 phase 在归一枚举外 → null。
+ */
+export function computeTotalRatio(change: TotalProgressChange): number | null {
+  const thin = change.thin_flow ?? null;
+  // 轻量支：is_thin 且有 thin_flow 数据且未升厚（升厚走全量流程，D-007@v1）
+  if (change.is_thin && thin && !thin.upgraded) {
+    switch (thin.phase) {
+      case "spec":
+        return 0.1;
+      case "awaiting_approval":
+        return 0.15;
+      case "executing": {
+        // tasks_total=0 不除零：分母 max(,1) 兜底（0 勾选 → 0.33 相位基线）
+        const denom = Math.max(thin.tasks_total, 1);
+        return clamp01(0.33 + 0.34 * (thin.tasks_done / denom));
+      }
+      case "closing":
+        // SUBSTEPS 定长 8（sillyspec flow 收口子步），按契约公式字面分母
+        return clamp01(0.67 + 0.33 * (thin.substeps_done / 8));
+      default:
+        // backend 归一枚举外的透传值（fail-open）：无口径可算 → 不渲染
+        return null;
+    }
+  }
+  // 全量支（非 thin / thin 但缺数据 / 已升厚）
+  const sp = change.step_progress ?? null;
+  if (!sp || sp.step_total <= 0) return null;
+  return clamp01(sp.steps_completed / sp.step_total);
+}
+
+/** updated_at 解析（非法/缺失串 → 0 排最后，数据异常不崩排序）。 */
+function parseUpdatedTs(iso: string | null | undefined): number {
+  if (!iso) return 0;
+  const t = Date.parse(iso);
+  return Number.isNaN(t) ? 0 : t;
+}
+
+/**
+ * 目标变更选取函数（纯函数导出，D-013@v1）：active（非归档）中 updated_at
+ * 最新一个。显式 [...active].sort 重排，不信任后端返回序（未归档优先+
+ * created_at desc ≠ updated_at 最新）；并列 updated_at 次序键回退 change_key
+ * 码点升序（不用 localeCompare——避免 ICU/locale 差异引入平台不确定性），
+ * 保证选取结果与输入顺序无关（盲区#6）。空数组 → null。
+ */
+export function pickLatestActive<T extends TotalProgressChange>(
+  active: readonly T[],
+): T | null {
+  if (active.length === 0) return null;
+  const sorted = [...active].sort((a, b) => {
+    const ta = parseUpdatedTs(a.updated_at);
+    const tb = parseUpdatedTs(b.updated_at);
+    if (ta !== tb) return tb - ta; // updated_at desc（最新在前）
+    if (a.change_key !== b.change_key) {
+      // 并列回退：change_key 码点升序（确定性，与输入顺序无关）
+      return a.change_key < b.change_key ? -1 : 1;
+    }
+    return 0;
+  });
+  return sorted[0] ?? null;
+}
+
+/** 圆环几何常量：viewBox 24×24、r=10、strokeWidth=3（紧凑 h-6 w-6 级）。 */
+const RING_RADIUS = 10;
+const RING_CIRCUMFERENCE = 2 * Math.PI * RING_RADIUS;
+
+export interface ChangeTotalProgressRingProps {
+  /** 目标变更（task-10 悬浮框侧经 pickLatestActive 选取后传入） */
+  change: TotalProgressChange;
+}
+
+/**
+ * 单个总进度圆环 + 中心百分比（紧凑尺寸，挂悬浮按钮旁）。
+ * ratio 经 computeTotalRatio 得 null（数据缺失）→ 返回 null 不渲染（FR-05
+ * 降级：入口按钮与计数徽标照常，环位不占空间）。进度文本化进 aria-label
+ * （R-05 无障碍），中心文字对读屏隐藏避免重复播报。
+ */
+export function ChangeTotalProgressRing({ change }: ChangeTotalProgressRingProps) {
+  const ratio = computeTotalRatio(change);
+  if (ratio === null) return null;
+
+  const pct = Math.round(ratio * 100);
+  const dash = RING_CIRCUMFERENCE * ratio;
+
+  return (
+    <span
+      data-testid="change-total-progress-ring"
+      role="img"
+      aria-label={`变更总进度 ${pct}%`}
+      title={`${change.change_key} 总进度 ${pct}%`}
+      className="relative inline-flex h-6 w-6 shrink-0 items-center justify-center"
+    >
+      {/* -rotate-90：dasharray 默认 3 点方向起笔，转 12 点方向顺时针填充 */}
+      <svg viewBox="0 0 24 24" className="h-6 w-6 -rotate-90" aria-hidden="true">
+        {/* 轨道底环（border 语义 token，随主题换肤） */}
+        <circle
+          cx="12"
+          cy="12"
+          r={RING_RADIUS}
+          fill="none"
+          strokeWidth="3"
+          className="stroke-border"
+        />
+        {/* 进度弧（brand 语义阶主色环，随主题换肤） */}
+        <circle
+          data-testid="change-total-progress-ring-arc"
+          cx="12"
+          cy="12"
+          r={RING_RADIUS}
+          fill="none"
+          strokeWidth="3"
+          strokeLinecap="round"
+          strokeDasharray={`${dash} ${RING_CIRCUMFERENCE}`}
+          className="stroke-brand-500"
+        />
+      </svg>
+      {/* 中心百分比文字（叠环中心；tabular-nums 防跳宽；读屏由容器 aria-label 承担） */}
+      <span
+        data-testid="change-total-progress-ring-percent"
+        aria-hidden="true"
+        className="absolute inset-0 flex items-center justify-center text-[8px] font-bold leading-none tabular-nums text-brand-600 dark:text-brand-300"
+      >
+        {pct}%
+      </span>
+    </span>
+  );
+}

