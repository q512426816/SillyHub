-  const lw=ctx.measureText(label).width+44;
-  let bx=clamp(sx-lw/2,40,1880-lw-40);
-  const by=ly-40;
-  ctx.fillStyle='rgba(10,6,24,.92)'; ctx.strokeStyle=withAlpha(C.cyanL,.7); ctx.lineWidth=1.6;
-  roundRect(ctx,bx,by,lw,52,26); ctx.fill(); ctx.stroke();
-  ctx.fillStyle=withAlpha(C.text,.97); ctx.textAlign='center'; ctx.textBaseline='middle';
-  ctx.fillText(label,bx+lw/2,by+27);
-  ctx.restore();
-}
