-  { id:'agents', t0:49, t1:63, name:'12 宿主 · 一套编排' },
-  { id:'live',   t0:63, t1:75, name:'实时可视' },
-  { id:'team',   t0:75, t1:87, name:'团队与安全' },
-  { id:'outro',  t0:87, t1:98, name:'启程' },
