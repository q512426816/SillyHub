-const FONT_MONO='"JetBrains Mono","Cascadia Code",Consolas,"SF Mono",Menlo,monospace';
-function setFont(ctx,size,weight,mono){ ctx.font=`${weight||400} ${size}px ${mono?FONT_MONO:FONT_SANS}`; }
-/* 带字距的文本（逐字绘制，跨浏览器可靠） */
