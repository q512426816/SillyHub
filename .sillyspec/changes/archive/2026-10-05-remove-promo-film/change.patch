-/* ============================================================================
- * 各幕场景
- * ==========================================================================*/
-function sceneShots(t,T,alpha,chId){
-  const ch=CHAPTERS.find(c=>c.id===chId);
-  const shots=SHOTS[chId];
-  const total=ch.t1-ch.t0;
-  const n=shots.length;
-  /* 镜头时长支持权重 d（缺省 1）；boundaries[i] 为镜头 i 的起始时刻 */
-  const ws=shots.map(s=>s.d||1), W=ws.reduce((a,b)=>a+b,0);
-  const bounds=[0]; ws.reduce((a,w,i)=>{ const v=a+w; bounds.push(v); return v; },0);
-  const boundsT=bounds.map(v=>v/W*total);
-  let idx=0; for(let i=0;i<n;i++){ if(t>=boundsT[i]) idx=i; }
-  const lt=t-boundsT[idx], seg=boundsT[idx+1]-boundsT[idx];
-  const s=shots[idx];
-  let a=alpha;
-  if(n>1){
-    a*= smooth(boundsT[idx]-0.1, boundsT[idx]+.7, t) * (1-smooth(boundsT[idx+1]-.7,boundsT[idx+1]-.02,t));
-    if(idx===0) a=alpha*smooth(-0.1,.6,t)*(1-smooth(seg-.7,seg-.02,t));
-    if(idx===n-1) a=alpha*smooth(boundsT[idx]-.1,boundsT[idx]+.7,t)*(1-smooth(total-.7,total,t));
-  }
-  const p=sat(lt/seg);
-  const z=lerp(s.z0,s.z1,easeInOut(p));
-  const px=lerp(s.px0,s.px1,easeInOut(p)), py=lerp(s.py0,s.py1,easeInOut(p));
-  drawBrowserFrame(a,s.url);
-  const st=drawShotImage(assetOf(s),z,px,py,a);
-  /* 高亮 */
-  const hls=HIGHLIGHTS[chId]||[];
-  for(const h of hls){ drawHighlight(h,st,t,a); }
-  return st;
-}
