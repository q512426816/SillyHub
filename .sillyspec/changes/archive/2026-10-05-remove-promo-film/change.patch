-<script>
-"use strict";
-/* ============================================================================
- * SillyHub 平台宣传片 V2 —— 真实产品演示版
- * 11 幕 300 秒：主角为线上环境真实界面截图（浏览器窗口框 + Ken Burns + 高亮标注）
- * 性能架构：静态层缓存 / 辉光精灵贴图（渲染循环零 shadowBlur）/ 隔帧颗粒 /
- *           自适应画质三档 + 帧率自动降级
- * 画面 = 主时钟 T 的确定性函数，seek 精确重放。
- * ==========================================================================*/
-
-const DUR = 300;
-const HOST = 'crrcdt.ppdmq.top';
-const WS = 'b97f8231-9404-43bd-89de-38c281c4d875';
-
-/* ---------- 色板 ---------- */
-const C = {
-  violet:'#7C3AED', violetL:'#A78BFA', violetD:'#4C1D95',
-  cyan:'#0891B2', cyanL:'#22D3EE', text:'#EDE9FE', dim:'#9d93bd', faint:'#5e567e',
-  red:'#ef4444', amber:'#f59e0b', green:'#10b981', white:'#f8fafc',
-};
-const FONT_SANS='"PingFang SC","Microsoft YaHei","Noto Sans SC","Source Han Sans SC",sans-serif';
-const FONT_MONO='"JetBrains Mono","Cascadia Code",Consolas,"SF Mono",Menlo,monospace';
-
-/* ---------- 工具 ---------- */
-const TAU=Math.PI*2;
-const clamp=(v,a,b)=>v<a?a:v>b?b:v;
-const lerp=(a,b,t)=>a+(b-a)*t;
-const sat=v=>clamp(v,0,1);
-const easeInOut=t=>t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
-const easeOut=t=>1-Math.pow(1-t,3);
-const smooth=(a,b,v)=>{const t=sat((v-a)/(b-a));return t*t*(3-2*t);};
-function hash(n){ n=Math.imul(n^(n>>>15),2246822519); n=Math.imul(n^(n>>>13),3266489917); return ((n^(n>>>16))>>>0)/4294967296; }
-const h1=i=>hash(i*7349+13), h2=i=>hash(i*9151+37);
-function withAlpha(hex,a){ const n=parseInt(hex.slice(1),16); return `rgba(${n>>16&255},${n>>8&255},${n&255},${a})`; }
-function setFont(ctx,size,weight,mono){ ctx.font=`${weight||400} ${size}px ${mono?FONT_MONO:FONT_SANS}`; }
-function roundRect(ctx,x,y,w,h,r){ r=Math.min(r,w/2,h/2); ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }
-/* 带字距文本（宽度按 key 缓存，避免每帧 measureText） */
-const _spCache=new Map();
-function spacedWidth(ctx,text,size,weight,mono,spacing){
-  const key=`${text}|${size}|${weight}|${mono}|${spacing}`;
-  let w=_spCache.get(key);
-  if(w===undefined){
-    setFont(ctx,size,weight,mono);
-    w=[...text].reduce((a,ch)=>a+ctx.measureText(ch).width,0)+spacing*( [...text].length-1);
-    _spCache.set(key,w);
-  }
-  return w;
-}
-function spacedText(ctx,text,cx,y,size,weight,color,spacing,mono,align){
-  setFont(ctx,size,weight,mono);
-  const w=spacedWidth(ctx,text,size,weight,mono,spacing);
-  let x = align==='left'? cx : align==='right'? cx-w : cx-w/2;
-  ctx.fillStyle=color; ctx.textBaseline='alphabetic'; ctx.textAlign='left';
-  let cx0=x;
-  for(const ch of text){ ctx.fillText(ch,cx0,y); cx0+=ctx.measureText(ch).width+spacing; }
-  return w;
-}
-
-/* ============================================================================
- * 画布 · 坐标 · 画质
- * ==========================================================================*/
-const canvas=document.getElementById('film');
-const ctx=canvas.getContext('2d');
-const QUALITY={ high:{dpr:2,grain:true,stars:150}, balanced:{dpr:1.35,grain:true,stars:110}, eco:{dpr:1,grain:false,stars:70} };
-let quality='balanced', dprCap=QUALITY.balanced.dpr;
-let dpr=1, fit=1, ox=0, oy=0;
-
-/* ---------- 图片资产池 ---------- */
-const ASSETS={
-  login:'login.jpg', wsList:'ws-list.jpg', addWs:'add-workspace.jpg', onboard:'ws-onboarding.jpg',
-  wsHome:'ws-home.jpg', scan:'scan-docs.jpg', topo:'topology.jpg',
-  changes:'changes.jpg', changesArc:'changes-archived.jpg', detail:'change-detail.jpg',
-  sessions:'sessions.jpg', presession:'presession.jpg',
-  groupchat:'groupchat.jpg', members:'groupchat-members.jpg', plus:'plus-menu.jpg', team:'team-popover.jpg', fork:'fork.jpg',
-  runtimes:'runtimes.jpg', panel:'session-panel.jpg', logs:'local-agent-logs.jpg',
-  approvals:'approvals.jpg',
-  ppmProjects:'ppm-projects.jpg', ppmPlan:'ppm-plannodes.jpg', ppmKanban:'ppm-kanban.jpg', ppmProblems:'ppm-problems.jpg',
-  profiles:'agent-profiles.jpg', knowledge:'knowledge.jpg', releases:'releases.jpg',
-};
-const IMG={}; let imgLoaded=0, imgTotal=0;
-for(const k of Object.keys(ASSETS)){
-  const im=new Image(); imgTotal++;
-  im.onload=()=>{ imgLoaded++; updateLoadInfo(); };
-  im.onerror=()=>{ imgLoaded++; updateLoadInfo(); };   /* 加载失败不阻塞：骨架照常显示 */
-  im.src='assets/'+ASSETS[k];
-  IMG[k]=im;
-}
-function updateLoadInfo(){
-  const el=document.getElementById('loadInfo');
-  if(imgLoaded>=imgTotal){ el.textContent='界面素材就绪 ✓ 28 / 28'; }
-  else el.textContent=`界面素材准备中… ${imgLoaded} / ${imgTotal}`;
-}
-
-/* ---------- 静态层缓存（背景 / 遮幅+暗角 覆盖层） ---------- */
-let bgLayer=null, ovLayer=null;
-function buildStaticLayers(){
-  const W=Math.round(1920*fit*dpr), H=Math.round(1080*fit*dpr);
-  /* 背景：深空渐变 + 星野 */
-  bgLayer=document.createElement('canvas'); bgLayer.width=W; bgLayer.height=H;
-  const b=bgLayer.getContext('2d');
-  const g=b.createRadialGradient(W*.5,H*.38,80*fit*dpr,W*.5,H*.5,1300*fit*dpr);
-  g.addColorStop(0,'#120a28'); g.addColorStop(.45,'#0a0618'); g.addColorStop(1,'#030109');
-  b.fillStyle=g; b.fillRect(0,0,W,H);
-  const stars=QUALITY[quality].stars;
-  for(let i=0;i<stars;i++){
-    const x=h1(i)*W, y=h2(i)*H, s=(h2(i)<.92?1.4:2.4)*fit*dpr;
-    b.fillStyle=withAlpha(h2(i)<.75?C.white:C.cyanL,.12+.4*h1(i*3));
-    b.fillRect(x,y,s,s);
-  }
-  /* 覆盖层：遮幅 + 暗角（画在场景之上） */
-  ovLayer=document.createElement('canvas'); ovLayer.width=W; ovLayer.height=H;
-  const o=ovLayer.getContext('2d');
-  const v=o.createRadialGradient(W*.5,H*.5,440*fit*dpr,W*.5,H*.5,1180*fit*dpr);
-  v.addColorStop(0,'rgba(0,0,0,0)'); v.addColorStop(1,'rgba(0,0,0,.5)');
-  o.fillStyle=v; o.fillRect(0,0,W,H);
-  o.fillStyle='#000';
-  o.fillRect(0,0,W,Math.round(78*fit*dpr)); o.fillRect(0,H-Math.round(78*fit*dpr),W,Math.round(78*fit*dpr));
