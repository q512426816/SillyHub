-/* ---------- 色板（AI-Native 品牌血缘） ---------- */
-const C = {
-  ink:'#05030c', violet:'#7C3AED', violetL:'#A78BFA', violetD:'#4C1D95',
-  cyan:'#0891B2', cyanL:'#22D3EE', text:'#EDE9FE', dim:'#9d93bd', faint:'#5e567e',
-  red:'#ef4444', amber:'#f59e0b', green:'#10b981', white:'#f8fafc',
-};
-
-/* ---------- 工具函数 ---------- */
-const TAU = Math.PI*2;
-const clamp=(v,a,b)=>v<a?a:v>b?b:v;
-const lerp=(a,b,t)=>a+(b-a)*t;
-const sat=v=>clamp(v,0,1);
-const easeInOut=t=>t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
-const easeOut=t=>1-Math.pow(1-t,3);
-const easeOutExpo=t=>t>=1?1:1-Math.pow(2,-10*t);
-const easeInCubic=t=>t*t*t;
-const smooth=(a,b,v)=>{const t=sat((v-a)/(b-a));return t*t*(3-2*t);};
-/* 整数哈希 → [0,1)：种子化确定性随机（保证 seek 后画面可精确重放） */
-function hash(n){ n=Math.imul(n^(n>>>15),2246822519); n=Math.imul(n^(n>>>13),3266489917); return ((n^(n>>>16))>>>0)/4294967296; }
-const h1=i=>hash(i*7349+13), h2=i=>hash(i*9151+37), h3=i=>hash(i*4909+101), h4=i=>hash(i*3253+77);
-function withAlpha(hex,a){ const n=parseInt(hex.slice(1),16); return `rgba(${n>>16&255},${n>>8&255},${n&255},${a})`; }
