-/* 高亮框 + 标注气泡（截图坐标 → 舞台坐标） */
-function drawHighlight(h,st,p,alpha){
-  const fade=smooth(h.t0,h.t0+.5,p)*(1-smooth(h.t1-.5,h.t1,p));
-  if(fade<=0) return;
-  /* 截图坐标 → 舞台坐标（与 drawShotImage 同一变换） */
-  const sx=st.cx+(h.x+h.w/2-960)*st.s, sy=st.cy+(h.y+h.h/2-540)*st.s;
-  const rw=h.w*st.s, rh=h.h*st.s;
-  const grow=easeOut(sat(fade*1.6));
-  ctx.save(); ctx.globalAlpha=alpha*fade;
-  const pulse=.7+.3*Math.sin(performance.now()/300);
-  ctx.strokeStyle=withAlpha(C.cyanL,.95); ctx.lineWidth=3;
-  ctx.fillStyle=withAlpha(C.cyanL,.10+.05*pulse);
-  roundRect(ctx, sx-rw/2*grow, sy-rh/2*grow, rw*grow, rh*grow, 14); ctx.fill(); ctx.stroke();
-  /* 四角刻度 */
-  ctx.strokeStyle=withAlpha('#ffffff',.9); ctx.lineWidth=3;
-  const cl=16, ex=sx-rw/2*grow, ey=sy-rh/2*grow, ew=rw*grow, eh=rh*grow;
-  [[ex,ey,1,1],[ex+ew,ey,-1,1],[ex,ey+eh,1,-1],[ex+ew,ey+eh,-1,-1]].forEach(([cx0,cy0,dx,dy])=>{
-    ctx.beginPath(); ctx.moveTo(cx0+dx*cl,cy0); ctx.lineTo(cx0,cy0); ctx.lineTo(cx0,cy0+dy*cl); ctx.stroke();
-  });
-  drawGlow(sx,sy,Math.max(rw,rh)*.6,'cyan',.10*fade);
-  /* 标注气泡 */
-  const label=h.label, ly=(h.ly!==undefined)? sy+rh/2*grow+h.ly : sy-rh/2*grow-34;
