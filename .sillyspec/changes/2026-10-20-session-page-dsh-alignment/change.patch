index 000000000..3bfbee4f0
--- /dev/null
+++ b/frontend/src/components/daemon/file-changes/file-changes-summary.tsx
@@ -0,0 +1,262 @@
+"use client";
+
+/**
+ * 会话级「文件改动汇总卡」（task-11 / 2026-10-20-session-page-dsh-alignment 线 C
+ * 「1b 第三段」）。
+ *
+ * 依据：`design.md`「### 文件变更卡 DTO」+ 生命周期契约表 **E7 会话级汇总**——
+ * 「去重后的 `files` 与 Σ`added`/Σ`deleted`、`status` 最差值」；R-08 要求「共享
+ * 工作区恒标『可能含并行会话改动』」（并行会话的改动无法按会话拆分，D-023 已接受）。
+ *
+ * 形态：一行折叠头（文件图标 + 「会话文件改动」+ 共 N 个文件 + Σ+/− + 状态注记），
+ * 下方恒显两行以内的说明（并行会话横幅 + 不完整时的不完整原因）。**不重复轮级卡
+ * 的逐文件列表**——逐文件明细属于轮级卡，汇总只回答「整个会话一共改了多少」。
+ *
+ * 约束（与轮级卡同源）：
+ * - **props only**：零 fetch / 零 store / 零 context，聚合纯函数现算；
+ * - 只用语义 token，零字面色值；文案中文；
+ * - `status` 取最差值（`unavailable > failed > partial > ok`）；任一参与轮缺快照
+ *   （`capability="tool_only"` / 无快照）时汇总**至少降为 partial** 并显式标注
+ *   「N 轮无工作区快照」——「统计不完整」绝不能被读成「没有改动」（E6/E8）；
+ * - 无数据（无文件且无降级轮）不渲染，不出空壳。
+ */
+
+import { useMemo } from "react";
+import { Files } from "lucide-react";
+
+import { cn } from "@/lib/utils";
+import type { FileChangesCapability } from "./file-changes-card";
+import type { TurnFileChange, TurnFileChangesSnapshot } from "./turn-file-changes";
+
+/** 汇总状态口径：与单轮快照 status 同一词表。 */
+export type FileChangesSummaryStatus = "ok" | "partial" | "failed" | "unavailable";
+
+/** 参与汇总的一轮：快照（可空）+ 能力档（可空）。 */
+export interface FileChangesSummaryEntry {
+  snapshot: TurnFileChangesSnapshot | null;
+  capability?: FileChangesCapability | null;
+}
+
+/** 去重后的单文件行（同 path 多轮取并集，+/− 各自求和）。 */
+export interface AggregatedFileChange {
+  path: string;
+  adds: number;
+  dels: number;
+  edits: number;
+  /** 任一轮归因为命令行/脚本改动 → shell（更保守：不把 git 侧改动说成工具编辑）。 */
+  source: "tool" | "shell";
+  /** 任一轮报二进制 → 行级统计不可信。 */
+  binary: boolean;
+}
+
+/** 状态严重度（数值越大越差）：`unavailable > failed > partial > ok`。 */
+export const FILE_CHANGES_STATUS_RANK: Record<FileChangesSummaryStatus, number> = {
+  ok: 0,
+  partial: 1,
+  failed: 2,
+  unavailable: 3,
+};
+
+/** 取最差状态（空集合 → null）。 */
+export function worstFileChangesStatus(
+  statuses: ReadonlyArray<FileChangesSummaryStatus>,
+): FileChangesSummaryStatus | null {
+  let worst: FileChangesSummaryStatus | null = null;
+  for (const status of statuses) {
+    if (worst === null || FILE_CHANGES_STATUS_RANK[status] > FILE_CHANGES_STATUS_RANK[worst]) {
+      worst = status;
+    }
+  }
+  return worst;
+}
+
+export interface AggregatedFileChanges {
+  files: AggregatedFileChange[];
+  totalFiles: number;
+  totalAdds: number;
+  totalDels: number;
+  /** 汇总状态（无任何可信快照 → null）。 */
+  status: FileChangesSummaryStatus | null;
+  /** 无工作区快照的轮数（capability=tool_only / 快照缺失）——汇总不完整的量。 */
+  degradedTurns: number;
+  /** 参与汇总的轮数（有快照的轮 + 降级轮）。 */
+  consideredTurns: number;
+  /** 任一轮快照被截断/超时（行级统计为下限）。 */
+  truncated: boolean;
+}
+
+/**
+ * 多轮快照聚合（纯函数）：按 `path` 去重、+/− 求和、状态取最差值。
+ *
+ * 降级轮（`snapshot == null` 或 `capability="tool_only"`）不伪造文件行，只计入
+ * `degradedTurns` 并把汇总状态压到至少 `partial`——覆盖不完整必须显式可见。
+ */
+export function aggregateTurnFileChanges(
+  entries: ReadonlyArray<FileChangesSummaryEntry>,
+): AggregatedFileChanges {
+  const byPath = new Map<string, AggregatedFileChange>();
+  const statuses: FileChangesSummaryStatus[] = [];
+  let degradedTurns = 0;
+  let truncated = false;
+  let consideredTurns = 0;
+
+  for (const entry of entries) {
+    const snapshot = entry.snapshot ?? null;
+    const capability = entry.capability ?? null;
+    // 完全未接线（两字段都缺）的轮不参与汇总——既不贡献数据也不算降级。
+    if (snapshot == null && capability == null) continue;
+    consideredTurns += 1;
+    if (snapshot == null || capability === "tool_only") {
+      degradedTurns += 1;
+      continue;
+    }
+    statuses.push(snapshot.status);
+    if (snapshot.status === "partial" || snapshot.truncated === true) truncated = true;
+    if (snapshot.status !== "ok" && snapshot.status !== "partial") continue;
+    for (const file of snapshot.files ?? []) {
+      mergeFile(byPath, file);
+    }
+  }
+
+  if (degradedTurns > 0) statuses.push("partial");
+  const status = worstFileChangesStatus(statuses);
+
+  const files = [...byPath.values()].sort((a, b) => a.path.localeCompare(b.path));
+  return {
+    files,
+    totalFiles: files.length,
+    totalAdds: files.reduce((sum, file) => sum + file.adds, 0),
+    totalDels: files.reduce((sum, file) => sum + file.dels, 0),
+    status,
+    degradedTurns,
+    consideredTurns,
+    truncated,
+  };
+}
+
+/** 单文件并入（同 path 取并集：+/− 与编辑次数求和，来源/二进制按「更保守」升级）。 */
+function mergeFile(
+  byPath: Map<string, AggregatedFileChange>,
+  file: TurnFileChange,
+): void {
+  const toolEdited = file.attribution === "edit_patch";
+  const edits = toolEdited ? (file.editToolNames?.length ?? 1) : 0;
+  const previous = byPath.get(file.path);
+  if (previous == null) {
+    byPath.set(file.path, {
+      path: file.path,
+      adds: file.added,
+      dels: file.deleted,
+      edits,
+      source: toolEdited ? "tool" : "shell",
+      binary: file.binary === true,
+    });
+    return;
+  }
+  previous.adds += file.added;
+  previous.dels += file.deleted;
+  previous.edits += edits;
+  if (!toolEdited) previous.source = "shell";
+  if (file.binary === true) previous.binary = true;
+}
+
+/** 汇总状态 → 一句人话（ok 不注记——注记只讲「为什么不可全信」）。 */
+export function fileChangesSummaryNote(
+  status: FileChangesSummaryStatus | null,
+): string | null {
+  switch (status) {
+    case "partial":
+      return "部分轮次快照不完整（超时/截断），行级统计为下限";
+    case "failed":
+      return "部分轮次快照采集失败，汇总不完整";
+    case "unavailable":
+      return "部分轮次无法采集工作区快照（git 不可用/非 git 仓）";
+    default:
+      return null;
+  }
+}
+
+export interface FileChangesSummaryProps {
+  /** 各轮快照（顺序无关；未接线的轮可原样带入，聚合时跳过）。 */
+  turns: ReadonlyArray<FileChangesSummaryEntry>;
+  className?: string;
+}
+
+export function FileChangesSummary({ turns, className }: FileChangesSummaryProps) {
+  const agg = useMemo(() => aggregateTurnFileChanges(turns), [turns]);
+
+  // 无数据不渲染：没有文件、也没有「某轮缺快照」要说的事。
+  if (agg.totalFiles === 0 && agg.degradedTurns === 0) return null;
+
+  const note = fileChangesSummaryNote(agg.status);
+  const statusLabel =
+    agg.status === "unavailable"
+      ? "快照不可用"
+      : agg.status === "failed"
+        ? "采集失败"
+        : agg.status === "partial"
+          ? "统计不完整"
+          : "完整";
+
+  return (
+    <div
+      data-testid="file-changes-summary"
+      data-status={agg.status ?? "unknown"}
+      data-total-files={agg.totalFiles}
+      data-degraded-turns={agg.degradedTurns}
+      className={cn(
+        "rounded-md border border-border bg-card px-2 py-1.5 text-[12px]",
+        className,
+      )}
+    >
+      <div className="flex h-6 items-center gap-1.5">
+        <Files className="h-3.5 w-3.5 shrink-0 text-muted-foreground" aria-hidden />
+        <span className="shrink-0 font-medium text-foreground">会话文件改动</span>
+        <span className="shrink-0 text-[11px] text-muted-foreground">
+          共 {agg.totalFiles} 个文件
+        </span>
+        <span className="ml-auto flex shrink-0 items-center gap-1.5 font-mono text-[11.5px] tabular-nums">
+          {agg.status === "ok" || agg.status === "partial" ? (
+            <>
+              <span className="text-success">+{agg.totalAdds}</span>
+              <span className="text-error">−{agg.totalDels}</span>
+            </>
+          ) : (
+            // 快照整体不可信（failed/unavailable）：不拿残缺累加冒充总数。
+            <span className="text-muted-foreground" title="快照不可用：无汇总统计">
+              —
+            </span>
+          )}
+          <span
+            data-testid="file-changes-summary-status"
+            className="text-[10.5px] font-normal text-muted-foreground"
+            title="汇总状态：ok < partial < failed < unavailable 取最差值"
+          >
+            {statusLabel}
+          </span>
+        </span>
+      </div>
+
+      {/* R-08：并行会话归属不可分（D-023 已接受）——横幅恒显，不做按轮开关。 */}
+      <p
+        data-testid="file-changes-summary-banner"
+        className="text-[11px] leading-[1.4] text-muted-foreground/80"
+      >
+        共享工作区，可能含并行会话改动
+      </p>
+
+      {agg.degradedTurns > 0 && (
+        <p
+          data-testid="file-changes-summary-degraded"
+          className="text-[11px] leading-[1.4] text-muted-foreground/80"
+        >
+          其中 {agg.degradedTurns} 轮无工作区快照（仅工具编辑），汇总不完整
+        </p>
+      )}
+
+      {note != null && agg.degradedTurns === 0 && (
+        <p className="text-[11px] leading-[1.4] text-muted-foreground/80">{note}</p>
+      )}
+    </div>
+  );
+}
diff --git a/frontend/src/components/daemon/file-changes/turn-file-changes.ts b/frontend/src/components/daemon/file-changes/turn-file-changes.ts
new file mode 100644
index 000000000..6350c9e92
--- /dev/null
+++ b/frontend/src/components/daemon/file-changes/turn-file-changes.ts
@@ -0,0 +1,220 @@
+/**
+ * 轮工作区快照 → 卡片 props 的**纯映射**（task-11 / 2026-10-20-session-page-dsh-alignment
+ * 线 C「1b 第三段」）。零 DOM / 零 React / 零 fetch / 零 store。
+ *
+ * 依据：
+ * - `.sillyspec/changes/2026-10-20-session-page-dsh-alignment/design.md`
+ *   「### 文件变更卡 DTO」`TurnFileChangesSnapshot` 契约要点：
+ *   ① `attribution="edit_patch"` → `source="tool"`、其余 `"command"` → `source="shell"`；
+ *   ② `partial` **不是错误态**——卡片照出，行级 +/− 退化为破折号；
+ *   ③ `binary=true` 行同样破折号（numstat 对二进制是 0/0，不能显示成「+0 −0」）；
+ *   ④ `capability` 独立成字段，前端**只看 capability、不看字段是否存在**（E6/E8）：
+ *      「没有快照」绝不能被渲染成「本轮无改动」。
+ * - 「### 1b 承载面与读模型字段」：读模型用顶层 snake_case
+ *   `file_changes` / `file_changes_capability`，嵌套快照体是 camelCase。
+ *
+ * 三态降级（本模块的裁决口径，逐条对应 design E6/E8）：
+ * | 输入 | 输出 |
+ * |---|---|
+ * | `capability` 与 `snapshot` 双双缺省 | `null`——读模型没接线/该轮无 run 快照，**不出卡、不出占位** |
+ * | `capability="tool_only"` | 降级态 `{ degraded: true, files: [] }` → 「仅工具编辑」卡 |
+ * | `snapshot=null`（capability 已给） | 同上（显式降级，不静默） |
+ * | `status="failed" \| "unavailable"` | 同上（git 不可用 / 非 git 仓：行级数据不可信，不伪造 files） |
+ * | `status="partial"` 或 `truncated=true` | 正常卡 + `truncated: true`（行级破折号） |
+ * | `status="ok"` 且 `files` 为空 | `null`（确认无改动的快照 → 零渲染空态，不写「本轮无改动」文案） |
+ */
+
+import type { components } from "@/lib/api-types";
+
+import type {
+  ChangedFile,
+  FileChangesCapability,
+  FileChangesCardProps,
+} from "./file-changes-card";
+
+/** 后端轮次读模型里的快照形状（`SessionRunRead.file_changes`，生成物已含）。 */
+export type TurnFileChangesSnapshot = components["schemas"]["TurnFileChangesSnapshot"];
+/** 快照内的单文件行。 */
+export type TurnFileChange = components["schemas"]["TurnFileChange"];
+export type { FileChangesCapability };
+
+/** `toFileChangesCardProps` 的可选透传参数（挂载面提供，不参与判定）。 */
+export interface TurnFileChangesCardOptions {
+  /** 轮次号（卡片折叠头「第 N 轮」）。 */
+  turnNo?: number;
+  /** 行点击打开文件（缺省＝行不可跳转，原型同款可选回调）。 */
+  onOpenFile?: (_path: string) => void;
+  className?: string;
+}
+
+/**
+ * partial 且无文件列表时的提示文案（D-034）。
+ *
+ * 语义边界：说的是「没拿到改动清单」，**不是**「本轮没改文件」——后者是 E6/E8 明令
+ * 禁止的伪值。超时与队列溢出在快照层面同为 `status="partial"`（daemon 端不区分
+ * files 内容），故文案合并表述；精确 `reason` 仍保留在快照里供检查器读取。
+ */
+export const NOTICE_PARTIAL_NO_FILES = "工作区快照未完成（超时或队列溢出），本轮改动未知";
+
+/**
+ * 读模型里与文件变更相关的两字段（后端 `SessionRunRead` 已透传）。
+ *
+ * 前端手工维护的镜像 `frontend/src/lib/daemon/sessions.ts` 的 `SessionRunRead`
+ * 尚未补这两列（该文件在本任务 allowed_paths 之外）——用**结构化可选字段**读取，
+ * 既不改它，也不影响它回补后的类型收窄。
+ */
+export interface RunFileChangesFields {
+  file_changes?: TurnFileChangesSnapshot | null;
+  file_changes_capability?: FileChangesCapability | null;
+}
+
+/** 可承载文件变更字段的轮视图（结构类型，不依赖 turn-timeline，避免循环 import）。 */
+export interface FileChangesTurnFields {
+  runId: string;
+  realRunId?: string;
+  fileChanges?: TurnFileChangesSnapshot | null;
+  fileChangesCapability?: FileChangesCapability | null;
+}
+
+/** 单文件行映射：归因 → 来源；`edits` 取 `editToolNames` 条数（无工具名按 1 条计）。 */
+export function toChangedFile(file: TurnFileChange): ChangedFile {
+  const toolEdited = file.attribution === "edit_patch";
+  const toolNames = toolEdited ? (file.editToolNames ?? undefined) : undefined;
+  return {
+    path: file.path,
+    adds: file.added,
+    dels: file.deleted,
+    // command 归因的行没有「本轮编辑次数」概念——填 0，卡片对 edits<=0 不出「改N次」。
+    edits: toolEdited ? (toolNames?.length ?? 1) : 0,
+    source: toolEdited ? "tool" : "shell",
+    ...(file.binary === true ? { binary: true } : {}),
+    ...(toolNames != null && toolNames.length > 0 ? { editToolNames: toolNames } : {}),
+  };
+}
+
+/** 降级态 props：「仅工具编辑」卡（零 files，禁伪造行级数据）。 */
+function degradedProps(
+  snapshot: TurnFileChangesSnapshot | null,
+  options: TurnFileChangesCardOptions,
+): FileChangesCardProps {
+  return {
+    files: [],
+    degraded: true,
+    capability: "tool_only",
+    turnNo: options.turnNo,
+    // 快照可能是 failed/unavailable（存在但不可信）：共享工作区提示仍如实透传。
+    sharedWorkspace: snapshot?.concurrentSessionsHint === true,
+    onOpenFile: options.onOpenFile,
+    className: options.className,
+  };
+}
+
+/**
+ * 轮快照 + capability → 卡片 props（`null` = 不出卡、不出占位）。
+ *
+ * 判定顺序即上表：先看「有没有这项能力」，再看「快照可信不可信」，最后才谈行级数据。
+ */
+export function toFileChangesCardProps(
+  snapshot: TurnFileChangesSnapshot | null | undefined,
+  capability: FileChangesCapability | null | undefined,
+  options: TurnFileChangesCardOptions = {},
+): FileChangesCardProps | null {
+  // 未接线：两个字段都缺（旧消费方 / 该轮无 run 快照来源）——不出卡也不出占位。
+  if (snapshot == null && capability == null) return null;
+  // E8：capability 明确为 tool_only＝daemon 不提供工作区快照能力 → 显式降级。
+  if (capability === "tool_only") return degradedProps(snapshot ?? null, options);
+  // 有 capability 却无快照（backend 声称 full 但没数据）：按 E6/E8 降级，不静默。
+  if (snapshot == null) return degradedProps(null, options);
+  // 采集失败 / git 不可用：行级统计不可信（不伪造 files）。
+  if (snapshot.status === "failed" || snapshot.status === "unavailable") {
+    return degradedProps(snapshot, options);
+  }
+
+  const truncated = snapshot.status === "partial" || snapshot.truncated === true;
+  const files = (snapshot.files ?? []).map(toChangedFile);
+  // partial 但 daemon 没拿到文件列表（1500ms 超时 / 队列溢出，见 daemon
+  // `collectTurnFileChanges` 的 partial 收口）：D-034 —— 卡片照出但只有一行提示，
+  // 否则「采集没完成」会被读成「本轮没改文件」（E6/E8 立意）。
+  if (files.length === 0 && truncated) {
+    return {
+      files: [],
+      capability: "full",
+      turnNo: options.turnNo,
+      truncated: true,
+      notice: NOTICE_PARTIAL_NO_FILES,
+      sharedWorkspace: snapshot.concurrentSessionsHint === true,
+      className: options.className,
+    };
+  }
+  // 快照齐全且确实零改动 → 空态零渲染（既有卡片语义）；不写「本轮无改动」文案。
+  if (files.length === 0) return null;
+
+  return {
+    files,
+    capability: "full",
+    turnNo: options.turnNo,
+    truncated,
+    sharedWorkspace: snapshot.concurrentSessionsHint === true,
+    onOpenFile: options.onOpenFile,
+    className: options.className,
+  };
+}
+
+/**
+ * 投影缓存（保 TurnRow memo）：入参 `turns` 来自 `enrichDisplayTurns`，未变化的轮
+ * **保持原对象引用**（ql-20260903-025 身份稳定守卫）；本层若每次重建对象，流式
+ * delta 会把所有带快照的轮子树（markdown 解析）全部重渲染。缓存以「原 turn 对象」
+ * 为键、以「快照对象 + capability」为校验，同输入恒同输出（WeakMap 随轮对象回收）。
+ */
+const FILE_CHANGES_PROJECTION_CACHE = new WeakMap<
+  FileChangesTurnFields,
+  {
+    snapshot: TurnFileChangesSnapshot | null;
+    capability: FileChangesCapability;
+    projected: FileChangesTurnFields;
+  }
+>();
+
+/**
+ * 把 `/runs` 读模型的 `file_changes` / `file_changes_capability` 投影到轮视图上
+ * （snake_case → camelCase，唯一职责；取值/分页/SSE 零参与，FR-22）。
+ *
+ * - `capability` 字段缺失按 `"tool_only"`（E8：字段缺失＝老 daemon，显式降级）；
+ * - 命中的 run 缺失（该轮无 run 快照来源）→ 原对象透传，不出卡。
+ *
+ * 入参 map 的值按 `object` 收口（形状由 `RunFileChangesFields` 声明）：前端手工维护
+ * 的镜像 `SessionRunRead` 尚未补这两列（该文件在本任务 allowed_paths 之外），
+ * 若直接声明 `ReadonlyMap<string, RunFileChangesFields>`，TS 的 weak-type 规则会因为
+ * 「两者没有公共属性」拒绝整个 Map。读取处做一次显式视图声明，等镜像补齐后可原地收紧。
+ */
+export function attachRunFileChanges<T extends FileChangesTurnFields>(
+  turns: T[],
+  runsMeta: ReadonlyMap<string, object>,
+): T[] {
+  if (turns.length === 0 || runsMeta.size === 0) return turns;
+  let touched = false;
+  const next = turns.map((turn) => {
+    const meta = runsMeta.get(turn.realRunId ?? turn.runId) as
+      | RunFileChangesFields
+      | undefined;
+    if (!meta) return turn;
+    const snapshot = meta.file_changes ?? null;
+    const capability: FileChangesCapability =
+      meta.file_changes_capability === "full" ? "full" : "tool_only";
+    if (turn.fileChanges === snapshot && turn.fileChangesCapability === capability) return turn;
+    const cached = FILE_CHANGES_PROJECTION_CACHE.get(turn);
+    if (cached && cached.snapshot === snapshot && cached.capability === capability) {
+      touched = true;
+      return cached.projected as T;
+    }
+    const projected = {
+      ...turn,
+      fileChanges: snapshot,
+      fileChangesCapability: capability,
+    } as T;
+    FILE_CHANGES_PROJECTION_CACHE.set(turn, { snapshot, capability, projected });
+    touched = true;
+    return projected;
+  });
+  return touched ? next : turns;
+}
