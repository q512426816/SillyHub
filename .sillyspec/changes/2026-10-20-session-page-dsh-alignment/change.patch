+        lease_id, run_id, token, sid = await _seed_interactive_run(db_session, owner_id=admin)
+
+        # 首报（daemon 首报：尚未采集，不带快照）→ run 收口 + 侧表 tool_only
+        await svc.close_interactive_run(
