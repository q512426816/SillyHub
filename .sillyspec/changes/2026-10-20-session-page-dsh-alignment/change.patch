+/*
+ * 会话页视觉重做（v2 skin）—— 2026-10-20-session-page-dsh-alignment / D-012。
+ *
+ * 目的：不改真实组件的 DOM 契约，只在其外层加一个 skin 作用域，重排
+ *       **字号阶 / 行高 / 垂直节奏 / 层次与对比**（信息密度与观感问题在这三层）。
+ *
+ * 用法：<div className={styles.v2}> …真实 TurnTimeline + 页面 chrome… </div>
+ * 铁律：只用 token（hsl(var(--…)) / --color-*），零字面色；选择器一律锚定在 .v2 下，
+ *       不污染生产样式（本文件只被 /proto/session-redesign 引用）。
+ */
+
+.v2 {
+  /* v2 节奏参数（一处改，全页生效） */
+  --v2-turn-gap: 28px;
+  --v2-row-gap: 6px;
+  --v2-process-size: 12.5px;
+  --v2-meta-size: 11px;
+  --v2-rail: 52rem;
+  background: hsl(var(--background));
+  color: hsl(var(--foreground));
+}
+
+/* ── 会话流：限宽居中 + 呼吸节奏 ───────────────────────────────── */
+.v2 :global([data-turn-key]) {
+  scroll-margin-top: 56px;
+}
+
+/* 正文 15px / 1.8 / 段距 0.65em **不在这里**：由 globals.css 的
+   `.seg-text-body .markdown-text .wmde-markdown` 元素级规则唯一承担（D-021）。
+   本作用域只保留排版骨架（字距 / 阅读限宽）——字号与段距一旦在这里再写一份，
+   就成了「两处参数并存」，任何 CSS 顺序变动都会静默回流成旧字阶（R-04）。 */
+.v2 :global(.seg-text-body) {
+  letter-spacing: -0.003em;
+  max-width: min(100%, var(--v2-rail));
+}
+
+/* ── 过程行：比正文弱两档，不再用卡片框抢注意力 ───────────────── */
+.v2 :global([data-turn-key] details),
+.v2 :global([data-turn-key] summary) {
+  font-size: var(--v2-process-size);
