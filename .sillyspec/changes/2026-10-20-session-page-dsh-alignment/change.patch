+      lanes: { input: [], model: [], tool: [] },
+    };
+    render(<TrajectoryTimeline trajectory={empty} />);
+    expect(screen.getAllByTestId("trajectory-lane-label")).toHaveLength(3);
+    expect(screen.queryAllByTestId("trajectory-bar")).toHaveLength(0);
