+ * 下面三条旧用例的期望值随之调整（1s→0s、10s→9s、6s→4s），断言意图不变。
+ */
+describe("buildTrajectory lanes", () => {
+  function lanesOf(logs: AgentRunLogEntry[], runs: TrajectoryRunInput[] = [makeRun()]) {
