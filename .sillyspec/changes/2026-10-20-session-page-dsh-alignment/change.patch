+    # 而非 null——生成的前端类型才是 optional 而非 `| null`）。
+    binary: bool | None = Field(default=None, exclude_if=lambda v: v is None)
+    # edit_patch = 命中本轮 Edit/Write 工具调用；command = 命令行/脚本改动。
+    attribution: Literal["edit_patch", "command"]
