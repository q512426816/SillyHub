+describe('deriveTurnTiming × 工具区间与 attempt 零重叠', () => {
+  /** 并行工具批 + 两段模型的固定夹具（含先后返回的 result）。 */
+  const events: TurnTimingEvent[] = [
+    { kind: 'thinking', atMs: T0 + 100 },
+    { kind: 'text', atMs: T0 + 200 },
