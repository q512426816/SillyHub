+    path: str  # 仓根相对（design：posix 分隔）
+    # 禁 rename 检测：改名一律呈两条（delete + add），status 由 porcelain XY 裁决。
+    status: Literal["added", "modified", "deleted", "untracked"]
+    added: int  # git diff --numstat；二进制为 0/0 + binary=True
+    deleted: int
