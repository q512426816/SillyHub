+  return {
+    ...actual,
+    readBaselineHead: vi.fn(async () => 'head-sha-0'),
+    collectTurnFileChanges: vi.fn((input: Record<string, unknown>) => {
+      hoisted.calls.push(input);
+      return new Promise((resolve, reject) => {
+        hoisted.pending.push({ resolve, reject });
+      });
+    }),
