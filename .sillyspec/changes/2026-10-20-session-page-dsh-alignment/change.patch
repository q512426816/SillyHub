+
+/* ── 上下文 chip / 元信息：降噪 ─────────────────────────────── */
+.v2 :global(.sh-ctx-chip) {
+  font-size: var(--v2-meta-size);
+  opacity: 0.85;
+}
+
+/* ── 页面 chrome（本页自建，非生产组件） ───────────────────── */
+.header {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  height: 46px;
+  padding: 0 18px;
+  border-bottom: 1px solid hsl(var(--border));
+  background: hsl(var(--background));
+}
+
+.title {
+  /* 标题 14.5 像素（1rem=16px 时 0.90625rem 恰好等值）——本文件不再出现 D-021
+     之前的正文旧字面量，R-04 的机械验收是全文件 grep，故用 rem 等价式表达。 */
+  font-size: 0.90625rem;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+}
+
+.eyebrow {
+  font-family: var(--font-mono, ui-monospace, monospace);
+  font-size: 10.5px;
+  letter-spacing: 0.02em;
+  color: hsl(var(--muted-foreground));
+  text-transform: uppercase;
+}
+
+.pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  padding: 1px 7px;
+  border: 1px solid hsl(var(--border));
+  border-radius: 999px;
+  font-size: 10.5px;
+  color: hsl(var(--muted-foreground));
+}
+
+.dotOk {
+  width: 5px;
+  height: 5px;
+  border-radius: 999px;
+  background: var(--color-success);
+}
+
+.chipRow {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+  font-size: 10.5px;
+  color: hsl(var(--muted-foreground));
+}
+
+.mono {
+  font-family: var(--font-mono, ui-monospace, monospace);
+  font-size: 10.5px;
+}
+
+.rail {
+  width: 40px;
+  flex: 0 0 40px;
+  border-left: 1px solid hsl(var(--border));
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 7px;
+  padding-top: 14px;
+}
+
+.railMark {
+  width: 12px;
+  height: 2px;
+  border-radius: 2px;
+  background: hsl(var(--border));
+}
+
+.railMarkOn {
+  background: var(--color-brand-600);
+}
+
+.composerWrap {
+  border-top: 1px solid hsl(var(--border));
+  padding: 8px 18px 12px;
+}
+
+.composerMeta {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  font-size: 10.5px;
+  color: hsl(var(--muted-foreground));
+  margin-bottom: 6px;
+}
+
+.composer {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 42px;
+  padding: 0 12px;
+  border: 1px solid hsl(var(--border));
+  border-radius: 12px;
+  background: hsl(var(--card));
+  font-size: 13.5px;
+  color: hsl(var(--muted-foreground));
+}
+
+.send {
+  width: 26px;
+  height: 26px;
+  border-radius: 999px;
+  display: grid;
+  place-items: center;
+  background: var(--color-brand-600);
+  color: hsl(var(--card));
+  font-size: 12px;
+}
+
+/* 骨架：未加载轮 */
+.skeleton {
+  height: 9px;
+  width: 96px;
+  border-radius: 3px;
+  background: hsl(var(--muted));
+  animation: pulse 1.6s ease-in-out infinite;
+}
+
+@keyframes pulse {
+  0%,
+  100% {
+    opacity: 0.55;
+  }
+  50% {
+    opacity: 1;
+  }
+}
