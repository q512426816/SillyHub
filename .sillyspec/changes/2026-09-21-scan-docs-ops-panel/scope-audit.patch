+        if not projects:
+            return {}
+        stmt = (
+            select(ScanDocument.path, ScanDocument.content)
+            .where(col(ScanDocument.workspace_id) == workspace_id)
+            .where(col(ScanDocument.exists).is_(True))
+            .where(col(ScanDocument.path).endswith("_module-map.yaml"))
