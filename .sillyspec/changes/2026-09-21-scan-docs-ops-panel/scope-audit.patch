+    async def stats(self, workspace_id: uuid.UUID) -> ScanDocsStatsOut:
+        """scan_documents 单表内存聚合 → 覆盖率（两级）/陈旧/密度/新鲜/趋势/最近榜，
+        再聚合 knowledge_hits 的 docs-inject 行出注入频次（D-003@v1）。
