+    expect(out[0].content).toContain('file:///tmp/design.md');
+  });
+
+  it('空文本 thought（dsh updates.ts 长度 0 跳过分支的客户端侧防御）→ 不产出', () => {
+    const out = normalizeAcpUpdate({
+      sessionUpdate: 'agent_thought_chunk',
+      messageId: 'm-4',
