+
+  it('agent_thought_chunk → thinking 事件', () => {
+    const out = normalizeAcpUpdate({
+      sessionUpdate: 'agent_thought_chunk',
+      messageId: 'm-1',
+      content: { type: 'text', text: '先想一下' },
