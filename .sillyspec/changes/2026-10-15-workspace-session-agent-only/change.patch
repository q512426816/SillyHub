+    for (const sessionUpdate of ['config_option_update', 'plan', 'current_mode_update', 'user_message_chunk', 'some_future_kind']) {
+      expect(normalizeAcpUpdate({ sessionUpdate } as AcpSessionUpdate)).toEqual([]);
