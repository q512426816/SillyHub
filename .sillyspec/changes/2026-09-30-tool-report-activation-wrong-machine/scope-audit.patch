+        shpsync_headers: tuple[Any, dict[str, str]],
+        db_session: AsyncSession,
+    ) -> None:
+        """同值重推 → 快照稳定（幂等，不叠加嵌套）。"""
+        _ws_id, headers = shpsync_headers
+        entry = _entry_with_machine(MACHINE_BLOCK, last_seen_at="2026-09-30T02:40:00.000Z")
+        for _ in range(2):
