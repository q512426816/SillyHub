+    for (let i = 0; i < products.length; i++) {
+      expect(
+        afterSecond[i],
+        `${products[i]} 第二遍生成后内容漂移（脚本非幂等：检查渲染键序/缩进/引号稳定性）`,
+      ).toBe(afterFirst[i]);
+    }
+  });
+});
