+    for (const p of products) {
+      expect(existsSync(p), `生成产物缺失: ${p}（先跑一次脚本产出并提交）`).toBe(true);
+    }
+
+    // execFileSync 直跑 node 二进制（TaskCard 语义的 execSync('node …') 稳健
+    // 形态——免 shell 引号 / Windows PATH 差异）；脚本守卫失败 exit 1 时
+    // execFileSync 抛错即本用例红（响亮失败透传）。
+    const run = () =>
