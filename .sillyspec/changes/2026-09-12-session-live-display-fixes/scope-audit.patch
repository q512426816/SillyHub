+    # 源① CustomSkill 全体名（他人技能也要排除——不限 owner）
+    stranger = await _create_user(db_session, email="stranger@example.com")
+    await _add_custom_skill(db_session, owner=stranger.id, name="taken-custom")
+    # 源② 平台 sillyspec-*（bundle 目录文件扫描）
