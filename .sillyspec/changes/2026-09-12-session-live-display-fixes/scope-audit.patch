+    assert results["ghost"]["status"] == "missing"
+    assert results["../outside"]["status"] == "invalid"  # 段白名单拒绝（防穿越）
+    assert results["real-skill"]["status"] == "adopted"
+    assert not (tmp_path / "outside").exists()  # 盘外零接触
