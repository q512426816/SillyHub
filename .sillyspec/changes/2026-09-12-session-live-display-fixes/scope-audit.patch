+        entry = await _make_scheduled(
+            db_session,
+            session_id,
+            uid,
+            prompt="[系统续跑] 额度已重置…",
+            origin=f"auto_resume:{busy_run_id}",
+        )
+
+        processed = await scheduled_send_sweep_once(db_session)
+
+        assert processed == 1
+        status, _ec, _msg, _at = await _entry_row(db_session, entry.id)
