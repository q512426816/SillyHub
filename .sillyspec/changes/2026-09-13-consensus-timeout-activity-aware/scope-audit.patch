+async def _member_is_active(db: "AsyncSession", shadow_session_id: uuid.UUID) -> bool:
+    """成员活动信号判定（design §3.1，fail-closed）。
+
+    - 影子会话最新 run status ∈ {pending, running}（pending=排队——机器
+      在线只是忙，排队中的长任务不该被死线误杀，design D-2）→ 活动；
+    - 或该 run 时间线最近 ``_CONSENSUS_ACTIVITY_WINDOW_SEC`` 秒有新行 → 活动；
+    - 无 run（触发从未成功）/ 查询异常 → False（fail-closed——单成员探测
+      异常不连坐任务收口时序，沿用 sweep per-task 吞错语义）。
+    """
+    try:
+        latest_run = (
+            await db.execute(
+                select(AgentRun.id, AgentRun.status)
+                .where(AgentRun.agent_session_id == shadow_session_id)
+                .order_by(AgentRun.created_at.desc(), AgentRun.id.desc())
+                .limit(1)
+            )
+        ).first()
+        if latest_run is None:
+            return False
+        if latest_run.status in ("pending", "running"):
+            return True
+        cutoff = datetime.now(UTC) - timedelta(seconds=_CONSENSUS_ACTIVITY_WINDOW_SEC)
+        last_log_at = (
+            await db.execute(
+                select(AgentRunLog.timestamp)
+                .where(AgentRunLog.run_id == latest_run.id)
+                .order_by(AgentRunLog.timestamp.desc())
+                .limit(1)
+            )
+        ).scalar()
+        return last_log_at is not None and last_log_at >= cutoff
+    except Exception:
+        _gsvc.log.warning(
+            "consensus_member_activity_probe_failed",
+            shadow_session_id=str(shadow_session_id),
+            exc_info=True,
+        )
+        return False
+
