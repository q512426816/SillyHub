+        created_by=owner_id,
+        shadow_session_id=shadow.id,
+    )
+    db_session.add(member)
+    await db_session.flush()
+    return member
+
+
+async def _seed_run(
+    db_session: AsyncSession,
+    shadow: AgentSession,
+    *,
+    status: str,
+    last_log_at: datetime | None = None,
+) -> AgentRun:
+    run = AgentRun(
+        id=uuid.uuid4(),
+        agent_type="claude_code",
+        provider="group",
+        agent_session_id=shadow.id,
+        user_id=shadow.user_id,
+        status=status,
+        started_at=datetime.now(UTC) - timedelta(minutes=5),
+        spec_strategy="group_member",
+    )
+    db_session.add(run)
+    await db_session.flush()
+    if last_log_at is not None:
+        db_session.add(
+            AgentRunLog(
+                id=uuid.uuid4(),
+                run_id=run.id,
+                channel="assistant",
+                content_redacted="意见草稿……",
+                timestamp=last_log_at,
+            )
+        )
+        await db_session.flush()
+    return run
+
+
+async def _seed_task(
+    db_session: AsyncSession,
+    env: SimpleNamespace,
+    *,
+    coordinator: AgentGroupMember,
+    collaborators: list[AgentGroupMember],
+    created_at: datetime | None = None,
+) -> AgentGroupConsensusTask:
+    task = await create_consensus_task(
+        db_session,
+        group=env.group,
+        carrier_run_id=env.carrier.id,
+        coordinator=coordinator,
+        collaborators=collaborators,
+        created_by=env.owner.id,
+        timeout_seconds=60,
+        source_summary="触发消息摘要",
+    )
+    if created_at is not None:
+        task.created_at = created_at
+    return task
+
+
