+            group_id=uuid.uuid4(),
+            member_type="agent",
+            display_name="同名君",
+            joined_at=datetime.now(UTC),
+        )
+        hits = _parse_group_mentions("@同名君 帮忙看看", [early, late])
+        assert len(hits) == 1
+        assert hits[0].id == early.id
