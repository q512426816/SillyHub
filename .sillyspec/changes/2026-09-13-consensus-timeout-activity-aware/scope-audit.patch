+def _card_outcome_summary(members: list[dict]) -> str:
+    """终态卡逐成员结局摘要（FR-4/AC-5）：failed 带 error 一句话、
+    timeout 未响应名单；同名成员（不同 id）加 id 前 6 位区分（FR-3/AC-4，
+    两遍式：先数名再渲染）；单行长度由外层 200 字符截断兜底。"""
+    from collections import Counter
+
+    name_counts = Counter(str(m.get("member_name", "?")) for m in members)
+
+    def label(m: dict) -> str:
+        name = str(m.get("member_name", "?"))
+        if name_counts[name] > 1:
+            mid = str(m.get("member_id", ""))
+            return f"{name}({mid[:6]})" if mid else name
+        return name
+
+    failed_parts = [
+        f"{label(m)}触发失败" + (f"({str(m.get('error', ''))[:40]})" if m.get("error") else "")
+        for m in members
+        if m.get("state") == CONSENSUS_MEMBER_FAILED
+    ]
+    timeout_parts = [label(m) for m in members if m.get("state") == CONSENSUS_MEMBER_TIMEOUT]
+    parts: list[str] = []
+    if failed_parts:
+        parts.append("失败：" + "、".join(failed_parts))
+    if timeout_parts:
+        parts.append("未响应：" + "、".join(timeout_parts))
+    return "；".join(parts)
+
