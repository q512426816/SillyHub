+    def test_same_name_deterministic_pick_earliest(self):
+        """AC-4：同名多行 @ 解析确定性命中 joined_at 最早一行。
+
+        纯函数级（不落库）——成员表 UNIQUE(group_id, display_name) 约束下
+        同库同名多行不可能（2026-09-13 task-03 实测抓获：UNIQUE 约束即
+        用户现场名单重复根因的排除证据——重复必为同 id 重复塞入，快照
+        ID 去重根治；本用例防未来约束放宽/跨群共享成员行场景）。
+        """
+        early = AgentGroupMember(
+            id=uuid.uuid4(),
+            group_id=uuid.uuid4(),
+            member_type="agent",
+            display_name="同名君",
+            joined_at=datetime.now(UTC) - timedelta(days=1),
+        )
+        late = AgentGroupMember(
