+"""共识收口活动感知续期测试（2026-09-13-consensus-timeout-activity-aware task-03）。
+
+覆盖 AC-1~5：
+- 续期触发（死线到点 + pending 成员 run 运行中 → 顺延不收口 + 卡面延长提示）；
+- 硬上限两分支（达上限不再顺延：零 delivered→aborted / 有 delivered→timeout 收口）；
+- 无活动立即收口（run 终态 + 时间线窗口外 → 原路径无额外等待）；
+- 快照去重 / 同名确定性 / 卡面同名区分；
+- 终态卡逐成员结局（含 abort_reason 汇总人自身结局）。
+
+范式照 test_group_consensus.py（自包含 fixture；SQLite aiosqlite 内存库）。
+"""
+
+from __future__ import annotations
+
+import uuid
+from datetime import UTC, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.modules.agent.model import (
+    AgentGroupChat,
