+    user = User(
+        id=uuid.uuid4(),
+        email=f"{name}-{uuid.uuid4().hex[:6]}@t.cn",
+        display_name=name,
+        password_hash="x",
+    )
+    db_session.add(user)
+    await db_session.flush()
+    return user
+
+
+async def _make_env(db_session: AsyncSession, *, timeout_seconds: int = 600) -> SimpleNamespace:
+    ws = Workspace(
+        id=uuid.uuid4(),
+        name="act-ws",
+        slug=f"act-ws-{uuid.uuid4().hex[:8]}",
+        root_path="C:/tmp/act-ws",
+        status="active",
+    )
+    db_session.add(ws)
+    owner = await _make_user(db_session, "群主")
+    group = AgentGroupChat(
+        id=uuid.uuid4(),
+        session_id=uuid.uuid4(),
+        workspace_id=ws.id,
+        project_id=None,
+        title="活动感知测试群",
+        created_by=owner.id,
+        consensus_mode=True,
+        consensus_timeout_seconds=timeout_seconds,
+        created_at=datetime.now(UTC),
+    )
+    db_session.add(group)
+    carrier = AgentRun(
+        id=uuid.uuid4(),
+        agent_type="claude_code",
+        provider="group",
+        agent_session_id=group.session_id,
+        user_id=owner.id,
+        status="completed",
+        started_at=datetime.now(UTC),
+        spec_strategy="group_carrier",
+    )
+    db_session.add(carrier)
+    await db_session.flush()
+    return SimpleNamespace(ws=ws, owner=owner, group=group, carrier=carrier)
