+      expect(cleaned).not.toContain(PRIVATE_ID);
+      // 块本身不再存在（替换文案里提到的类型名属描述文本，故按 JSON 块字面断言）。
+      expect(cleaned).not.toContain('"type":"server_tool_use"');
+      expect(cleaned).toContain('截图分析正文'); // 正文保留
+      const records = cleaned
+        .split('\n')
+        .filter((l) => l.length > 0)
