+let seq = 0;
+function entry(runId: string, tsSec: number, channel: string, content: string) {
+  seq += 1;
+  const mm = String(Math.floor(tsSec / 60)).padStart(2, "0");
+  const ss = String(tsSec % 60).padStart(2, "0");
+  return {
+    id: `log-${String(seq).padStart(4, "0")}`,
+    run_id: runId,
