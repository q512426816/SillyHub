+_ADOPT_NAME_RE = re.compile(r"^[a-z0-9-]{2,40}$")
+_ADOPT_NAME_MAX_LENGTH = 40  # CustomSkill.name String(40) 同宽
+_ADOPT_RESERVED_PREFIX = "sillyspec-"
