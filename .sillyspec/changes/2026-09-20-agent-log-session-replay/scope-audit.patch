+// ── C4：坏行容错 ─────────────────────────────────────────────────────────────
+
+describe('parseClaudeCodeJsonlLog — 坏行容错（C4 / R-01）', () => {
+  /** 6 种结构坏行变体（非 JSON×2 / 非 object / 无 type / user 缺 message / assistant message 非 object）。 */
+  const BAD_LINES: string[] = [
+    '{not valid json',
+    'also not json {{{',
+    JSON.stringify([1, 2, 3]), // 非 object 行
+    JSON.stringify({ message: { role: 'user', content: '无 type 字段' } }), // 无 type
+    JSON.stringify({ type: 'user' }), // 产出型行缺 message
+    JSON.stringify({ type: 'assistant', message: 'not-record' }), // message 非 object
+  ];
+
+  function goodLine(i: number): string {
+    return userLine({ content: `好行 ${i}` });
+  }
+
+  it('坏行占比恰 50%（边界，不 >50%）→ parsed：跳过计 skippedLines、解析不中断', async () => {
+    const content = jsonl(...BAD_LINES, ...[0, 1, 2, 3, 4, 5].map(goodLine));
+    const result = await parseClaudeCodeJsonlLog(content);
+    expect(result.status).toBe('parsed');
+    expect(result.skippedLines).toBe(6);
+    expect(result.totalSegments).toBe(6);
+    expect(result.messages[5]?.text).toBe('好行 5');
+  });
+
+  it('坏行占比 >50% → parse_error 且 messages 为空（totalUsage 同置空）', async () => {
+    const content = jsonl('{再来一个坏行', ...BAD_LINES, ...[0, 1, 2, 3, 4].map(goodLine));
+    const result = await parseClaudeCodeJsonlLog(content);
+    expect(result.status).toBe('parse_error');
+    expect(result.messages).toEqual([]);
+    expect(result.truncated).toBe(false);
+    expect(result.totalSegments).toBe(0);
+    expect(result.skippedLines).toBe(7);
+    expect(result.totalUsage).toBeNull();
+  });
