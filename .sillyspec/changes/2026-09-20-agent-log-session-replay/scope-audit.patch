+    turnEndedLine('error', 'User aborted request'),
+  );
+
+  it('user/assistant text 正确分类，块序产段，seq 连续（共 8 段：2 user_input + 2 reply + 2 tool_use + 2 标记段）', async () => {
+    const result = await parseCursorAgentTranscriptLog(content);
+    expect(result.status).toBe('parsed');
+    expect(result.skippedLines).toBe(0);
+    expect(result.truncated).toBe(false);
+    expect(result.totalSegments).toBe(8);
+    expect(result.messages.map((m) => [m.seq, m.kind, m.text, m.tool_name, m.tool_use_id])).toEqual([
+      [1, 'user_input', REAL_USER_QUERY, null, null],
+      [2, 'reply', '我先看任务卡与参考实现', null, null],
+      [3, 'tool_use', null, 'Read', null],
+      [4, 'tool_use', null, 'ApplyPatch', null],
