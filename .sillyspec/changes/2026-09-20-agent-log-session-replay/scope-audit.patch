+// frontend/src/lib/agent-log-replay.ts
+//
+// 本地 Agent 日志回放适配层（纯函数，2026-09-20-agent-log-session-replay design §3.1）。
+//
+// 职责：把 messages 端点的归一化消息（AgentLogMessageItem，snake_case 原样访问）
+// 适配成 TurnTimeline 可渲染的 SessionTurnView[]，外加主/子日志判定：
+//   - isSubagentLog / selectMainLogs：session_id 或 log_path 含 `subagent` 判为
+//     子代理（工作会话）日志；主日志按 first_seen_at 升序（同刻保序），调用方
+//     取末位即最新主日志；
+//   - buildReplayTurns：轮边界三保险（真人 user_input / turn_id 变化（null 不
+//     触发）/ turn_end 标记）切轮；系统事件（zcode `<task-notification>` /
+//     `<system-reminder>` 前缀文本、claude-code is_meta=true 文本段）归一为该轮
+//     processItems 首项 stderr——不占用户气泡、不进 output；reply 拼接 output、
+//     thinking/tool 进 processItems（tool_use 与 tool_result 按 tool_use_id 配对，
+//     失配不假 running）；轮内 usage 求和→inputTokens/outputTokens（无任何
+//     usage→null，不虚构 token）。
+//
+// 约束：纯函数——零 React / 零网络 / 零 hooks；SessionTurnView /
+// SessionProcessItem 仅 type-only 引用（TurnTimeline 组件零改动、不新建
+// SessionProcessItem 种类，系统事件复用 stderr 原语）。
+
+import type { components } from "@/lib/api-types";
+import type {
+  SessionProcessItem,
+  SessionTurnView,
+} from "@/components/daemon/turn-timeline";
+
+/** 归一化消息单条（api-types 生成 schema，snake_case 原样访问——同 agent-log-card.tsx 先例）。 */
+export type AgentLogMessageItem = components["schemas"]["AgentLogMessageItem"];
+
+/** 主/子日志判定与排序所需的最小条目字段（AgentLogListItem / AgentLogEntry 结构兼容）。 */
+export interface AgentLogEntryLike {
+  session_id?: string | null;
+  log_path: string;
+  first_seen_at?: string | null;
+}
+
+/** tool 过程项（SessionProcessItem 的 tool 变体；配对时回填 result / status）。 */
+type ToolProcessItem = Extract<SessionProcessItem, { kind: "tool" }>;
+
+/* ───────────────── 主/子日志判定 ───────────────── */
+
+/** 子代理标识子串（实证形态：zcode 子代理 session_id 为 `subagent_agent_…` 前缀）。 */
+const SUBAGENT_MARK = "subagent";
+
+/**
+ * 是否子代理（工作会话）日志：session_id 或 log_path 含 `subagent` 即命中。
+ * 主日志=其余条目（selectMainLogs 过滤本判定）。
+ */
+export function isSubagentLog(entry: {
+  session_id?: string | null;
+  log_path: string;
+}): boolean {
+  if (entry.session_id != null && entry.session_id.includes(SUBAGENT_MARK)) {
+    return true;
+  }
+  return entry.log_path.includes(SUBAGENT_MARK);
+}
+
+/** first_seen_at → 可比较毫秒时间戳；null / 缺省 / 非法视为不可考（返回 null）。 */
+function firstSeenTs(value: string | null | undefined): number | null {
+  if (!value) return null;
+  const t = Date.parse(value);
+  return Number.isNaN(t) ? null : t;
+}
+
+/**
+ * 主日志列表：过滤子代理后按 first_seen_at 升序返回（排序稳定，同刻保持原相对
+ * 顺序；first_seen_at 不可考的排最前，末位留给有据可查的最新主日志）。返回新
+ * 数组，入参不被修改。
+ */
+export function selectMainLogs<T extends AgentLogEntryLike>(
+  entries: readonly T[],
+): T[] {
+  return entries
+    .filter((entry) => !isSubagentLog(entry))
+    .sort((a, b) => {
+      const ta = firstSeenTs(a.first_seen_at);
+      const tb = firstSeenTs(b.first_seen_at);
+      if (ta == null && tb == null) return 0;
+      if (ta == null) return -1;
+      if (tb == null) return 1;
+      return ta - tb;
+    });
+}
+
+/* ───────────────── 系统事件归一化 ───────────────── */
+
+/** zcode 注入文本的系统事件前缀（两种形态）。 */
+const SYSTEM_EVENT_PREFIXES = ["<task-notification>", "<system-reminder>"];
+
+/** 系统事件摘要首行截断上限（60 字，对齐 agent-log-card thinkingSummary 口径）。 */
+const SYSTEM_EVENT_SUMMARY_MAX = 60;
+
+/**
+ * 是否系统注入事件段：仅文本段（user_input / reply 形态）参与判定——
+ * a) text 以 `<task-notification>` / `<system-reminder>` 开头（zcode）；
+ * b) is_meta===true（claude-code 元消息行；null / false 不触发）。
+ */
+function isSystemEventMessage(msg: AgentLogMessageItem): boolean {
+  if (msg.kind !== "user_input" && msg.kind !== "reply") return false;
+  const text = msg.text ?? "";
+  if (SYSTEM_EVENT_PREFIXES.some((prefix) => text.startsWith(prefix))) {
+    return true;
+  }
+  return msg.is_meta === true;
+}
+
+/** 系统事件摘要：取首行压平空白，超 60 字截断补省略号。 */
+function systemEventSummary(text: string): string {
+  const firstLine = text.split("\n", 1)[0] ?? "";
+  const flat = firstLine.replace(/\s+/g, " ").trim();
+  return flat.length <= SYSTEM_EVENT_SUMMARY_MAX
+    ? flat
+    : `${flat.slice(0, SYSTEM_EVENT_SUMMARY_MAX)}...`;
+}
+
+/** 段 ts（ISO 原文）→ 毫秒时间戳；null / 缺省 / 非法返回 undefined（过程项不带头）。 */
+function segmentTs(msg: AgentLogMessageItem): number | undefined {
+  if (!msg.ts) return undefined;
+  const t = Date.parse(msg.ts);
+  return Number.isNaN(t) ? undefined : t;
+}
+
+/** 未配对 tool_use 的 raw 前缀标记（如实标注「结果未记录」，不假 running）。 */
+const UNPAIRED_TOOL_MARK = "[结果未记录] ";
+
+/** 轮装配中间态（八字段必填契约之外的过程累积）。 */
+interface TurnDraft {
+  /** `replay-<首段seq>`（回放伪 run id，React key 唯一）。 */
+  runId: string;
+  /** 真人文本（系统/标记触发轮为空串——string 不可 null）。 */
+  prompt: string;
+  /** reply 正文段（系统事件不进），finalize 时空行拼接。 */
+  outputParts: string[];
+  /** 系统事件 stderr 项（finalize 时置于 processItems 首位，按到达顺序）。 */
+  systemItems: SessionProcessItem[];
+  /** thinking / tool 过程项（真实到达顺序）。 */
+  items: SessionProcessItem[];
+  /** 当前轮 tool_use 配对索引（同 id 多个时取最近一个未配对项）。 */
+  toolPairs: Array<{ toolUseId: string; item: ToolProcessItem }>;
+  /** 轮内是否出现过 usage（全无 → token 三字段 null，不虚构）。 */
+  hasUsage: boolean;
+  inputTokens: number;
+  outputTokens: number;
+  /** 轮内最后一个非 null usage 的 input_tokens（全量口径上下文）。 */
+  ctxTokens: number | null;
+}
+
+/** 装配终态：未配对 tool_use 补「[结果未记录]」前缀，输出八字段必填的轮视图。 */
+function finalizeTurn(draft: TurnDraft): SessionTurnView {
+  for (const pair of draft.toolPairs) {
+    if (pair.item.result === undefined) {
+      pair.item.raw = `${UNPAIRED_TOOL_MARK}${pair.item.raw}`;
+    }
+  }
+  return {
+    runId: draft.runId,
+    turn: null,
+    prompt: draft.prompt,
+    output: draft.outputParts.join("\n\n"),
+    status: "completed",
+    seenLogIds: new Set<string>(),
+    inputTokens: draft.hasUsage ? draft.inputTokens : null,
+    outputTokens: draft.hasUsage ? draft.outputTokens : null,
+    ctxTokens: draft.ctxTokens,
+    processItems: [...draft.systemItems, ...draft.items],
+  };
+}
+
+/**
+ * 归一化消息 → TurnTimeline 轮视图列表（design §3.1）。
+ *
+ * 轮边界三保险（任一触发开新轮）：真人 user_input（系统事件除外）/ turn_id 与
+ * 上一段不同（任一侧为 null 不触发）/ 上一段是 turn_end 标记。turn_end:true 的
+ * 标记段自身不渲染（仅切轮信号）。系统事件不产用户气泡、不进 output，归一为
+ * 该轮 processItems 首项 stderr（复用既有原语，TurnTimeline 零改动）。
+ */
+export function buildReplayTurns(
+  messages: AgentLogMessageItem[],
+): SessionTurnView[] {
+  const turns: SessionTurnView[] = [];
+  let draft: TurnDraft | null = null;
+  /** 上一个已处理段的 turn_id 原值（与上一段比较，null 不触发切轮）。 */
+  let lastTurnId: string | null = null;
+  /** 上一段是 turn_end 标记：下一段无论形态开新轮。 */
+  let pendingTurnEnd = false;
+
+  for (const msg of messages) {
+    // turn_end 标记段：仅切轮信号，自身不渲染。
+    if (msg.turn_end === true) {
+      pendingTurnEnd = true;
+      lastTurnId = msg.turn_id ?? null;
+      continue;
+    }
+
+    const systemEvent = isSystemEventMessage(msg);
+    const realUserInput = msg.kind === "user_input" && !systemEvent;
+    const turnIdChanged =
+      msg.turn_id != null && lastTurnId != null && msg.turn_id !== lastTurnId;
+
+    if (draft === null || pendingTurnEnd || realUserInput || turnIdChanged) {
+      if (draft !== null) turns.push(finalizeTurn(draft));
+      draft = {
+        runId: `replay-${msg.seq}`,
+        prompt: realUserInput ? msg.text ?? "" : "",
+        outputParts: [],
+        systemItems: [],
+        items: [],
+        toolPairs: [],
+        hasUsage: false,
+        inputTokens: 0,
+        outputTokens: 0,
+        ctxTokens: null,
+      };
+      pendingTurnEnd = false;
+    }
+    lastTurnId = msg.turn_id ?? null;
+
+    const ts = segmentTs(msg);
+    if (systemEvent) {
+      draft.systemItems.push({
+        kind: "stderr",
+        text: `⚙ 系统事件 · ${systemEventSummary(msg.text ?? "")}`,
+        ...(ts !== undefined ? { ts } : {}),
+      });
+    } else {
+      switch (msg.kind) {
+        case "reply":
+          draft.outputParts.push(msg.text ?? "");
+          break;
+        case "thinking":
+          draft.items.push({
+            kind: "thinking",
+            text: msg.text ?? "",
+            ...(ts !== undefined ? { ts } : {}),
+          });
+          break;
+        case "tool_use": {
+          const item: ToolProcessItem = {
+            kind: "tool",
+            raw: msg.tool_input ?? "",
+            // 先缺省占位，同 tool_use_id 的 tool_result 到达后回填；
+            status: "ok",
+            ...(ts !== undefined ? { ts } : {}),
+          };
+          draft.items.push(item);
+          if (msg.tool_use_id != null) {
+            draft.toolPairs.push({ toolUseId: msg.tool_use_id, item });
+          }
+          break;
+        }
+        case "tool_result": {
+          const toolUseId = msg.tool_use_id ?? null;
+          const pending =
+            toolUseId != null
+              ? [...draft.toolPairs]
+                  .reverse()
+                  .find(
+                    (pair) =>
+                      pair.toolUseId === toolUseId &&
+                      pair.item.result === undefined,
+                  )
+              : undefined;
+          if (pending != null) {
+            pending.item.result = msg.tool_result ?? "";
+            pending.item.status = msg.is_error === true ? "deny" : "ok";
+          } else {
+            // 孤儿 tool_result（无同 id 的 tool_use）：raw 空串占位直存结果。
+            draft.items.push({
+              kind: "tool",
+              raw: "",
+              result: msg.tool_result ?? "",
+              status: "ok",
+              ...(ts !== undefined ? { ts } : {}),
+            });
+          }
+          break;
+        }
+        case "user_input":
+          // 真人 user_input 必切轮，已作为轮起点 prompt；走不到这里的重复分支。
+          break;
+      }
+    }
+
+    // token：轮内各段 usage 求和；ctxTokens 恒取末次非 null usage 的 input_tokens。
+    if (msg.usage != null) {
+      draft.hasUsage = true;
+      draft.inputTokens += msg.usage.input_tokens;
+      draft.outputTokens += msg.usage.output_tokens;
+      draft.ctxTokens = msg.usage.input_tokens;
+    }
+  }
+
+  if (draft !== null) turns.push(finalizeTurn(draft));
+  return turns;
+}
