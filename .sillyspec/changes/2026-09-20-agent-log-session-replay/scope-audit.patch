+/* ───────────────── dialog 形态门控（design §3.3 / Grill G-3 修订） ───────────────── */
+
+/**
+ * AgentLogReplaySessionGate —— dialog 形态挂载门控：dialog 现无 session 详情
+ * state（渲染路径零 react-query，R4 不变式——弹窗测试无 QueryClientProvider），
+ * origin/turn_count 由消费方（session-panel-dialog）从既有 attach 轮询的
+ * getAgentSession 响应顺带捕获喂入（design「轻查询」落地形态：复用既有请求，
+ * 不并发放第二路）。origin=tool_report 且 turn_count===0 → 挂
+ * AgentLogReplayBody（修复 dialog 对这类会话只显空时间线的缺陷，自建局部
+ * QueryClientProvider 承载回放主体内部查询，先例 ScheduledMessagesBar）；
+ * 否则（含 detail 尚未捕获的轮询首拍前窗口）原样渲染 children（原
+ * TurnTimeline）——不确认不切换，行为零回归。page 挂载点不经本门控
+ * （session-panel-page 自有 detailQuery）。
+ */
+export function AgentLogReplaySessionGate({
+  sessionId,
+  detail,
+  hasOnlineProvider = true,
+  emptyProviderLabel,
+  children,
+}: {
+  sessionId: string | null;
+  /** 会话 origin/turn_count（attach 轮询捕获）；null = 未捕获 → 原样渲染。 */
+  detail: { origin: string | null; turnCount: number | null } | null;
+  hasOnlineProvider?: boolean;
+  emptyProviderLabel: string;
+  /** 原主体（TurnTimeline）；非 tool_report 空轮会话原样渲染。 */
+  children: ReactNode;
+}) {
+  // 局部 client：retry 关闭（辅助信息条，失败静默）；聚焦刷新关（对齐
+  // ScheduledMessagesBar 局部 client 取值）。
+  const [client] = useState(
+    () =>
+      new QueryClient({
+        defaultOptions: {
+          queries: { retry: false, refetchOnWindowFocus: false },
+        },
+      }),
+  );
+  // 卸载清缓存（停轮询/失效定时器，防弹窗关闭后残留）。
+  useEffect(() => () => client.clear(), [client]);
+
+  // idle 新建（无 sessionId）/ detail 未捕获 / 非 tool_report 空轮 → 原样渲染。
+  if (
+    !sessionId ||
+    detail == null ||
+    detail.origin !== "tool_report" ||
+    detail.turnCount !== 0
+  ) {
+    return <>{children}</>;
+  }
+
+  return (
+    <QueryClientProvider client={client}>
+      <AgentLogReplayBody
+        sessionId={sessionId}
+        hasOnlineProvider={hasOnlineProvider}
+        emptyProviderLabel={emptyProviderLabel}
+      />
+    </QueryClientProvider>
+  );
+}
