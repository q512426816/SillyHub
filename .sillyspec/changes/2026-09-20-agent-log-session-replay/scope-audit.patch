+class TestUsageAndTurnBoundaryFields:
+    @pytest.mark.asyncio
+    async def test_new_daemon_fields_passthrough(
+        self,
+        client: AsyncClient,
+        shpsync_headers: tuple[Any, dict[str, str]],
+        db_session: AsyncSession,
+    ) -> None:
+        """新 daemon 消息级五字段（turn_id/model/is_meta/turn_end/usage 嵌套
+        snake_case）+ 外层 totalUsage→totals 逐字段原样透传命中（零改名/零重算，
+        totalUsage 刻意不等于窗口内 usage 之和）。"""
+        ws_id, headers = shpsync_headers
+        entry = await _make_bound_entry(db_session, ws_id)
+
+        with patch(_RPC, _rpc_mock(_PARSED_RESULT)):
+            resp = await client.get(f"/api/agent-logs/{entry.id}/messages", headers=headers)
+
+        assert resp.status_code == 200, resp.text
+        body = resp.json()
+        assert body["totals"] == {
+            "input_tokens": 240,
+            "output_tokens": 64,
+            "cache_read_tokens": 4096,
+            "cache_write_tokens": 1024,
+        }
+        user_input, tool_use, tool_result = body["messages"]
+        assert user_input["turn_id"] == "turn_01"
+        assert user_input["model"] is None
+        assert user_input["is_meta"] is False
+        assert user_input["turn_end"] is None
+        assert user_input["usage"] is None
+        assert tool_use["turn_id"] == "turn_01"
+        assert tool_use["model"] == "glm-4.7"
+        assert tool_use["is_meta"] is False
+        assert tool_use["turn_end"] is False
+        assert tool_use["usage"] == {
+            "input_tokens": 120,
+            "output_tokens": 8,
+            "cache_read_tokens": 2048,
+            "cache_write_tokens": 512,
+        }
+        assert tool_result["turn_end"] is True
+        assert tool_result["usage"] is None
+
