+// ── C4：usage/totalUsage 恒缺省 ───────────────────────────────────────────────
+
+describe('parseCursorAgentTranscriptLog — usage/totalUsage 恒缺省（C4）', () => {
+  it('result 无 totalUsage 键、messages 无 usage 键、序列化零 usage 子串（token 不落盘 96/96 实证，绝不虚构）', async () => {
+    const content = jsonl(
