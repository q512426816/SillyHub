+// tests/agent-log/parse-claude-code-jsonl.test.ts
+// task-02（2026-09-20-agent-log-session-replay / FR-02 + FR-03）：claude-code 会话
+// JSONL 解析器纯函数单测。
+//
+// fixture 内嵌字符串构造（真实形状按 design §1.3 生产库存量 4 条 claude-code 日志
+// 实证：顶层 type 分流 / user 行 tool_result 载体与 isMeta / assistant 块数组 /
+// message.usage 含 cache 四项），测试不依赖真实日志目录存在；解析器为纯函数
+// （content + 预算/窗口/beforeSeq/超时/时钟全注入），零 vi.mock。
+//
+// 覆盖 task-02 acceptance 全项：
+//   C1 type 全集行过滤（产出型 + 静默跳过型交错）+ 段产出全链路（seq/ts/九字段）
+//   C2 usage 全量口径归一（input 并入缓存读+写）+ 挂该行全部产出段 + totalUsage
+//      全文件求和（外层 camelCase / 内层 snake_case）
+//   C3 isMeta 分流：meta 文本→reply+is_meta:true；真人文本→user_input；
+//      tool_result 载体行不产 user_input
+//   C4 坏行容错（≤50% 跳过计数不中断；>50% → parse_error；空行不计；结构坏行变体）
+//   C5 20MB 预算（超限 too_large；恰好等于上限可解析）
+//   C6 200 段窗口 + beforeSeq 切片 + truncated/totalSegments + totalUsage 窗口前求和
+//   C7 5s 超时保护 → parse_error（now 注入，非时钟 mock）
+//   C8 tool_input 2KB / tool_result 4KB 截断；tool_result content 块数组文本拼接
+//   C9 usage 缺省：段 usage=null 不计入 totalUsage；全文件无 usage → totalUsage null
+
+import { describe, it, expect } from 'vitest';
+import {
+  parseClaudeCodeJsonlLog,
+  DEFAULT_MAX_SEGMENTS,
+  type ClaudeCodeLogMessage,
+} from '../../src/agent-log/parse-claude-code-jsonl.js';
+
+// ── fixture 构造（真实形状，键集含解析器不消费的旁路字段）─────────────────────
+
+/**
+ * 真实样例 usage（生产库 assistant 行 message.usage 逐字摘录，design §1.3：
+ * cache 写为 0、缓存读占绝对大头——claude-code 长会话典型形态）。
+ */
+const USAGE_REAL: Record<string, number> = {
+  input_tokens: 2059,
+  cache_creation_input_tokens: 0,
+  cache_read_input_tokens: 302720,
+  output_tokens: 838,
+};
+
+/** 第二份 usage（cache 写非零，覆盖全量口径三源相加）。 */
+const USAGE_SECOND: Record<string, number> = {
+  input_tokens: 100,
+  cache_creation_input_tokens: 50,
+  cache_read_input_tokens: 25,
+  output_tokens: 10,
+};
+
+/** user 行：content 纯字符串或块数组；isMeta 仅显式传入时携带（真实日志两态并存）。 */
+function userLine(opts: {
+  content: unknown;
+  isMeta?: boolean;
+  timestamp?: string;
+}): string {
+  return JSON.stringify({
+    parentUuid: 'uuid-parent',
+    isSidechain: false,
+    userType: 'external',
+    cwd: '/home/qinyi/project',
+    sessionId: 'sess-fixture',
+    version: '2.0.0',
+    gitBranch: 'main',
+    type: 'user',
+    message: { role: 'user', content: opts.content },
+    ...(opts.isMeta !== undefined ? { isMeta: opts.isMeta } : {}),
+    uuid: 'uuid-user',
+    timestamp: opts.timestamp ?? '2026-09-20T10:00:00.000Z',
+  });
+}
+
+/** assistant 行：message.content 块数组（text/thinking/tool_use）+ message.usage。 */
+function assistantLine(opts: {
+  content: Array<Record<string, unknown>>;
+  usage?: Record<string, number>;
+  timestamp?: string;
+}): string {
+  return JSON.stringify({
+    parentUuid: 'uuid-parent',
+    isSidechain: false,
+    userType: 'external',
+    cwd: '/home/qinyi/project',
+    sessionId: 'sess-fixture',
+    version: '2.0.0',
+    gitBranch: 'main',
+    type: 'assistant',
+    message: {
+      id: 'msg_fixture',
+      type: 'message',
+      role: 'assistant',
+      model: 'claude-sonnet-4-5',
+      content: opts.content,
+      stop_reason: 'tool_use',
+      stop_sequence: null,
+      ...(opts.usage !== undefined ? { usage: opts.usage } : {}),
+    },
+    requestId: 'req_fixture',
+    uuid: 'uuid-assistant',
+    timestamp: opts.timestamp ?? '2026-09-20T10:00:01.000Z',
+  });
+}
+
+/** 生命周期行（design §1.3 静默跳过型，键集对齐真实日志形状）。 */
+const QUEUE_OPERATION_LINE = JSON.stringify({
+  type: 'queue-operation',
+  queue: [{ timestamp: '2026-09-20T10:00:00.500Z', type: 'add', content: '排队中的消息' }],
+  timestamp: '2026-09-20T10:00:00.500Z',
+});
+const ATTACHMENT_LINE = JSON.stringify({
+  type: 'attachment',
+  attachment: { type: 'queued-command', content: '/clear' },
+  timestamp: '2026-09-20T10:00:00.600Z',
+});
+const LAST_PROMPT_LINE = JSON.stringify({
+  type: 'last-prompt',
+  prompt: '上一次的提示词',
+  timestamp: '2026-09-20T10:00:00.700Z',
+});
+const MODE_LINE = JSON.stringify({
+  type: 'mode',
+  mode: 'default',
+  timestamp: '2026-09-20T10:00:00.800Z',
+});
+const SYSTEM_LINE = JSON.stringify({
+  type: 'system',
+  subtype: 'compact_boundary',
+  content: '压缩边界事件',
+  isMeta: true,
+  timestamp: '2026-09-20T10:00:00.900Z',
+});
+/** 未在 design §1.3 列举的真实 type（summary）——未知 type 字符串同口径静默跳过。 */
+const SUMMARY_LINE = JSON.stringify({ type: 'summary', summary: '会话摘要行', leafUuid: 'uuid-leaf' });
+
+/** 多行拼成 JSONL 文本（尾随换行，真实文件形状）。 */
+function jsonl(...lines: string[]): string {
+  return `${lines.join('\n')}\n`;
+}
+
+/** 提取某 kind 的段（便于断言）。 */
+function ofKind(messages: ClaudeCodeLogMessage[], kind: ClaudeCodeLogMessage['kind']): ClaudeCodeLogMessage[] {
+  return messages.filter((m) => m.kind === kind);
+}
