+
+/* ───────────────── 八字段必填契约 ───────────────── */
+
+describe("buildReplayTurns：SessionTurnView 八字段必填契约", () => {
+  it("runId= replay-<首段seq>、turn:null、output 空串兜底、status completed、seenLogIds 空集合", () => {
+    const turns = buildReplayTurns([
