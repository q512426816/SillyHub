+/**
+ * `agent-log/parse-cursor-agent-transcript.ts` —— cursor-agent CLI transcript
+ * JSONL 解析器（纯函数）。
+ *
+ * task-03（2026-09-20-agent-log-session-replay / FR-02 + D-001@v1）：把 cursor-agent
+ * CLI 落盘的 `~/.cursor/projects/<project>/agent-transcripts/<session>/*.jsonl`
+ * 逐行解析为对话流
+ * 消息（NormalizedLogMessage[]，KB 级），经 task-05 的 registry 注册（format key
+ * `'cursor-agent-transcript'`）供 read_agent_log_messages RPC 与前端回放消费。
+ *
+ * 格式事实（design §1.4；2026-09-20 本机 96 份 transcript 逐行复证）：
+ *   - 角色行：`{role:'user'|'assistant', message:{content:[块]}}`——顶层键实证恒为
+ *     {message, role} 二键（无 type 字段、无时间戳字段 → ts 恒 null）；
+ *   - 生命周期事件行：`{type:'turn_ended', status:'success'|'error'}`，error 态
+ *     带可选 error:string（实证样例 "User aborted request"）；每会话以一或多个
+ *     turn_ended 收口，前端据此切轮；
+ *   - 块形状实证：text 块 {type,text}；tool_use 块 {type,name,input}——当前版本
+ *     **无 id/call_id 字段**（tool_use_id 恒 null，绝不虚构配对键），input 可为
+ *     对象（Read/Glob）或纯字符串（ApplyPatch 补丁原文）；
+ *   - tool_result 块在当前本机数据未观测到（0/96），但任务卡契约为 user 行
+ *     tool_result 块 → tool_result 段（call_id 配对键）——映射按契约实现并
+ *     防御式兼容 Anthropic 原生键（id / tool_use_id / args），Cursor 增字段
+ *     后零改动即通（向后兼容承诺）；
+ *   - **usage/totalUsage 恒不产出**：token 不落盘（实证 96/96 零 usage 键），
+ *     缺省即缺省（前端显示「未知」），绝不虚构。
+ *
+ * turn_ended 切轮（design §1.4）：turn_ended 行产 `turn_end:true` 标记段——
+ * kind 复用 'reply'、text 置空串、is_meta:true 防正文污染（前端按 turn_end
+ * 切轮、忽略其渲染）；标记段照常占 seq 槽位/计入 totalSegments/进窗口。
+ *
+ * 纯函数约束（task-03 constraints，对齐 task-01 zcode 解析器）：不读 env / 时钟 /
+ * 文件系统、不 import RpcError/ws-client——content 与 20MB 预算、200 段窗口、
+ * beforeSeq、超时 deadline、时钟函数全部参数注入，fixture 单测零 mock。错误不抛
+ * 异常，以 status 结构化分层（'unsupported' 判定是 registry 层职责，本模块不产）：
+ *   - too_large：content 超预算（20MB），前置判定不进入逐行解析；
+ *   - parse_error：坏行占比 >50% 或超时（5s）；
+ *   - parsed：其余（messages 可能为空）。
+ *
+ * 防御语义（Cursor 向后兼容增字段）：未知块类型/空白 text 块/缺 name 的
+ * tool_use 块静默忽略（不计坏行）；非 JSON 行、结构不符行（未知 type、未知
+ * role、缺 message、content 非数组、非 object 行）计 skippedLines。
+ *
+ * @module agent-log/parse-cursor-agent-transcript
+ */
+
+import type { NormalizedLogMessage } from './parse-zcode-model-io.js';
+
+// ── 模块常量（默认值，全部可经 options 注入覆盖；口径与 zcode 解析器逐字对齐）──
+
+/** 内容预算上限：20MB。超限直接 too_large，不进入逐行解析。 */
+export const DEFAULT_MAX_CONTENT_BYTES = 20 * 1024 * 1024;
+
+/** 段窗口大小：单次下发最近 200 段。 */
+export const DEFAULT_MAX_SEGMENTS = 200;
+
+/** 解析超时保护：5s。超时 → parse_error 回落。 */
+export const DEFAULT_PARSE_TIMEOUT_MS = 5000;
+
+/** 行级批处理粒度：每 500 行 yield 一次事件循环（防 20MB 内大文件长阻塞）。 */
+const LINES_PER_BATCH = 500;
+
+/** tool_input 摘要截断：JSON.stringify 后首 2KB（沿用 zcode 解析器 §7.1 口径）。 */
+const TOOL_INPUT_MAX_CHARS = 2048;
+
+/** tool_result 摘要截断：首 4KB（同上口径）。 */
+const TOOL_RESULT_MAX_CHARS = 4096;
+
+// ── 类型定义（design §1.1/§1.4，内层键 snake_case 对齐）──────────────────────
+
+/**
+ * cursor-agent 解析器输出段：基型 NormalizedLogMessage + 本变更新增可选标记字段。
+ *
+ * 三个标记字段的类型与 design §1.1 任务卡给定形状逐字一致（task-01 将把同形
+ * 字段落进 parse-zcode-model-io.ts 基类型）——本模块本地 extends 声明，Wave-1
+ * 并行落地不依赖 task-01 先合入；task-01 合入后同形重声明无冲突。
+ */
+export interface CursorAgentTranscriptMessage extends NormalizedLogMessage {
+  /** 所属 CLI 轮次 id；cursor transcript 实证无轮 id，仅 turn_end 标记段显式置 null。 */
+  turn_id?: string | null;
+  /** 系统事件标记：turn_end 标记段置 true，防正文污染（前端不进正文渲染）。 */
+  is_meta?: boolean;
+  /** turn_ended 生命周期事件标记（前端适配层据此切轮）。 */
+  turn_end?: boolean;
+}
+
+/** 段类型别名（基型 kind 联合）。 */
+export type CursorAgentTranscriptMessageKind = CursorAgentTranscriptMessage['kind'];
+
+/** 解析结果 status（'unsupported' 由 registry 层叠加，非本函数职责）。 */
+export type CursorAgentTranscriptParseStatus = 'parsed' | 'parse_error' | 'too_large';
+
+/** 解析选项：全部参数注入（纯函数不读 env/时钟/文件系统）。 */
+export interface CursorAgentTranscriptParseOptions {
+  /** 内容预算上限（字节），默认 20MB。 */
+  maxContentBytes?: number;
+  /** 段窗口大小，默认 200。 */
+  maxSegments?: number;
+  /** 「加载更早」切片键：非 null 时按 seq < beforeSeq 过滤后再套窗口。 */
+  beforeSeq?: number | null;
+  /** 超时保护毫秒数，默认 5s。 */
+  timeoutMs?: number;
+  /** 时钟函数（默认 Date.now），注入以便测试零 mock 地驱动超时。 */
+  now?: () => number;
+}
+
+/**
+ * 解析结果（外层 camelCase 对齐 registry AgentLogMessagesResult；messages 内层
+ * snake_case）。**无 totalUsage 键**——token 不落盘（96/96 实证），恒不产出。
+ */
+export interface CursorAgentTranscriptParseResult {
+  status: CursorAgentTranscriptParseStatus;
+  /** 仅 status=parsed 非空。 */
+  messages: CursorAgentTranscriptMessage[];
+  /** 切片（beforeSeq）后段数超窗口 → true，同时截最近 maxSegments 段。 */
+  truncated: boolean;
+  /** 全量段总数（窗口截断前、beforeSeq 切片前的总数）。 */
+  totalSegments: number;
+  /** 坏行计数（JSON.parse 失败 / 结构不符；空行不计）。 */
+  skippedLines: number;
+}
+
+// ── 内部形状 ─────────────────────────────────────────────────────────────────
+
+/** 通过结构校验的一行：角色行（块数组）或 turn_ended 生命周期事件。 */
+type CursorTranscriptLine =
+  | { kind: 'role'; role: 'user' | 'assistant'; content: unknown[] }
+  | { kind: 'turn_ended' };
+
+/** 未编号段（seq 在全量段遍历完成后统一重编号）。 */
+type UnnumberedSegment = Omit<CursorAgentTranscriptMessage, 'seq'>;
+
+// ── 主函数 ───────────────────────────────────────────────────────────────────
+
+/**
+ * 解析 cursor-agent transcript JSONL 内容为归一化对话消息（纯函数、异步）。
+ *
+ * 处理管线：预算前置判定 → 逐行 parse + 结构校验分类（坏行跳过计数；角色行
+ * 按块映射产段、turn_ended 产标记段；每 500 行 yield + 超时检查）→ 坏行占比
+ * 判定 → seq 重编号 → beforeSeq 切片 → 段窗口截断。
+ */
+export async function parseCursorAgentTranscriptLog(
+  content: string,
+  options: CursorAgentTranscriptParseOptions = {},
+): Promise<CursorAgentTranscriptParseResult> {
+  const maxContentBytes = options.maxContentBytes ?? DEFAULT_MAX_CONTENT_BYTES;
+  // 20MB 预算前置判定：超限直接 too_large，不进入逐行解析。
+  if (Buffer.byteLength(content, 'utf8') > maxContentBytes) {
+    return { status: 'too_large', messages: [], truncated: false, totalSegments: 0, skippedLines: 0 };
+  }
+
+  const maxSegments = options.maxSegments ?? DEFAULT_MAX_SEGMENTS;
+  const beforeSeq = options.beforeSeq ?? null;
+  const now = options.now ?? Date.now;
+  const deadline = now() + (options.timeoutMs ?? DEFAULT_PARSE_TIMEOUT_MS);
+
+  // BOM 容错 + 逐行（trim 兼容 CRLF 尾随 \r）。
+  const normalized = content.startsWith('\uFEFF') ? content.slice(1) : content;
+  const rawLines = normalized.split('\n');
+
+  const segments: UnnumberedSegment[] = [];
+  let skippedLines = 0;
+  let totalLines = 0;
+
+  for (let i = 0; i < rawLines.length; i++) {
+    const raw = rawLines[i];
+    if (raw === undefined) break;
+    const line = raw.trim();
+    // 空白行（文件尾换行 / 中段空行）不计坏行、不计占比分母。
+    if (line === '') continue;
+    totalLines++;
+
+    let parsed: unknown;
