+// frontend/src/lib/__tests__/agent-log-replay.test.ts
+//
+// 2026-09-20-agent-log-session-replay task-07：回放适配层纯函数单测。
+//
+// 依据：
+//   - .sillyspec/changes/2026-09-20-agent-log-session-replay/design.md §3.1
+//     （系统事件归一化 / 轮边界三保险 / 段映射 / token 口径 / 主子日志判定）
+//   - fixture 形状来自 2026-09-19 三 harness 实证调研
+//     （zcode model-io / claude-code JSONL / cursor-agent transcript）
+//
+// 覆盖：
+//   1. isSubagentLog：session_id `subagent_agent_` 前缀 / log_path 含 subagent / 纯主日志
+//   2. selectMainLogs：过滤子代理 + first_seen_at 升序 + 同刻保序 + 不可考最旧 + 不改入参
+//   3. 系统事件两来源分流：zcode 文本前缀 / claude-code is_meta（stderr 首项、无气泡、不进 output）
+//   4. 轮边界三保险：真人 user_input / turn_id 变化 / null turn_id 不触发 / turn_end 标记跳过
+//   5. 段映射：reply 拼接 / thinking / tool 配对（ok/deny）/ 失配前缀 / 孤儿 tool_result
+//   6. token：轮内求和 / ctxTokens 末次 / 无 usage 全 null
+//   7. SessionTurnView 八字段必填契约（runId / turn:null / prompt / output 兜底 / status / seenLogIds）
+
+import { describe, expect, it } from "vitest";
+
+import {
+  buildReplayTurns,
+  isSubagentLog,
+  selectMainLogs,
+  type AgentLogMessageItem,
+} from "../agent-log-replay";
+
+/** fixture 构造：seq / kind 必填，其余按实证形状按需给。 */
+function msg(
+  partial: Partial<AgentLogMessageItem> &
+    Pick<AgentLogMessageItem, "seq" | "kind">,
+): AgentLogMessageItem {
+  return { ...partial };
+}
+
+/** usage fixture（缓存两项实证里常见为 0，不影响求和断言）。 */
+function usage(
+  inputTokens: number,
+  outputTokens: number,
+): NonNullable<AgentLogMessageItem["usage"]> {
+  return {
+    input_tokens: inputTokens,
+    output_tokens: outputTokens,
+    cache_read_tokens: 0,
+    cache_write_tokens: 0,
+  };
+}
+
+/* ───────────────── isSubagentLog ───────────────── */
+
+describe("isSubagentLog：主/子日志判定", () => {
+  it("session_id 为 subagent_agent_ 前缀形态（zcode 子代理）判为子代理", () => {
+    expect(
+      isSubagentLog({
+        session_id: "subagent_agent_8f3a2b01",
+        log_path: "C:\\Users\\qy\\.zcode\\projects\\demo\\sessions\\main.jsonl",
+      }),
+    ).toBe(true);
+  });
+
+  it("log_path 含 subagent 判为子代理（session_id 缺省也能命中）", () => {
+    expect(
+      isSubagentLog({
+        session_id: null,
+        log_path: "/home/u/.claude/projects/p/subagent_agent_x.jsonl",
+      }),
+    ).toBe(true);
+  });
+
+  it("session_id 与 log_path 均不含 subagent 判为主日志", () => {
+    expect(
+      isSubagentLog({
+        session_id: "model-io-sess_4d81e0a6",
+        log_path: "C:\\Users\\qy\\.zcode\\projects\\demo\\sessions\\4d81.jsonl",
+      }),
+    ).toBe(false);
+  });
+});
+
+/* ───────────────── selectMainLogs ───────────────── */
+
+describe("selectMainLogs：主日志过滤与排序", () => {
+  const mainOld = {
+    session_id: "model-io-sess_aaa",
+    log_path: "/logs/zcode-main-a.jsonl",
+    first_seen_at: "2026-09-19T08:00:00Z",
+  };
+  const mainNew = {
+    session_id: "model-io-sess_bbb",
+    log_path: "/logs/zcode-main-b.jsonl",
+    first_seen_at: "2026-09-19T12:30:00Z",
+  };
+  const subagent = {
+    session_id: "subagent_agent_zzz",
+    log_path: "/logs/subagent_agent_zzz.jsonl",
+    first_seen_at: "2026-09-19T10:00:00Z",
+  };
+
+  it("过滤子代理后按 first_seen_at 升序，末位即最新主日志", () => {
+    const out = selectMainLogs([mainNew, subagent, mainOld]);
+    expect(out).toEqual([mainOld, mainNew]);
+  });
+
+  it("同刻保序：first_seen_at 相同保持原相对顺序", () => {
+    const mainSameTs = {
+      session_id: "model-io-sess_ccc",
+      log_path: "/logs/zcode-main-c.jsonl",
+      first_seen_at: "2026-09-19T08:00:00Z",
+    };
+    const out = selectMainLogs([mainSameTs, mainOld]);
+    expect(out[0]).toBe(mainSameTs);
+    expect(out[1]).toBe(mainOld);
+  });
+
+  it("first_seen_at 不可考（null）视为最旧排最前", () => {
+    const noTs = { log_path: "/logs/no-ts.jsonl", first_seen_at: null };
+    const out = selectMainLogs([mainOld, noTs]);
+    expect(out).toEqual([noTs, mainOld]);
+  });
+
+  it("返回新数组，入参顺序不被修改", () => {
+    const input = [mainNew, mainOld];
+    selectMainLogs(input);
+    expect(input[0]).toBe(mainNew);
+  });
+});
+
+/* ───────────────── 系统事件归一化（两来源分流） ───────────────── */
+
+describe("buildReplayTurns：系统事件两来源分流", () => {
+  it("zcode：task-notification 前缀 user_input 开轮 → prompt 空串 + stderr 首项，reply 正常进 output", () => {
+    const turns = buildReplayTurns([
+      msg({
+        seq: 1,
