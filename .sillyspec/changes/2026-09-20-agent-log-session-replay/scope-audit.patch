+/** 浮层行：harness + sess 短码 + 时间窗 + 大小/调用次数，点击切换 selectedEntryId。 */
+function WorkSessionRow({
+  entry,
+  active,
+  onSelect,
+}: {
+  entry: AgentLogListItem;
+  active: boolean;
+  onSelect: () => void;
+}) {
+  const slot = formatTimeSlot(entry.first_seen_at, entry.last_seen_at);
+  const sizeText = formatBytes(entry.size_bytes);
+  return (
+    <li className="flex flex-wrap items-center gap-2">
+      <button
+        type="button"
+        onClick={onSelect}
+        className={cn(
+          "inline-flex cursor-pointer items-center gap-2 rounded px-1 py-0.5 text-left transition-colors",
+          active ? "font-semibold text-brand-700" : "text-foreground hover:bg-muted",
+        )}
+      >
+        <FileText aria-hidden className="h-3 w-3 shrink-0 text-muted-foreground" />
+        <span className="font-mono text-[11px]">
+          {entry.session_id
+            ? `sess ${shortSessionId(entry.session_id)}`
+            : entry.log_path.split(/[\\/]/).pop() || entry.log_path}
+        </span>
+        {slot && <span className="text-[11px] text-muted-foreground">（{slot}）</span>}
+      </button>
+      <span className="text-[11px] text-muted-foreground">
+        {entry.harness} · {sizeText ?? "—"} · 调用 {entry.invocations ?? "—"} 次
+      </span>
+    </li>
+  );
+}
