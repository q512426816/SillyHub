+    expect(ofKind(result.messages, 'tool_result')[0]).toMatchObject({
+      kind: 'tool_result',
+      text: null,
+      tool_name: null, // claude-code tool_result 块不带工具名（区别于 zcode 消息级键集）
+      tool_use_id: 'toolu_01',
+      tool_result: '设计文档第一行',
+      is_error: false,
+    });
+  });
+
+  it('tool_result 载体 user 行不产 user_input（验收项：不冒充用户气泡）', async () => {
+    const result = await parseClaudeCodeJsonlLog(content);
+    expect(ofKind(result.messages, 'user_input').map((m) => m.text)).toEqual([
