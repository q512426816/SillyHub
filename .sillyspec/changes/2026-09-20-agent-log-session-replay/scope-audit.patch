+//      user 行 tool_result 块 call_id / tool_use_id 兜底、is_error、对象 content
+//   C3 turn_ended → turn_end:true 标记段（kind=reply、text 空串、is_meta:true、
+//      turn_id:null；status/error 元数据零泄漏；普通段无标记键）
+//   C4 usage/totalUsage 恒不产出（键不存在，undefined）
+//   C5 坏行容错（≤50% 跳过计数不中断；>50% → parse_error；空行不计坏行；
+//      缺名 tool_use 块静默忽略）
+//   C6 未知块类型防御式忽略（reasoning/image/非对象条目/role 越界块）
+//   C7 20MB 预算（超限 too_large；恰好等于上限可解析）
+//   C8 200 段窗口 + beforeSeq 切片 + truncated/totalSegments + maxSegments 注入
+//   C9 5s 超时保护 → parse_error（now 注入，非时钟 mock）
+//   C10 tool_input 2KB / tool_result 4KB 截断；ts 恒 null（实证无时间戳字段）
+
+import { describe, it, expect } from 'vitest';
+import {
+  parseCursorAgentTranscriptLog,
+  DEFAULT_MAX_SEGMENTS,
+  type CursorAgentTranscriptMessage,
+} from '../../src/agent-log/parse-cursor-agent-transcript.js';
+
+// ── fixture 构造（真实形状）───────────────────────────────────────────────────
+
+/** user 角色行（真实形状：顶层恒 {message, role} 二键，text 块承载真人输入）。 */
+const userTextLine = (text: string): string =>
+  JSON.stringify({ role: 'user', message: { content: [{ type: 'text', text }] } });
+
+/** assistant 角色行（块数组：text / tool_use 等）。 */
+const asstLine = (...blocks: Array<Record<string, unknown>>): string =>
+  JSON.stringify({ role: 'assistant', message: { content: blocks } });
+
+/** user 角色行（块数组：tool_result 载体等）。 */
+const userBlocksLine = (...blocks: Array<Record<string, unknown>>): string =>
+  JSON.stringify({ role: 'user', message: { content: blocks } });
+
+/** turn_ended 生命周期事件行（真实样例：success / error+"User aborted request"）。 */
+const turnEndedLine = (status: 'success' | 'error', error?: string): string =>
+  JSON.stringify(
+    error === undefined ? { type: 'turn_ended', status } : { type: 'turn_ended', status, error },
+  );
+
+/** 真实 user text（cursor CLI 的 timestamp/user_query 包装原文，解析层不剥）。 */
+const REAL_USER_QUERY =
+  '<timestamp>Sunday, September 20, 2026, 10:15 AM (UTC+8)</timestamp>\n<user_query>\n实现 task-03 cursor-agent-transcript 解析器\n</user_query>';
+
+/** 多行拼成 JSONL 文本（尾随换行，真实文件形状）。 */
+function jsonl(...lines: string[]): string {
+  return `${lines.join('\n')}\n`;
+}
+
+/** 提取某 kind 的段（便于断言）。 */
+function ofKind(
+  messages: CursorAgentTranscriptMessage[],
+  kind: CursorAgentTranscriptMessage['kind'],
+): CursorAgentTranscriptMessage[] {
+  return messages.filter((m) => m.kind === kind);
+}
+
+// ── C1：真实形状角色行段产出 ──────────────────────────────────────────────────
+
+describe('parseCursorAgentTranscriptLog — 真实形状角色行段产出（C1）', () => {
+  const content = jsonl(
+    userTextLine(REAL_USER_QUERY),
+    asstLine(
+      { type: 'text', text: '我先看任务卡与参考实现' },
+      // 实证 tool_use 块：{type,name,input}，无 id/call_id 字段。
