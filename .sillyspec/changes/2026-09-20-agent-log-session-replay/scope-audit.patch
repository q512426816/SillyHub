+function shortSessionId(id: string): string {
+  const isUuid =
+    /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);
+  if (isUuid) return `${id.slice(0, 8)}…${id.slice(-4)}`;
+  return id.length > 16 ? `${id.slice(0, 16)}…` : id;
