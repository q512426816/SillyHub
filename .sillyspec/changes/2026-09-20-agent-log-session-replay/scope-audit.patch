+
+// ── C5：坏行容错 ──────────────────────────────────────────────────────────────
+
+describe('parseCursorAgentTranscriptLog — 坏行容错（C5）', () => {
+  /** 8 种结构不符变体（JSON.parse 失败 / 未知 type / 未知 role / 缺 message / content 非数组 / 缺 role / 非 object 行）。 */
+  const BAD_LINES: string[] = [
