+        const raw = await readAgentLogContent(entryId);
+        if (stale()) return;
+        setRawData(raw);
+        setLoadingMessages(false);
+      } catch (rawErr: unknown) {
+        if (stale()) return;
+        setLoadingMessages(false);
+        if (isOfflineError(rawErr)) {
+          // 机器离线 / 条目不可达：黄条让位离线提示条 + 元数据行。
+          setOfflineMode(true);
+          return;
+        }
+        setRawError(
+          rawErr instanceof ApiError ? rawErr.message : "读取日志内容失败",
