+    setRawError(null);
+    setOfflineMode(false);
+    setLoadingEarlier(false);
+    setLoadEarlierNote(null);
+    const stale = () => epochRef.current !== epoch;
+    if (!activeEntryId) {
+      setLoadingMessages(false);
