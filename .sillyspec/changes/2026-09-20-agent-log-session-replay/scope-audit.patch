index 000000000..236a35ca1
--- /dev/null
+++ b/sillyhub-daemon/src/agent-log/parse-claude-code-jsonl.ts
@@ -0,0 +1,456 @@
+/**
+ * `agent-log/parse-claude-code-jsonl.ts` —— claude-code 会话 JSONL 解析器（纯函数）。
+ *
+ * task-02（2026-09-20-agent-log-session-replay / FR-02 + FR-03 + D-001@v1）：把
+ * claude-code CLI 落盘的 `~/.claude/projects/<project>/<session>.jsonl` 逐行解析为
+ * 对话流消息（ClaudeCodeLogMessage[]，KB 级），供 host_fs.read_agent_log_messages
+ * RPC 与前端对话化渲染消费，替代 format=claude-code-jsonl 时的原文回落口径。
+ *
+ * 格式事实（design §1.3，生产库存量 4 条 claude-code 日志逐行实证）：
+ *   - 每行一个 JSON 对象，顶层 type 分流：user / assistant 产出段；
+ *     queue-operation / attachment / last-prompt / mode / system 是生命周期行，
+ *     静默跳过不计坏行（attachment 口径，design §1.3）；带 type 字符串的未知行型
+ *     （如 summary、未来版本新增）同口径静默跳过——向后兼容不误判坏行；
+ *   - user 行 message.content 两种形状：纯字符串（真人输入 / isMeta 注入文本）或
+ *     块数组——tool_result 载体行只产 tool_result 段不产 user_input（块级
+ *     tool_use_id 与 assistant tool_use 块配对）；行级 isMeta=true 的文本照常产出
+ *     但置 is_meta:true + kind=reply（系统事件由前端适配层处理，解析层不改判），
+ *     isMeta 非 true 的文本产 user_input 段（真人切轮依据，design §1.3）；
+ *   - assistant 行 message.content 恒为块数组（text / thinking / tool_use），工具
+ *     调用是 content 块（区别于 zcode 的消息级 toolCalls）；
+ *   - usage 在 assistant 行 message.usage（真实样例
+ *     {"input_tokens":2059,"cache_creation_input_tokens":0,
+ *     "cache_read_input_tokens":302720,"output_tokens":838}），Anthropic 口径
+ *     input_tokens 不含缓存——归一为全量口径（Grill v3 终笔）：
+ *     input_tokens = 原始 input_tokens + cache_read_input_tokens +
+ *     cache_creation_input_tokens；cache_read_tokens = cache_read_input_tokens；
+ *     cache_write_tokens = cache_creation_input_tokens；output_tokens 原样。
+ *     这样前端 ctx/徽标跨 harness 同一口径（zcode inputTokens 原生已含缓存）。
+ *
+ * 纯函数约束（预算/窗口/beforeSeq/skippedLines/超时语义与 parse-zcode-model-io.ts
+ * 逐字对齐，task-02 constraints）：不读 env / 时钟 / 文件系统——content 字符串与
+ * 20MB 预算、200 段窗口、beforeSeq、超时 deadline、时钟函数全部参数注入（默认值
+ * 模块常量），fixture 单测零 mock。错误不抛异常，以 status 结构化分层：
+ *   - too_large：content 超预算（R-02），前置判定不进入逐行解析；
+ *   - parse_error：坏行占比 >50%（R-01）或超时（R-02）；
+ *   - parsed：其余（messages 可能为空）。
+ *
+ * 非目标：'unsupported' 判定是注册表（registry.ts）的职责（本解析器由 task-05
+ * 注册进 PARSERS，此处不改 registry.ts）；not_found/forbidden 走 host-fs-handler
+ * 的 RpcError 通道，本模块不 import RpcError/ws-client/fs（错误只走 status 分层）。
+ *
+ * @module agent-log/parse-claude-code-jsonl
+ */
+
+import type {
+  AgentLogUsage,
+  NormalizedLogMessage,
+  NormalizedLogMessageKind,
+} from './parse-zcode-model-io.js';
+import type { AgentLogMessagesResult, AgentLogParser } from './registry.js';
+
+// ── 模块常量（默认值，全部可经 options 注入覆盖；取值与 zcode 解析器逐字对齐）──
+
+/** 内容预算上限：20MB（R-02）。超限直接 too_large，不进入逐行解析。 */
+export const DEFAULT_MAX_CONTENT_BYTES = 20 * 1024 * 1024;
+
+/** 段窗口大小：单次下发最近 200 段（FR-05）。 */
+export const DEFAULT_MAX_SEGMENTS = 200;
+
+/** 解析超时保护：5s（R-02）。超时 → parse_error 回落。 */
+export const DEFAULT_PARSE_TIMEOUT_MS = 5000;
+
+/** 行级批处理粒度：每 500 行 yield 一次事件循环（防 20MB 内大文件长阻塞）。 */
+const LINES_PER_BATCH = 500;
+
+/** tool_input 摘要截断：JSON.stringify 后首 2KB（design §7.1）。 */
+const TOOL_INPUT_MAX_CHARS = 2048;
+
+/** tool_result 摘要截断：首 4KB（design §7.1）。 */
+const TOOL_RESULT_MAX_CHARS = 4096;
+
+// ── 类型定义（内层键 snake_case 直通四层，design §1.1 / §1.3）────────────────
+
+/**
+ * claude-code 段：task-01 扩展后的 NormalizedLogMessage 已含本解析器消费的两个
+ * 可选字段——usage（挂产出该段的 assistant 行 message.usage 全量口径归一值；无
+ * usage 行 = null，user_input/tool_result 段恒 null）与 is_meta（isMeta=true 的
+ * user 行文本段标记，仅 true 时置位）。别名保留解析器命名契约；AgentLogUsage
+ * 同源 import 自 parse-zcode-model-io（task-01 provides），不本地重复定义防漂移。
+ */
+export type ClaudeCodeLogMessage = NormalizedLogMessage;
+
+/** 解析结果 status（'unsupported' 由 registry 层叠加，非本函数职责）。 */
+export type ClaudeCodeJsonlParseStatus = 'parsed' | 'parse_error' | 'too_large';
+
+/** 解析选项：全部参数注入（纯函数不读 env/时钟/文件系统）。 */
+export interface ClaudeCodeJsonlParseOptions {
+  /** 内容预算上限（字节），默认 20MB。 */
+  maxContentBytes?: number;
+  /** 段窗口大小，默认 200（FR-05）。 */
+  maxSegments?: number;
+  /** 「加载更早」切片键：非 null 时按 seq < beforeSeq 过滤后再套窗口。 */
+  beforeSeq?: number | null;
+  /** 超时保护毫秒数，默认 5s（R-02）。 */
+  timeoutMs?: number;
+  /** 时钟函数（默认 Date.now），注入以便测试零 mock 地驱动超时。 */
+  now?: () => number;
+}
+
+/**
+ * 解析结果：AgentLogMessagesResult（registry 契约）上收窄 status/messages 并增
+ * totalUsage（全文件 usage 求和，窗口截断前算；外层键 camelCase 沿用 daemon RPC
+ * 外层惯例，内层键同上 snake_case，design §1.1）。
+ */
+export interface ClaudeCodeJsonlParseResult extends AgentLogMessagesResult {
+  status: ClaudeCodeJsonlParseStatus;
+  messages: ClaudeCodeLogMessage[];
+  /** 全文件归一用量求和（窗口前）；全文件无 usage 行时为 null。 */
+  totalUsage: AgentLogUsage | null;
+}
+
+// ── 内部形状 ─────────────────────────────────────────────────────────────────
+
+/** 未编号段（seq 在全部行遍历完成后统一重编号；claude-code 行序即时间序，无合并）。 */
+type UnnumberedSegment = Omit<ClaudeCodeLogMessage, 'seq'>;
+
+// ── 主函数 ───────────────────────────────────────────────────────────────────
+
+/**
+ * 解析 claude-code 会话 JSONL 内容为归一化对话消息（纯函数、异步）。
+ *
+ * 处理管线：预算前置判定 → 逐行 parse + type 分流（产出型产段、生命周期型静默
+ * 跳过、坏行跳过计数；每 500 行 yield + 超时检查）→ 坏行占比判定 → seq 重编号
+ * → beforeSeq 切片 → 段窗口截断。与 zcode 解析器差异仅在行内映射：claude-code
+ * 是 append-only 会话日志（无窗口合并、无末行补产），每行独立产段。
+ */
+export async function parseClaudeCodeJsonlLog(
+  content: string,
+  options: ClaudeCodeJsonlParseOptions = {},
+): Promise<ClaudeCodeJsonlParseResult> {
+  const maxContentBytes = options.maxContentBytes ?? DEFAULT_MAX_CONTENT_BYTES;
+  // 20MB 预算前置判定（R-02）：超限直接 too_large，不进入逐行解析。
+  if (Buffer.byteLength(content, 'utf8') > maxContentBytes) {
+    return {
+      status: 'too_large',
+      messages: [],
+      truncated: false,
+      totalSegments: 0,
+      skippedLines: 0,
+      totalUsage: null,
+    };
+  }
+
+  const maxSegments = options.maxSegments ?? DEFAULT_MAX_SEGMENTS;
+  const beforeSeq = options.beforeSeq ?? null;
+  const now = options.now ?? Date.now;
+  const deadline = now() + (options.timeoutMs ?? DEFAULT_PARSE_TIMEOUT_MS);
+
+  // BOM 容错 + 逐行（trim 兼容 CRLF 尾随 \r）。
+  const normalized = content.startsWith('\uFEFF') ? content.slice(1) : content;
+  const rawLines = normalized.split('\n');
+
+  const segments: UnnumberedSegment[] = [];
+  const totals: AgentLogUsage = {
+    input_tokens: 0,
+    output_tokens: 0,
+    cache_read_tokens: 0,
+    cache_write_tokens: 0,
+  };
+  let usageLines = 0;
+  let skippedLines = 0;
+  let totalLines = 0;
+
+  for (let i = 0; i < rawLines.length; i++) {
+    const raw = rawLines[i];
+    if (raw === undefined) break;
+    const line = raw.trim();
+    // 空白行（文件尾换行 / 中段空行）不计坏行、不计占比分母。
+    if (line === '') continue;
+    totalLines++;
+
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(line);
+    } catch {
+      skippedLines++;
+      continue;
+    }
+    if (!isRecord(parsed)) {
+      skippedLines++; // 非 object 行（数组/标量 JSON）——结构坏行
+      continue;
+    }
+
+    const type = typeof parsed.type === 'string' ? parsed.type : null;
+    if (type === 'user' || type === 'assistant') {
+      const message = parsed.message;
+      if (!isRecord(message)) {
+        // 产出型行缺 message 对象——结构坏行（对齐 zcode 行级校验计数口径）。
+        skippedLines++;
+        continue;
+      }
+      const ts = typeof parsed.timestamp === 'string' ? parsed.timestamp : null;
+      if (type === 'assistant') {
+        // usage 归一 + 全文件求和（窗口前）：只累计 assistant 行（user 行无 usage）。
+        const usage = normalizeUsage(message.usage);
+        if (usage !== null) {
+          usageLines++;
+          totals.input_tokens += usage.input_tokens;
+          totals.output_tokens += usage.output_tokens;
+          totals.cache_read_tokens += usage.cache_read_tokens;
+          totals.cache_write_tokens += usage.cache_write_tokens;
+        }
+        segments.push(...assistantLineSegments(message, ts, usage));
+      } else {
+        segments.push(...userLineSegments(message, ts, parsed.isMeta === true));
+      }
+    } else if (type !== null) {
+      // 生命周期行（queue-operation/attachment/last-prompt/mode/system）与未知
+      // type 字符串（summary 等）——静默跳过不计坏行（design §1.3 attachment
+      // 口径：忽略行不进坏行计数，向后兼容未来行型）。
+    } else {
+      skippedLines++; // 无 type 字段——不符合 claude-code 行契约，结构坏行
+    }
+
+    // 行级批处理：每 500 行 yield + 超时检查（R-02，防 20MB 内大文件阻塞事件循环）。
+    if (totalLines % LINES_PER_BATCH === 0) {
+      await yieldToEventLoop();
+      if (now() > deadline) {
+        return {
+          status: 'parse_error',
+          messages: [],
+          truncated: false,
+          totalSegments: 0,
+          skippedLines,
+          totalUsage: null,
+        };
+      }
+    }
+  }
+
+  // 坏行占比 >50% → parse_error 回落（R-01）；分母是全部非空行（含静默跳过的
+  // 生命周期行，对齐 zcode「全部非空行」口径）——真实文件生命周期行占比高但
+  // 不计坏行，比值仍只反映坏行浓度。恰好 50% 属可用（跳过坏行不中断）。
+  if (totalLines > 0 && skippedLines / totalLines > 0.5) {
+    return {
+      status: 'parse_error',
+      messages: [],
+      truncated: false,
+      totalSegments: 0,
+      skippedLines,
+      totalUsage: null,
+    };
+  }
+
+  // seq 重编号（1 起全局序；行序即时间序，产段顺序天然有序无需合并）。
+  const numbered: ClaudeCodeLogMessage[] = segments.map((segment, index) => ({
+    seq: index + 1,
+    ...segment,
+  }));
+
+  // beforeSeq 切片（R-07 无状态重解析口径）→ 段窗口（最近 maxSegments 段，FR-05）。
+  const sliced = beforeSeq !== null ? numbered.filter((m) => m.seq < beforeSeq) : numbered;
+  const truncated = sliced.length > maxSegments;
+  const messages = truncated ? sliced.slice(sliced.length - maxSegments) : sliced;
+
+  return {
+    status: 'parsed',
+    messages,
+    truncated,
+    totalSegments: numbered.length,
+    skippedLines,
+    totalUsage: usageLines > 0 ? { ...totals } : null,
+  };
+}
+
+// ── 行内段产出（真实消息块形状，design §1.3）────────────────────────────────
+
+/**
+ * assistant 行 → thinking / reply / tool_use 段（content 块序即段序），全部段挂
+ * 该行归一后的 usage（usage 缺失行挂 null）。
+ */
+function assistantLineSegments(
+  message: Record<string, unknown>,
+  ts: string | null,
+  usage: AgentLogUsage | null,
+): UnnumberedSegment[] {
+  const segments: UnnumberedSegment[] = [];
+  const content = message.content;
+  // 形状漂移防御（真实 assistant content 恒为块数组）：非空字符串按 reply 兜底。
+  if (typeof content === 'string') {
+    if (content.trim() !== '') {
+      segments.push(makeSegment('reply', ts, usage, { text: content }));
+    }
+    return segments;
+  }
+  if (!Array.isArray(content)) return segments;
+
+  for (const block of content) {
+    if (!isRecord(block)) continue;
+    if (block.type === 'text' && typeof block.text === 'string' && block.text.trim() !== '') {
+      segments.push(makeSegment('reply', ts, usage, { text: block.text }));
+    } else if (
+      block.type === 'thinking' &&
+      typeof block.thinking === 'string' &&
+      block.thinking.trim() !== ''
+    ) {
+      // claude-code thinking 块正文在 thinking 键（thinking/text 键名差异是与
+      // zcode reasoning 块的实测区别之一）。
+      segments.push(makeSegment('thinking', ts, usage, { text: block.thinking }));
+    } else if (block.type === 'tool_use' && typeof block.name === 'string') {
+      // 工具调用是 content 块（区别于 zcode 消息级 toolCalls）；toolUseId=块 id。
+      segments.push(
+        makeSegment('tool_use', ts, usage, {
+          tool_name: block.name,
+          tool_use_id: typeof block.id === 'string' ? block.id : null,
+          tool_input: summarizeToolInput(block.input),
+        }),
+      );
+    }
+    // 未知块类型（redacted_thinking/image 等）防御式跳过（R-01）。
+  }
+  return segments;
+}
+
+/**
+ * user 行 → tool_result / user_input / reply 段：
+ *   - tool_result 块 → tool_result 段（块级 tool_use_id 配对，isMeta 不影响）；
+ *   - text（含纯字符串 content）+ 行级 isMeta 非 true → user_input 段（真人文本，
+ *     保原文不 trim/不剥离——claude-code 无 zcode 的 system-reminder 剥离需求）；
+ *   - text + isMeta=true → 照常产出但 kind=reply 且置 is_meta:true（系统事件由
+ *     前端适配层处理，解析层不改判）。
+ */
+function userLineSegments(
+  message: Record<string, unknown>,
+  ts: string | null,
+  isMeta: boolean,
+): UnnumberedSegment[] {
+  const segments: UnnumberedSegment[] = [];
+  const content = message.content;
+  if (typeof content === 'string') {
+    if (content.trim() !== '') {
+      segments.push(makeSegment(isMeta ? 'reply' : 'user_input', ts, null, { text: content }, isMeta));
+    }
+    return segments;
+  }
+  if (!Array.isArray(content)) return segments;
+
+  for (const block of content) {
+    if (!isRecord(block)) continue;
+    if (block.type === 'tool_result') {
+      // tool_result 载体行：块级 tool_use_id 与 assistant tool_use 块配对；content
+      // 可为纯字符串或 text 块数组（后者按序拼接全部 text 字段）。
+      segments.push(
+        makeSegment('tool_result', ts, null, {
+          tool_use_id: typeof block.tool_use_id === 'string' ? block.tool_use_id : null,
+          tool_result: toolResultText(block.content),
+          is_error: typeof block.is_error === 'boolean' ? block.is_error : null,
+        }),
+      );
+    } else if (block.type === 'text' && typeof block.text === 'string' && block.text.trim() !== '') {
+      segments.push(makeSegment(isMeta ? 'reply' : 'user_input', ts, null, { text: block.text }, isMeta));
+    }
+    // image 等其它块类型防御式跳过（R-01）。
+  }
+  return segments;
+}
+
+// ── usage 归一（全量口径，Grill v3 终笔）────────────────────────────────────
+
+/**
+ * assistant 行 message.usage 归一为全量口径：input_tokens 并入缓存读+写
+ * （Anthropic 口径 input 不含缓存 / zcode 原生已含，归一后跨 harness 同一口径）。
+ * 非 object（缺失/漂移）→ null（该行段 usage 挂 null 且不计入 totalUsage）。
+ */
+function normalizeUsage(usage: unknown): AgentLogUsage | null {
+  if (!isRecord(usage)) return null;
+  const input = tokenCount(usage.input_tokens);
+  const cacheRead = tokenCount(usage.cache_read_input_tokens);
+  const cacheWrite = tokenCount(usage.cache_creation_input_tokens);
+  return {
+    input_tokens: input + cacheRead + cacheWrite,
+    output_tokens: tokenCount(usage.output_tokens),
+    cache_read_tokens: cacheRead,
+    cache_write_tokens: cacheWrite,
+  };
+}
+
+/** token 数防御式收窄：非非负有限数值（缺失/漂移）按 0 计，不产 NaN 污染求和。 */
+function tokenCount(value: unknown): number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : 0;
+}
+
+// ── 工具函数 ─────────────────────────────────────────────────────────────────
+
+/** 构造未编号段：未显式给出的字段一律 null（九字段齐全，snake_case）；isMeta
+ *  文本段额外置 is_meta:true（仅 true 时携带，缺省由消费方按非 meta 处理）。 */
+function makeSegment(
+  kind: NormalizedLogMessageKind,
+  ts: string | null,
+  usage: AgentLogUsage | null,
+  fields: Partial<
+    Pick<NormalizedLogMessage, 'text' | 'tool_name' | 'tool_use_id' | 'tool_input' | 'tool_result' | 'is_error'>
+  > = {},
+  isMeta = false,
+): UnnumberedSegment {
+  return {
+    kind,
+    text: fields.text ?? null,
+    tool_name: fields.tool_name ?? null,
+    tool_use_id: fields.tool_use_id ?? null,
+    tool_input: fields.tool_input ?? null,
+    tool_result: fields.tool_result ?? null,
+    is_error: fields.is_error ?? null,
+    ts,
+    usage,
+    ...(isMeta ? { is_meta: true } : {}),
+  };
+}
+
+/** tool input 摘要：JSON.stringify 后首 2KB 截断（design §7.1，与 zcode 同口径）。 */
+function summarizeToolInput(input: unknown): string {
+  try {
+    return (JSON.stringify(input) ?? '').slice(0, TOOL_INPUT_MAX_CHARS);
+  } catch {
+    // 循环引用等异常形状兜底（JSONL 来源理论上不会出现，防御式不抛）。
+    return String(input).slice(0, TOOL_INPUT_MAX_CHARS);
+  }
+}
+
+/**
+ * tool result 摘要：字符串 content 首 4KB 截断；claude-code 特有形状——content
+ * 为 text 块数组时按序拼接全部 text 字段后截断；其它形状（漂移）JSON 序列化兜底。
+ */
+function toolResultText(content: unknown): string {
+  if (typeof content === 'string') return content.slice(0, TOOL_RESULT_MAX_CHARS);
+  if (Array.isArray(content)) {
+    const joined = content
+      .map((block) => (isRecord(block) && typeof block.text === 'string' ? block.text : ''))
+      .join('');
+    return joined.slice(0, TOOL_RESULT_MAX_CHARS);
+  }
+  if (content === null || content === undefined) return '';
+  try {
+    return (JSON.stringify(content) ?? '').slice(0, TOOL_RESULT_MAX_CHARS);
+  } catch {
+    return String(content).slice(0, TOOL_RESULT_MAX_CHARS);
+  }
+}
+
+/** unknown 收窄为 Record（JSON 行/消息/块校验基础）。 */
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/** 让出事件循环一个宏任务周期（行级批处理用）。 */
+function yieldToEventLoop(): Promise<void> {
+  return new Promise((resolve) => setImmediate(resolve));
+}
+
+// ── 类型级守卫（零运行时行为）────────────────────────────────────────────────
+
+// 编译期锁定：parseClaudeCodeJsonlLog 签名可直接注册为 AgentLogParser（task-05
+// PARSERS 消费，registry.ts:63 契约）——options 全可选属性是其超集，返回值是
+// AgentLogMessagesResult 的结构扩展（多 totalUsage / messages 字段更具体）。
+const _agentLogParserGuard: AgentLogParser = parseClaudeCodeJsonlLog;
+void _agentLogParserGuard;
