+    expect(result.messages.every((m) => m.ts === null)).toBe(true);
+  });
+});
+
+// ── C2：call_id 配对（任务卡契约形状）─────────────────────────────────────────
+
+describe('parseCursorAgentTranscriptLog — call_id 配对（C2）', () => {
+  const content = jsonl(
+    // call_id 配对键 + args 键（任务卡口径；解析器 input 优先、args 兜底）。
