+});
+
+// ── C2：usage 全量口径归一与 totalUsage 求和 ─────────────────────────────────
+
+describe('parseClaudeCodeJsonlLog — usage 全量口径归一与 totalUsage（C2 / Grill v3 终笔）', () => {
+  it('真实样例归一（2059+302720+0=304779），挂该行全部产出段（thinking/reply/tool_use）', async () => {
