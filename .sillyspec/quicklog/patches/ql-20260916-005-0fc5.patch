+    config_snapshot: null,
+  };
+}
+
+function makeHistory() {
+  return HISTORY_RUNS.flatMap((runId, i) => [
+    {
+      id: `log-${runId}-u`,
+      run_id: runId,
+      timestamp: `2026-09-16T10:00:0${i}.000Z`,
+      channel: "user_input",
+      content_redacted: `问题${i}`,
+    },
+    {
+      id: `log-${runId}-o`,
