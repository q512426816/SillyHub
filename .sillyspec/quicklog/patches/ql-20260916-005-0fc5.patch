+      timestamp: `2026-09-16T10:00:0${i}.500Z`,
+      channel: "stdout",
+      content_redacted: `回答${i}`,
+    },
+  ]);
+}
+
+/** 模拟 dispatchRunSynth 产出的合成 turn_completed envelope。 */
+function makeCompletedEnv(runId: string, status: string) {
+  return {
+    event: "turn_completed" as const,
+    session_id: "sess-A",
+    run_id: runId,
