diff --git a/backend/.pre-commit-config.yaml b/backend/.pre-commit-config.yaml
index fea4ce626..9c277f679 100644
--- a/backend/.pre-commit-config.yaml
+++ b/backend/.pre-commit-config.yaml
@@ -9,16 +9,21 @@ repos:
 # 改动时会触发 pre-commit stash↔auto-fix 冲突回滚（提交失败 + AM 态重试循环）；
 # 改 check-only 后 hook 不再修改文件，冲突类从根上消失。格式化改为提交前手动：
 #   uv run ruff format && uv run ruff check --fix（或修完再 add）
+# 2026-09-23 ql（change-events-channel 执行会话反馈④）：hook 失败时直接打印对齐修复命令——
+# 实证 hook 与项目同为 uv 环境解析（根/backend 两处 `uv run ruff --version` 均 0.15.14，
+# uv.lock 同版本），被拦时先跑修复命令再 add，不要怀疑版本漂移而绕 hook。
       - id: ruff-format
         name: ruff format --check
-        entry: uv run ruff format --check
+        entry: >-
+          bash -c 'uv run ruff format --check "$@" || { echo "  ↩ 修复命令（与 hook 同源 uv 环境，勿用全局 ruff）：cd backend && uv run ruff format <被拦文件>"; exit 1; }' --
         language: system
         types: [python]
         pass_filenames: true
 
       - id: ruff-check
         name: ruff check
-        entry: uv run ruff check
+        entry: >-
+          bash -c 'uv run ruff check "$@" || { echo "  ↩ 修复命令（与 hook 同源 uv 环境，勿用全局 ruff）：cd backend && uv run ruff check --fix <被拦文件>"; exit 1; }' --
         language: system
         types: [python]
         pass_filenames: true
