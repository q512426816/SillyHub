# author: qinyi
# created_at: 2026-07-14
# 强制 PowerShell 安装脚本使用 CRLF 行尾，防止 git autocrlf 在 Windows 上将其转成 LF
# （PowerShell 对 LF-only .ps1 在某些执行策略/解析场景下会出错）
sillyhub-daemon/scripts/install.ps1 text eol=crlf

# 强制所有 shell 脚本 LF 行尾——部署脚本（deploy/scripts/build-and-save.sh /
# load-and-up.sh）要在 Linux 服务器执行，core.autocrlf=true 会在 Windows checkout
# 时把 LF 转 CRLF，致服务器 bash\r 解析失败（bad interpreter）。
*.sh text eol=lf
# 生成物行尾钉 LF：pre-push ci-fast-gate 的 gen:types:check 重生成这些文件，
# CRLF 工作副本会被重写为 LF 字节变化 → pre-commit 判「files were modified by this hook」拦推送。
# eol=lf 使工作副本恒 LF，重生成零字节差（2026-10-26 实证 push 三连拦根因）。
backend/openapi.json eol=lf
frontend/src/lib/api-types.ts eol=lf
sillyhub-daemon/src/api-types.ts eol=lf
